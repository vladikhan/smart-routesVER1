<%= link_to route_path(route), class: "route-card" do %>
  <div class="route-card-image">
    <% if route.city.present? %>
      <span class="city-badge"><%= route.city.name %></span>
    <% end %>
    <div class="placeholder-icon">🗺️</div>
  </div>
  <div class="route-card-content">
    <h3 class="route-card-title"><%= route.name %></h3>
    <p class="route-card-desc"><%= truncate(route.description, length: 60) %></p>
    <div class="route-card-meta">
      <span>💰 ¥<%= number_with_delimiter(route.estimated_cost) %></span>
      <span>⏱️ <%= route.estimated_duration %>分</span>
    </div>
    <div class="route-card-stats">
      <span>❤️ <%= route.likes_count || 0 %></span>
      <span>🔖 <%= route.bookmarks_count || 0 %></span>
    </div>
  </div>
<% end %>