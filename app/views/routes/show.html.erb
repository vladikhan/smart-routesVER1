    <% target_path = item_data[:venue_id] ? venue_path(item_data[:venue_id]) : "#" %>

    <%= link_to target_path, class: "venue-list-item" do %>
      <div class="venue-number"><%= index + 1 %></div>

      <div class="venue-info">
        <%# В Ruby мы просто пишем [key], чтобы достать значение из хэша %>
        <h4><%= item_data[:name] %></h4>

        <% if item_data[:description].present? %>
          <p><%= truncate(item_data[:description], length: 100) %></p>
        <% end %>

        <div class="venue-tags-inline">
          <% if item_data[:cuisine_type].present? %>
            <span class="tag-inline">
              <i class="fas fa-utensils"></i>
              <%= item_data[:cuisine_type] %>
            </span>
          <% end %>

          <% if item_data[:price_range].present? %>
            <span class="tag-inline">
              <i class="fas fa-yen-sign"></i>
              <%= item_data[:price_range] %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
        <% else %>
          <div class="empty-state">
            <i class="fas fa-map-marked-alt"></i>
            <p>このルートにはまだ場所が追加されていません。</p>
          </div>
        <% end %>
      </div>

      <!-- Map Section -->
      <div class="content-card">
        <h2 class="section-title">
