<% content_for :title, "#{@route.name} - Smart Routes" %>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "dmRooms", "data-turbo-track": "reload" %>

<%= render 'pages/header' %>




<!-- Hero Section -->
<section class="route-hero">
  <div class="route-hero-content">
    <!-- Meta Header -->
    <div class="route-meta-header">
      <div class="user-info">
        <div class="user-avatar">
          <% if @route.user.avatar.present? %>
            <%= image_tag @route.user.avatar.thumb.url, alt: @route.user.username %>
          <% else %>
            <%= @route.user.username[0].upcase %>
          <% end %>
        </div>
        <div class="user-name-date">
          <strong>@<%= @route.user.username %></strong>
          <small><%= @route.created_at.strftime('%Y年%m月%d日') %>に作成</small>
        </div>
      </div>

      <div class="route-stats">

        <div class="stat-item">
          <i class="fas fa-heart"></i>
          <span>❤️ <%= @route.likes_count || 0 %></span>
        </div>
      </div>
    </div>

    <!-- Title Section -->
    <div class="route-title-section">
      <h1><%= @route.name %></h1>
      <% if @route.description.present? %>
        <p><%= @route.description %></p>
      <% end %>

      <div class="route-quick-info">
        <div class="quick-info-item">
          <i class="fas fa-map-marker-alt"></i>
          <span><%= @route_items&.count || 0 %>場所</span>
        </div>
        <% if @route.estimated_duration.present? %>
          <div class="quick-info-item">
            <i class="fas fa-clock"></i>
            <span><%= @route.estimated_duration %>分</span>
          </div>
        <% end %>
        <% if @route.difficulty_level.present? %>
          <div class="quick-info-item">
            <i class="fas fa-signal"></i>
            <span><%= @route.difficulty_level %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="route-actions">
      <% if user_signed_in? %>
        <!-- Like Button -->
       <% if current_user.liked?(@route) %>
  <% like = current_user.likes.find_by(likeable: @route) %>


  <%= button_to "/routes/#{@route.id}/likes/#{like.id}", method: :delete,
                class: "action-btn btn-like active" do %>
    <i class="fas fa-heart"></i>
    <span>❤️ いいね</span>
  <% end %>
<% else %>
  <%= button_to route_likes_path(@route),
                params: { likeable_type: 'Route', likeable_id: @route.id },
                method: :post,
                class: "action-btn btn-like" do %>
    <i class="far fa-heart"></i>
    <span>❤️ いいね</span>
  <% end %>
<% end %>

        <!-- Bookmark Button -->
        <% if current_user.bookmarked?(@route) %>
  <%# Удаление закладки (Unlike style) %>
  <%= button_to route_bookmark_path(@route),
                method: :delete,
                params: { item_type: 'Route', item_id: @route.id },
                class: "action-btn btn-save active" do %>
    <i class="fas fa-bookmark"></i>
    <span> 保存済み</span>
  <% end %>
<% else %>
  <%# Создание закладки %>
  <%= button_to route_bookmark_path(@route),
                method: :post,
                params: { item_type: 'Route', item_id: @route.id },
                class: "action-btn btn-save" do %>
    <i class="far fa-bookmark"></i>
    <span>🔖 保存</span>
  <% end %>
  <% end %>
<% end %>

      <!-- Share Button -->
      <button class="action-btn btn-share" onclick="shareRoute()">
        <i class="fas fa-share-alt"></i>
        <span>シェア</span>
      </button>

      <!-- Edit Button (Owner Only) -->
      <% if user_signed_in? && current_user == @route.user %>
        <%= link_to edit_route_path(@route), class: "action-btn btn-edit" do %>
          <i class="fas fa-edit"></i>
          <span>編集</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
</div>


<!-- Main Content -->
<div class="route-detail-content">
  <div class="route-detail-grid">
    <!-- Left Column: Main Content -->
    <div class="main-content">

      <!-- Route Items List -->
      <div class="content-card">
        <h2 class="section-title">
          <i class="fas fa-route"></i>
          ルート詳細 (<%= @route_items.count %>場所)
        </h2>

        <% if @route_items.any? %>
          <div class="venue-list">
  <% @route_items.each_with_index do |item_data, index| %>
