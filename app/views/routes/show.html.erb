<% content_for :title, "#{@route.name} - Smart Routes" %>

<%= render 'pages/header' %>

<% if notice %>
  <div class="flash-message flash-notice">
    <i class="fas fa-check-circle"></i>
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="flash-message flash-alert">
    <i class="fas fa-exclamation-circle"></i>
    <%= alert %>
  </div>
<% end %>

<!-- Hero Section -->
<section class="route-hero">
  <div class="route-hero-content">
    <!-- Meta Header -->
    <div class="route-meta-header">
      <div class="user-info">
        <div class="user-avatar">
          <% if @route.user.avatar.present? %>
            <%= image_tag @route.user.avatar.thumb.url, alt: @route.user.username %>
          <% else %>
            <%= @route.user.username[0].upcase %>
          <% end %>
        </div>
        <div class="user-name-date">
          <strong>@<%= @route.user.username %></strong>
          <small><%= @route.created_at.strftime('%Y年%m月%d日') %>に作成</small>
        </div>
      </div>
      
      <div class="route-stats">
        <div class="stat-item">
          <i class="fas fa-eye"></i>
          <span><%= @route.view_count || 0 %></span>
        </div>
        <div class="stat-item">
          <i class="fas fa-heart"></i>
          <span><%= @route.likes_count || 0 %></span>
        </div>
        <div class="stat-item">
          <i class="fas fa-bookmark"></i>
          <span><%= @route.bookmarks_count || 0 %></span>
        </div>
      </div>
    </div>
    
    <!-- Title Section -->
    <div class="route-title-section">
      <h1><%= @route.name %></h1>
      <% if @route.description.present? %>
        <p><%= @route.description %></p>
      <% end %>
      
      <div class="route-quick-info">
        <div class="quick-info-item">
          <i class="fas fa-map-marker-alt"></i>
          <span><%= @route_items.count %>場所</span>
        </div>
        <% if @route.estimated_duration.present? %>
          <div class="quick-info-item">
            <i class="fas fa-clock"></i>
            <span><%= @route.estimated_duration %>分</span>
          </div>
        <% end %>
        <% if @route.difficulty_level.present? %>
          <div class="quick-info-item">
            <i class="fas fa-signal"></i>
            <span><%= @route.difficulty_level %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="route-actions">
      <% if user_signed_in? %>
        <!-- Like Button -->
        <button class="action-btn btn-like <%= 'active' if current_user.liked?(@route) %>" 
                data-route-id="<%= @route.id %>">
          <i class="<%= current_user.liked?(@route) ? 'fas' : 'far' %> fa-heart"></i>
          <span>いいね</span>
        </button>
        
        <!-- Bookmark Button -->
        <button class="action-btn btn-save <%= 'active' if current_user.bookmarked?(@route) %>"
                data-route-id="<%= @route.id %>">
          <i class="<%= current_user.bookmarked?(@route) ? 'fas' : 'far' %> fa-bookmark"></i>
          <span>保存</span>
        </button>
      <% end %>
      
      <!-- Share Button -->
      <button class="action-btn btn-share" onclick="shareRoute()">
        <i class="fas fa-share-alt"></i>
        <span>シェア</span>
      </button>
      
      <!-- Edit Button (Owner Only) -->
      <% if user_signed_in? && current_user == @route.user %>
        <%= link_to edit_route_path(@route), class: "action-btn btn-edit" do %>
          <i class="fas fa-edit"></i>
          <span>編集</span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- Main Content -->
<div class="route-detail-content">
  <div class="route-detail-grid">
    <!-- Left Column: Main Content -->
    <div class="main-content">
      
      <!-- Route Items List -->
      <div class="content-card">
        <h2 class="section-title">
          <i class="fas fa-route"></i>
          ルート詳細 (<%= @route_items.count %>場所)
        </h2>
        
        <% if @route_items.any? %>
          <div class="venue-list">
            <% @route_items.order(:position).each_with_index do |route_item, index| %>
              <% venue = route_item.item %>
              <%= link_to venue_path(venue), class: "venue-list-item" do %>
                <div class="venue-number"><%= index + 1 %></div>
                
                <div class="venue-info">
                  <h4><%= venue.name %></h4>
                  <p><%= truncate(venue.description, length: 100) if venue.description.present? %></p>
                  
                  <div class="venue-tags-inline">
                    <% if venue.cuisine_type.present? %>
                      <span class="tag-inline">
                        <i class="fas fa-utensils"></i>
                        <%= venue.cuisine_type %>
                      </span>
                    <% end %>
                    <% if venue.district.present? %>
                      <span class="tag-inline">
                        <i class="fas fa-map-marked-alt"></i>
                        <%= venue.district %>
                      </span>
                    <% end %>
                    <% if venue.price_range.present? %>
                      <span class="tag-inline">
                        <i class="fas fa-yen-sign"></i>
                        <%= venue.price_range %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state">
            <i class="fas fa-map-marked-alt"></i>
            <p>このルートにはまだ場所が追加されていません。</p>
          </div>
        <% end %>
      </div>

      <!-- Map Section -->
      <div class="content-card">
        <h2 class="section-title">
          <i class="fas fa-map"></i>
          マップ
        </h2>
        <div id="map" class="map-container">
          <div class="map-loading">
            <i class="fas fa-spinner fa-spin"></i>
            <span>地図を読み込んでいます...</span>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="content-card reviews-section">
        <div class="reviews-header">
          
          
          <% if user_signed_in? %>
            <button class="write-review-btn" onclick="scrollToReviewForm()">
              <i class="fas fa-pen"></i>
              <span>レビューを書く</span>
            </button>
          <% end %>
        </div>

        

        <!-- Review Form -->
        <div class="user-review-action" id="review-form-section">
          <% if user_signed_in? %>
            <% existing_review = @route.reviews.find_by(user_id: current_user.id) %>
            <% if existing_review %>
              <div class="alert-card alert-info">
                <i class="fas fa-check-circle"></i>
                <div class="alert-content">
                  <strong>あなたはすでにレビューを投稿しています。</strong>
                  <p>既存のレビューを編集できます。</p>
                </div>
                <%= link_to edit_route_path(existing_review), class: 'btn btn-edit-review' do %>
                  <i class="fas fa-edit"></i>
                  編集する
                <% end %>
              </div>
            <% else %>
              <%= render 'reviews/form', reviewable: @route %>
            <% end %>
          <% else %>
            <div class="alert-card alert-login">
              <i class="fas fa-sign-in-alt"></i>
              <div class="alert-content">
                <strong>レビューを投稿するにはログインが必要です</strong>
                <p>アカウントをお持ちの方はログインしてください。</p>
              </div>
              <%= link_to new_user_session_path, class: 'btn btn-login' do %>
                <i class="fas fa-sign-in-alt"></i>
                ログイン
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Reviews List -->
        <div class="reviews-list">
          <h4 class="reviews-list-title">
            <i class="fas fa-comments"></i>
            最新のレビュー
          </h4>
          
          <% if @reviews.any? %>
            <% @reviews.order(created_at: :desc).limit(10).each do |review| %>
              <div class="review-item">
                <div class="review-header">
                  <div class="review-author">
                    <div class="review-avatar">
                      <% if review.user.avatar.present? %>
                        <%= image_tag review.user.avatar.thumb.url, alt: review.user.username %>
                      <% else %>
                        <%= review.user.username[0].upcase %>
                      <% end %>
                    </div>
                    <div class="review-author-info">
                      <div class="review-author-name"><%= review.user.username %></div>
                      <div class="review-author-username">@<%= review.user.username %></div>
                    </div>
                  </div>
                  
                  <div class="review-rating">
                    <% review.total_score.to_i.times do %>
                      <i class="fas fa-star"></i>
                    <% end %>
                    <span class="review-rating-value"><%= review.total_score %></span>
                  </div>
                </div>
                
                <div class="review-content">
                  <%= simple_format(review.text) %>
                </div>
                
                <div class="review-footer">
                  <div class="review-date">
                    <i class="far fa-clock"></i>
                    <%= time_ago_in_words(review.created_at) %>前
                  </div>
                  
                  <div class="review-actions">
                    <button class="review-action-btn" onclick="likeReview(<%= review.id %>)">
                      <i class="far fa-thumbs-up"></i>
                      <span>役に立った</span>
                    </button>
                    <button class="review-action-btn" onclick="shareReview(<%= review.id %>)">
                      <i class="fas fa-share"></i>
                      <span>共有</span>
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
            
            <% if @reviews.count > 10 %>
              <div class="load-more-reviews">
                <button class="load-more-btn" onclick="loadMoreReviews()">
                  <i class="fas fa-chevron-down"></i>
                  <span>さらに読み込む</span>
                </button>
              </div>
            <% end %>
          <% else %>
            <div class="empty-state">
              <i class="fas fa-comments"></i>
              <h3>まだレビューがありません</h3>
              <p>最初のレビューを投稿しましょう！</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Column: Sidebar -->
    <div class="sidebar">
      <!-- Author Card -->
      <div class="content-card author-card">
        <div class="author-avatar-large">
          <% if @route.user.avatar.present? %>
            <%= image_tag @route.user.avatar.thumb.url, alt: @route.user.username %>
          <% else %>
            <%= @route.user.username[0].upcase %>
          <% end %>
        </div>
        
        <div class="author-info">
          <h3 class="author-name"><%= @route.user.username %></h3>
          <p class="author-username">@<%= @route.user.username %></p>
          
          <div class="author-stats">
            <div class="author-stat-item">
              <span class="author-stat-value"><%= @route.user.routes.count %></span>
              <span class="author-stat-label">ルート</span>
            </div>
            <div class="author-stat-item">
              <span class="author-stat-value"><%= @route.user.followers_count || 0 %></span>
              <span class="author-stat-label">フォロワー</span>
            </div>
          </div>
          
          <% if user_signed_in? && current_user != @route.user %>
            <button class="follow-btn <%= 'following' if current_user.following?(@route.user) %>"
                    data-user-id="<%= @route.user.id %>">
              <span>
                <%= current_user.following?(@route.user) ? 'フォロー中' : 'フォローする' %>
              </span>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Related Routes -->
      <% if @related_routes.any? %>
        <div class="content-card">
          <h3 class="section-title">
            <i class="fas fa-route"></i>
            関連ルート
          </h3>
          
          <div class="routes-section">
            <% @related_routes.limit(5).each do |route| %>
              <%= link_to route_path(route), class: "route-mini-card" do %>
                <div class="route-mini-card-header">
                  <div class="route-mini-icon">
                    <i class="fas fa-map-marked-alt"></i>
                  </div>
                  <div class="route-mini-card-title"><%= route.name %></div>
                </div>
                <div class="route-mini-card-meta">
                  <div class="route-mini-card-meta-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <%= route.route_items.count %>場所
                  </div>
                  <div class="route-mini-card-meta-item">
                    <i class="fas fa-heart"></i>
                    <%= route.likes_count || 0 %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'pages/footer' %>

<script>
// 1. Безопасно передаем данные из Ruby в JS одной строкой JSON
const routeItems = <%= raw @route_items.map { |ri| 
  venue = ri.item
  {
    name: venue.name,
    lat: (venue.respond_to?(:geo_lat) ? venue.geo_lat : venue.try(:latitude)).to_f,
    lng: (venue.respond_to?(:geo_lng) ? venue.geo_lng : venue.try(:longitude)).to_f,
    address: venue.try(:address) || ""
  }
}.to_json %>;

// 2. Функция инициализации (вызовется сама через callback)
function initMap() {
  const mapElement = document.getElementById("map");
  if (!mapElement || routeItems.length === 0) return;

  const bounds = new google.maps.LatLngBounds();
  const map = new google.maps.Map(mapElement, {
    mapTypeControl: false,
    streetViewControl: false,
    fullscreenControl: true,
  });

  const markers = routeItems.map((item, index) => {
    const position = { lat: item.lat, lng: item.lng };
    bounds.extend(position);

    const marker = new google.maps.Marker({
      position,
      map,
      label: { text: `${index + 1}`, color: "white", fontWeight: "bold" },
      icon: {
        path: google.maps.SymbolPath.CIRCLE,
        fillColor: "#667eea",
        fillOpacity: 1,
        strokeColor: "white",
        strokeWeight: 2,
        scale: 18
      }
    });

    const infoWindow = new google.maps.InfoWindow({
      content: `<div style="padding:5px"><strong>${item.name}</strong><br><small>${item.address}</small></div>`
    });

    marker.addListener("click", () => infoWindow.open(map, marker));
    return marker;
  });

  if (routeItems.length > 1) {
    new google.maps.Polyline({
      path: routeItems.map(i => ({ lat: i.lat, lng: i.lng })),
      map,
      strokeColor: "#667eea",
      strokeWeight: 4
    });
    map.fitBounds(bounds);
  } else {
    map.setCenter({ lat: routeItems[0].lat, lng: routeItems[0].lng });
    map.setZoom(15);
  }
}
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap" async defer></script>
