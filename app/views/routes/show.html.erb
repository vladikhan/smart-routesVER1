<!DOCTYPE html>
<html>
<head>
  <title><%= @route.name %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'routes', media: 'all' %>
</head>
<body>
  <%= render 'pages/header' %>

  <section class="route-hero">
    <div class="route-hero-content">
      <div class="route-meta-header">
        <div class="user-info">
          <div class="user-avatar">
            <% if @route.user.avatar.present? %>
              <%= image_tag @route.user.avatar.thumb.url %>
            <% else %>
              👤
            <% end %>
          </div>
          <div>
            <div>@<%= @route.user.username %></div>
            <div><%= @route.created_at.strftime('%Y年%m月%d日') %>に作成</div>
          </div>
        </div>
        
        <div class="route-stats">
          <div class="stat-item">👁️ <%= @route.view_count || 0 %></div>
          <div class="stat-item">❤️ <%= @route.likes_count || 12 %></div>
          <div class="stat-item">💾 <%= @route.bookmarks_count || 5 %></div>
        </div>
      </div>
      
      <div class="route-title-section">
        <h1><%= @route.name %></h1>
        <p style="font-size: 18px; opacity: 0.9; margin-bottom: 20px;">
          <%= @route.description %>
        </p>
        
        <div class="route-quick-info">
          <% if @route.difficulty_level.present? %>
            <div class="quick-info-item">
              <span style="background: rgba(255,255,255,0.2); padding: 3px 12px; border-radius: 5px;">
                <%= @route.difficulty_level %>
              </span>
            </div>
          <% end %>
          <div class="quick-info-item">⏱️ <%= @route.estimated_duration %>分</div>
          <div class="quick-info-item">💰 約¥<%= number_with_delimiter(@route.estimated_cost) %></div>
          <div class="quick-info-item">📍 <%= @route_items.count %>場所</div>
        </div>
      </div>
      
      <div class="route-actions">
        <button class="action-btn btn-like">❤️ いいね</button>
        <button class="action-btn btn-save">💾 保存</button>
        <button class="action-btn btn-share">📤 共有</button>

        <% if current_user == @route.user %>
          <%= link_to edit_route_path(@route),  class: "action-btn btn-edit" do %>
          編集
        <% end %>
      <% end %>
      </div>
    </div>
  </section>

  <div class="route-detail-content">
    <div class="route-detail-grid">
      <div>
        <div class="content-card">
          <h2 class="section-title">📍 ルート詳細 (<%= @route_items.count %>場所)</h2>
          
          <% @route_items.each_with_index do |item, index| %>
            <%= link_to venue_path(item.venue), style: "text-decoration: none; color: inherit;" do %>
              <div class="venue-list-item">
                <div class="venue-number"><%= index + 1 %></div>
                <div class="venue-info">
                  <h4><%= item.venue.name %></h4>
                  <p><%= truncate(item.venue.description, length: 100) %></p>
                  <div class="venue-tags-inline">
                    <span class="tag-inline">⏱️ <%= item.duration_minutes %>分</span>
                    <% if item.venue.cuisine_type.present? %>
                      <span class="tag-inline"><%= item.venue.cuisine_type %></span>
                    <% end %>
                    <% if item.venue.price_range.present? %>
                      <span class="tag-inline"><%= item.venue.price_range %></span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="content-card">
          <h2 class="section-title">マップ</h2>
          <div id="map" style="width: 100%; height: 400px; border-radius: 8px; background: #e0e0e0;"></div>
        </div>

        <div class="content-card">
          <h2 class="section-title">⭐ レビュー (<%= @reviews.count %>)</h2>
          
          <% if @reviews.any? %>
            <% @reviews.limit(5).each do |review| %>
              <div class="review-item">
                <div class="review-header">
                  <span class="review-author">@<%= review.user.username %></span>
                  <span class="review-rating">⭐ <%= review.total_score %></span>
                </div>
                <p class="review-text"><%= review.text %></p>
                <div class="review-date"><%= review.created_at.strftime('%Y年%m月%d日') %></div>
              </div>
            <% end %>
          <% else %>
            <p style="color: #999; text-align: center; padding: 40px 0;">まだレビューがありません</p>
          <% end %>
        </div>
      </div>

      <div class="sidebar">
        <div class="content-card author-card">
          <div class="author-avatar-large">👤</div>
          <h3 style="margin-bottom: 5px;">@<%= @route.user.username %></h3>
          <p style="color: #666; font-size: 14px; margin-bottom: 15px;">
            <%= @route.user.bio || "旅行が大好きです！" %>
          </p>
          
          <div style="display: flex; justify-content: space-around; padding: 15px 0; border-top: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">
            <div style="text-align: center;">
              <div style="font-weight: 700; font-size: 20px;">12</div>
              <div style="color: #666; font-size: 12px;">フォロー</div>
            </div>
            <div style="text-align: center;">
              <div style="font-weight: 700; font-size: 20px;">95</div>
              <div style="color: #666; font-size: 12px;">フォロワー</div>
            </div>
          </div>
          
          <button class="follow-btn">フォロー</button>
        </div>

        <div class="content-card">
          <h3 style="margin-bottom: 15px; font-size: 16px;">似ているルート</h3>
          
          <% Route.where(is_public: true).where.not(id: @route.id).limit(3).each do |similar_route| %>
            <%= link_to route_path(similar_route), style: "text-decoration: none;" do %>
              <div style="padding: 12px; background: #f8f9fa; border-radius: 8px; margin-bottom: 10px;">
                <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 5px; color: #333;">
                  <%= truncate(similar_route.name, length: 40) %>
                </h4>
                <small style="color: #666;">
                  ⏱️ <%= similar_route.estimated_duration %>分 • 
                  💰 ¥<%= number_with_delimiter(similar_route.estimated_cost) %>
                </small>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'pages/footer' %>

  <script>
    var API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
    var routeItems = <%= raw @route_items.map { |item| 
      {
        name: item.venue.name,
        lat: item.venue.latitude&.to_f,
        lng: item.venue.longitude&.to_f,
        address: item.venue.address
      }
    }.to_json %>;

    function initMap() {
      console.log('initMap called');
      console.log('Route items:', routeItems);
      
      var validItems = routeItems.filter(function(item) {
        return item.lat && item.lng;
      });
      
      console.log('Valid items:', validItems.length);

      if (validItems.length === 0) {
        document.getElementById('map').innerHTML = 
          '<div style="display: flex; align-items: center; justify-content: center; height: 400px; background: #fff3cd; color: #856404;"><div style="text-align: center;"><div style="font-size: 48px; margin-bottom: 10px;">📍</div><div>位置情報が登録されていません</div></div></div>';
        return;
      }

      var center = { lat: validItems[0].lat, lng: validItems[0].lng };
      
      var map = new google.maps.Map(document.getElementById('map'), {
        zoom: 13,
        center: center
      });

      var bounds = new google.maps.LatLngBounds();
      
      validItems.forEach(function(item, index) {
        var position = { lat: item.lat, lng: item.lng };
        
        var marker = new google.maps.Marker({
          position: position,
          map: map,
          label: {
            text: String(index + 1),
            color: 'white',
            fontSize: '14px',
            fontWeight: 'bold'
          },
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            fillColor: '#0288d1',
            fillOpacity: 1,
            strokeColor: 'white',
            strokeWeight: 3,
            scale: 20
          }
        });

        var infoWindow = new google.maps.InfoWindow({
          content: '<div style="padding: 10px;"><h4 style="margin: 0 0 5px 0;">' + item.name + '</h4><p style="margin: 0; color: #666; font-size: 13px;">' + (item.address || '') + '</p></div>'
        });

        marker.addListener('click', function() {
          infoWindow.open(map, marker);
        });

        bounds.extend(position);
      });

      map.fitBounds(bounds);
      console.log('Map initialized');
    }
  </script>
  
  <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap&libraries=places&language=ja"></script>
</body>
</html>
