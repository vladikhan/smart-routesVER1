
<!DOCTYPE html>
<html>
<head>
  <title><%= @route.name %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'routes', media: 'all' %>
</head>
<body>
  <%= render 'pages/header' %>

  <section class="route-hero">
    <div class="route-hero-content">
      <div class="route-meta-header">
        <div class="user-info">
          <div class="user-avatar">
            <% if @route.user.avatar.present? %>
              <%= image_tag @route.user.avatar.thumb.url %>
            <% else %>
              👤
            <% end %>
          </div>
          <div>
            <div>@<%= @route.user.username %></div>
            <div><%= @route.created_at.strftime('%Y年%m月%d日') %>に作成</div>
          </div>
        </div>
        
        <div class="route-stats">
          <div class="stat-item">👁️ <%= @route.view_count || 0 %></div>
          <div class="stat-item">❤️ <%= @route.likes_count || 0 %></div>
          <div class="stat-item">💾 <%= @route.bookmarks_count || 0 %></div>
        </div>
      </div>
      
      <div class="route-title-section">
        <h1><%= @route.name %></h1>
        <% if @route.description.present? %>
          <p style="font-size: 18px; opacity: 0.9; margin-bottom: 20px;">
            <%= @route.description %>
          </p>
        <% end %>
        
        <div class="route-quick-info">
          <% if @route.difficulty_level.present? %>
            <div class="quick-info-item">
              <span style="background: rgba(255,255,255,0.2); padding: 3px 12px; border-radius: 5px;">
                <%= @route.difficulty_level %>
              </span>
            </div>
          <% end %>
          <% if @route.estimated_duration.present? && @route.estimated_duration > 0 %>
            <div class="quick-info-item">⏱️ <%= @route.estimated_duration %>分</div>
          <% end %>
          <% if @route.estimated_cost.present? && @route.estimated_cost > 0 %>
            <div class="quick-info-item">💰 約¥<%= number_with_delimiter(@route.estimated_cost) %></div>
          <% end %>
          <div class="quick-info-item">📍 <%= @route_items.count %>場所</div>
        </div>
      </div>
      
      <div class="route-actions">
        <button class="action-btn btn-like">❤️ いいね</button>
        <button class="action-btn btn-save">💾 保存</button>
        <button class="action-btn btn-share">📤 共有</button>

        <% if user_signed_in? && current_user == @route.user %>
          <%= link_to edit_route_path(@route), class: "action-btn btn-edit" do %>
            ✏️ 編集
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <div class="route-detail-content">
    <div class="route-detail-grid">
      <div>
        <div class="content-card">
          <h2 class="section-title">📍 ルート詳細 (<%= @route_items.count %>場所)</h2>
          
          <% if @route_items.any? %>
            <% @route_items.each_with_index do |route_item, index| %>
              <% 
                # Handle both 'venue' and 'item' associations
                venue = route_item.respond_to?(:venue) ? route_item.venue : (route_item.respond_to?(:item) ? route_item.item : nil)
              %>
              
              <% if venue.present? %>
                <%= link_to venue_path(venue), style: "text-decoration: none; color: inherit;" do %>
                  <div class="venue-list-item">
                    <div class="venue-number"><%= index + 1 %></div>
                    <div class="venue-info">
                      <h4><%= venue.name %></h4>
                      <p><%= truncate(venue.description, length: 100) if venue.description.present? %></p>
                      <div class="venue-tags-inline">
                        <span class="tag-inline">⏱️ <%= route_item.duration_minutes %>分</span>
                        <% if venue.cuisine_type.present? %>
                          <span class="tag-inline"><%= venue.cuisine_type %></span>
                        <% end %>
                        <% if venue.price_range.present? %>
                          <span class="tag-inline"><%= venue.price_range %></span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="venue-list-item" style="opacity: 0.7;">
                  <div class="venue-number"><%= index + 1 %></div>
                  <div class="venue-info">
                    <h4><%= route_item.venue_name || "場所" %></h4>
                    <p><%= route_item.venue_address if route_item.venue_address.present? %></p>
                    <div class="venue-tags-inline">
                      <span class="tag-inline">⏱️ <%= route_item.duration_minutes %>分</span>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div style="text-align: center; padding: 60px 20px; color: #999;">
              <div style="font-size: 64px; margin-bottom: 15px;">📍</div>
              <p>このルートにはまだ場所が追加されていません</p>
            </div>
          <% end %>
        </div>

        <div class="content-card">
          <h2 class="section-title">🗺️ マップ</h2>
          <div id="map" style="width: 100%; height: 400px; border-radius: 8px; background: #e0e0e0;"></div>
        </div>

        <div class="content-card">
          <h2 class="section-title">⭐ レビュー (<%= @reviews.count %>)</h2>
          
          <% if @reviews.any? %>
            <% @reviews.limit(5).each do |review| %>
              <div class="review-item">
                <div class="review-header">
                  <span class="review-author">@<%= review.user.username %></span>
                  <span class="review-rating">⭐ <%= review.total_score %></span>
                </div>
                <p class="review-text"><%= review.text %></p>
                <div class="review-date"><%= review.created_at.strftime('%Y年%m月%d日') %></div>
              </div>
            <% end %>
          <% else %>
            <p style="color: #999; text-align: center; padding: 40px 0;">まだレビューがありません</p>
          <% end %>
        </div>
      </div>

      <div class="sidebar">
        <div class="content-card author-card">
          <div class="author-avatar-large">
            <% if @route.user.avatar.present? %>
              <%= image_tag @route.user.avatar.thumb.url %>
            <% else %>
              👤
            <% end %>
          </div>
          <h3 style="margin-bottom: 5px;">@<%= @route.user.username %></h3>
          <p style="color: #666; font-size: 14px; margin-bottom: 15px;">
            <%= @route.user.bio || "旅行が大好きです！" %>
          </p>
          
          <div style="display: flex; justify-content: space-around; padding: 15px 0; border-top: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0;">
            <div style="text-align: center;">
              <div style="font-weight: 700; font-size: 20px;"><%= @route.user.routes.count %></div>
              <div style="color: #666; font-size: 12px;">ルート</div>
            </div>
            <div style="text-align: center;">
              <div style="font-weight: 700; font-size: 20px;">0</div>
              <div style="color: #666; font-size: 12px;">フォロワー</div>
            </div>
          </div>
          
          <% unless user_signed_in? && current_user == @route.user %>
            <button class="follow-btn">フォロー</button>
          <% end %>
        </div>

        <% if @route.tags.any? %>
          <div class="content-card">
            <h3 style="margin-bottom: 15px; font-size: 16px;">🏷️ タグ</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <% @route.tags.each do |tag| %>
                <span style="background: #e3f2fd; color: #0277bd; padding: 6px 12px; border-radius: 12px; font-size: 13px; font-weight: 600;">
                  #<%= tag.display_name %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="content-card">
          <h3 style="margin-bottom: 15px; font-size: 16px;">似ているルート</h3>
          
          <% similar_routes = Route.where(is_public: true).where.not(id: @route.id).limit(3) %>
          <% if similar_routes.any? %>
            <% similar_routes.each do |similar_route| %>
              <%= link_to route_path(similar_route), style: "text-decoration: none;" do %>
                <div style="padding: 12px; background: #f8f9fa; border-radius: 8px; margin-bottom: 10px; transition: all 0.3s;">
                  <h4 style="font-size: 14px; font-weight: 600; margin-bottom: 5px; color: #333;">
                    <%= truncate(similar_route.name, length: 40) %>
                  </h4>
                  <small style="color: #666;">
                    <% if similar_route.estimated_duration.present? && similar_route.estimated_duration > 0 %>
                      ⏱️ <%= similar_route.estimated_duration %>分
                    <% end %>
                    <% if similar_route.estimated_cost.present? && similar_route.estimated_cost > 0 %>
                      • 💰 ¥<%= number_with_delimiter(similar_route.estimated_cost) %>
                    <% end %>
                  </small>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p style="color: #999; font-size: 13px;">関連するルートがありません</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'pages/footer' %>

  <script>
    const API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
    
    // Build route items data - handle both venue and item associations
    const routeItems = [
      <% @route_items.each do |route_item| %>
        <% 
          venue = route_item.respond_to?(:venue) ? route_item.venue : (route_item.respond_to?(:item) ? route_item.item : nil)
        %>
        <% if venue.present? && (venue.geo_lat.present? || (venue.respond_to?(:latitude) && venue.latitude.present?)) %>
          {
            name: <%= raw venue.name.to_json %>,
            lat: <%= venue.geo_lat || (venue.respond_to?(:latitude) ? venue.latitude : 0) %>,
            lng: <%= venue.geo_lng || (venue.respond_to?(:longitude) ? venue.longitude : 0) %>,
            address: <%= raw (venue.address || '').to_json %>
          },
        <% end %>
      <% end %>
    ];

    function initMap() {
      console.log('🗺️ initMap called');
      console.log('📊 Route items:', routeItems);
      
      const validItems = routeItems.filter(item => {
        return item.lat && item.lng && !isNaN(item.lat) && !isNaN(item.lng);
      });
      
      console.log('✓ Valid items:', validItems.length);

      if (validItems.length === 0) {
        document.getElementById('map').innerHTML = 
          '<div style="display: flex; align-items: center; justify-content: center; height: 400px; background: #fff3cd; color: #856404; border-radius: 8px;">' +
          '<div style="text-align: center;">' +
          '<div style="font-size: 48px; margin-bottom: 10px;">📍</div>' +
          '<div style="font-weight: 600;">位置情報が登録されていません</div>' +
          '<div style="font-size: 13px; margin-top: 5px;">ルート編集で場所を追加してください</div>' +
          '</div></div>';
        return;
      }

      const center = { lat: validItems[0].lat, lng: validItems[0].lng };
      
      const map = new google.maps.Map(document.getElementById('map'), {
        zoom: 13,
        center: center,
        mapTypeControl: true,
        streetViewControl: true,
        fullscreenControl: true
      });

      const bounds = new google.maps.LatLngBounds();
      const markers = [];
      
      validItems.forEach((item, index) => {
        const position = { lat: item.lat, lng: item.lng };
        
        const marker = new google.maps.Marker({
          position: position,
          map: map,
          label: {
            text: String(index + 1),
            color: 'white',
            fontSize: '14px',
            fontWeight: 'bold'
          },
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            fillColor: '#0288d1',
            fillOpacity: 1,
            strokeColor: 'white',
            strokeWeight: 3,
            scale: 20
          }
        });

        const infoWindow = new google.maps.InfoWindow({
          content: '<div style="padding: 10px;">' +
                   '<h4 style="margin: 0 0 5px 0; font-size: 15px;">' + item.name + '</h4>' +
                   '<p style="margin: 0; color: #666; font-size: 13px;">' + (item.address || '') + '</p>' +
                   '</div>'
        });

        marker.addListener('click', () => {
          markers.forEach(m => {
            if (m.infoWindow) m.infoWindow.close();
          });
          infoWindow.open(map, marker);
        });

        marker.infoWindow = infoWindow;
        markers.push(marker);
        bounds.extend(position);
      });

      // Draw route line
      if (validItems.length > 1) {
        const routePath = new google.maps.Polyline({
          path: validItems.map(item => ({ lat: item.lat, lng: item.lng })),
          geodesic: true,
          strokeColor: '#0288d1',
          strokeOpacity: 0.8,
          strokeWeight: 4
        });
        routePath.setMap(map);
      }

      if (validItems.length > 1) {
        map.fitBounds(bounds);
      }
      
      console.log('✓ Map initialized with', validItems.length, 'markers');
    }

    // Load Google Maps dynamically
    function loadGoogleMaps() {
      if (!API_KEY) {
        console.error('❌ Google Maps API key not set');
        document.getElementById('map').innerHTML = 
          '<div style="display: flex; align-items: center; justify-content: center; height: 400px; background: #ffebee; color: #c62828; border-radius: 8px;">' +
          '<div style="text-align: center;">' +
          '<div style="font-size: 48px; margin-bottom: 10px;">⚠️</div>' +
          '<div style="font-weight: 600;">Google Maps APIキーが設定されていません</div>' +
          '</div></div>';
        return;
      }

      if (window.google && window.google.maps) {
        console.log('✓ Google Maps already loaded, initializing...');
        initMap();
        return;
      }

      console.log('📥 Loading Google Maps script...');
      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${API_KEY}&callback=initMap&language=ja`;
      script.async = true;
      script.defer = true;
      script.onerror = () => {
        console.error('❌ Failed to load Google Maps');
        document.getElementById('map').innerHTML = 
          '<div style="display: flex; align-items: center; justify-content: center; height: 400px; background: #ffebee; color: #c62828; border-radius: 8px;">' +
          '<div style="text-align: center;">' +
          '<div style="font-size: 48px; margin-bottom: 10px;">❌</div>' +
          '<div style="font-weight: 600;">Google Mapsの読み込みに失敗しました</div>' +
          '</div></div>';
      };
      
      window.initMap = initMap;
      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadGoogleMaps);
    } else {
      loadGoogleMaps();
    }
  </script>
</body>
</html>
