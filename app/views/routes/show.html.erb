<%# 1. Мета-данные %>
<% content_for :title, "#{@route.name} - Smart Routes" %>

<%# 2. Шапка и сообщения (уже есть в layout, но если нужно здесь — оставляем) %>
<%= render 'pages/header' %>

<% if notice %><div class="flash-message flash-notice"><%= notice %></div><% end %>
<% if alert %><div class="flash-message flash-alert"><%= alert %></div><% end %>

<section class="route-hero">
  <%# ... (твой код hero-секции без изменений) ... %>
  <div class="route-hero-content">
    <div class="route-meta-header">
      <div class="user-info">
        <div class="user-avatar">
          <% if @route.user.avatar.present? %><%= image_tag @route.user.avatar.thumb.url %><% else %>👤<% end %>
        </div>
        <div>
          <div>@<%= @route.user.username %></div>
          <div><%= @route.created_at.strftime('%Y年%m月%d日') %>に作成</div>
        </div>
      </div>
    </div>
    
    <div class="route-title-section">
      <h1><%= @route.name %></h1>
      <% if @route.description.present? %><p><%= @route.description %></p><% end %>
      
      <div class="route-quick-info">
        <div class="quick-info-item">📍 <%= @route_items.count %>場所</div>
        <% if @route.estimated_duration.present? %><div class="quick-info-item">⏱️ <%= @route.estimated_duration %>分</div><% end %>
      </div>
    </div>

    <div class="route-actions">
      <%# Лайки и закладки %>
      
      <% if user_signed_in? && current_user == @route.user %>
        <%= link_to '✏️ 編集', edit_route_path(@route), class: "action-btn btn-edit" %>
      <% end %>
    </div>
  </div>
</section>

<div class="route-detail-content">
  <div class="route-detail-grid">
    <div>
      <%# Секция списка мест %>
      <div class="content-card">
        <h2 class="section-title">📍 ルート詳細 (<%= @route_items.count %>場所)</h2>
        <%# ... твой цикл @route_items.each ... %>
      </div>

      <%# Секция карты %>
      <div class="content-card">
        <h2 class="section-title">マップ</h2>
        <div id="map" style="width: 100%; height: 400px; border-radius: 8px; background: #e0e0e0;"></div>
      </div>

      <%# --- НОВЫЙ БЛОК ОТЗЫВОВ (ВМЕСТО СТАРОГО) --- %>
      <div class="content-card reviews-section shadow-sm border-0 rounded-3 mb-4 p-4">
        <div class="reviews-header d-flex align-items-center justify-content-between mb-4">
          <h2 class="section-title m-0">⭐ レビュー</h2>
          <div class="total-rating-box text-end">
            <div class="d-flex align-items-center justify-content-end gap-2">
              <%= render_stars(@route.average_rating || 0) %>
              <span class="rating-number h4 m-0 fw-bold">
                <%= @route.average_rating&.round(1) || '0.0' %>
              </span>
            </div>
            <small class="text-muted">(<%= @reviews.count %>件のレビュー)</small>
          </div>
        </div>

        <%# Распределение по звёздам %>
        <div class="rating-distribution mb-5 p-3 bg-light rounded-3">
          <% 5.downto(1) do |rating| %>
            <% count = @reviews.where(total_score: rating).count %>
            <% percentage = @reviews.count > 0 ? (count.to_f / @reviews.count * 100).round : 0 %>
            <div class="rating-bar d-flex align-items-center mb-2">
              <span class="rating-label fw-bold" style="width: 40px;"><%= rating %>⭐</span>
              <div class="progress flex-grow-1 mx-3" style="height: 8px; background-color: #e9ecef;">
                <div class="progress-bar bg-warning" style="width: <%= percentage %>%"></div>
              </div>
              <span class="rating-count text-muted" style="width: 30px;"><%= count %></span>
            </div>
          <% end %>
        </div>

        <%# Форма создания отзыва (логика "Один раз") %>
        <div class="user-review-action mb-5">
          <% if user_signed_in? %>
            <% existing_review = @route.reviews.find_by(user_id: current_user.id) %>
            <% if existing_review %>
              <div class="alert alert-info border-0 shadow-sm d-flex justify-content-between align-items-center">
                <span><i class="fas fa-check-circle me-2"></i>あなたはすでにレビューを投稿しています。</span>
                <%= link_to '編集する', '#', class: 'btn btn-sm btn-outline-info', onclick: "editReview(#{existing_review.id}); return false;" %>
              </div>
            <% else %>
              <%= render 'reviews/form', reviewable: @route %>
            <% end %>
          <% else %>
            <div class="alert alert-secondary text-center border-0 shadow-sm">
              <p class="mb-2">レビューを投稿するにはログインが必要です</p>
              <%= link_to 'ログインしてレビューを書к', new_user_session_path, class: 'btn btn-sm btn-primary' %>
            </div>
          <% end %>
        </div>

        <%# Список последних комментариев %>
        <div class="reviews-list">
          <h4 class="mb-4" style="font-size: 1.1rem; font-weight: 700;">最新のコメント</h4>
          <% if @reviews.any? %>
            <%= render partial: 'reviews/review', collection: @reviews.recent.limit(10), as: :review %>
          <% else %>
            <div class="text-center py-5">
              <div class="empty-icon mb-3" style="font-size: 3rem; opacity: 0.3;">💬</div>
              <p class="text-muted">まだレビューがありません。</p>
            </div>
          <% end %>
        </div>
      </div>

    </div>

    <%# Сайдбар %>
    
  </div>
</div>

<%= render 'pages/footer' %>

  <script>
    const API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';

     // Auto-hide flash messages
    setTimeout(() => {
      document.querySelectorAll('.flash-message').forEach(msg => msg.remove());
    }, 4000);

    // Delete confirmation
    function confirmDelete() {
      document.getElementById('deleteModal').classList.add('show');
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.remove('show');
    }

    // Close modal on background click
    document.getElementById('deleteModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'deleteModal') {
        closeDeleteModal();
      }
    });

    // Build route items data - handle both venue and item associations
   // =======================
// 🗺️ ROUTE ITEMS DATA
// =======================
const routeItems = [
  <% @route_items.each do |route_item| %>
    <% venue = route_item.item %>
    <% if venue.present? %>
    <% lat = venue.respond_to?(:geo_lat) ? venue.geo_lat : venue.try(:latitude) %>
      <% lng = venue.respond_to?(:geo_lng) ? venue.geo_lng : venue.try(:longitude) %>
      <% if lat.present? && lng.present? %>
        {
          name: <%= raw venue.name.to_json %>,
          lat: <%= lat %>,
          lng: <%= lng %>,
          address: <%= raw (venue.try(:address) || '').to_json %>
        },
    <% end %>
  <% end %>
  <% end %>
];

// =======================
// 🗼 FALLBACK CENTER
// =======================
const defaultCenter = {
  lat: <%= @route.geo_lat || 35.0116 %>,  // Kyoto fallback
  lng: <%= @route.geo_lng || 135.7681 %>  // Kyoto fallback
};

// Filter valid coordinates
const validItems = routeItems.filter(item =>
  item.lat && item.lng && !isNaN(item.lat) && !isNaN(item.lng)
);

// =======================
// 🗺️ INIT MAP FUNCTION
// =======================
function initMap() {
  console.log("🗺️ initMap started");
  console.log("Total items:", routeItems.length);
  console.log("Valid items:", validItems.length);

  // Если НЕТ ни одной точки → центр на маршрут или Киото
  const centerPoint = validItems.length > 0
    ? { lat: validItems[0].lat, lng: validItems[0].lng }
    : defaultCenter;

  // Создаем карту
  const map = new google.maps.Map(document.getElementById("map"), {
    zoom: validItems.length > 0 ? 13 : 12,
    center: centerPoint,
    mapTypeControl: true,
    streetViewControl: true,
    fullscreenControl: true,
  });

  // Если нет точек — просто карта, без маркеров
  if (validItems.length === 0) {
    console.warn("⚠️ No coords. Map loaded with fallback center:", centerPoint);
    return;
  }

  // === Маркеры ===
  const bounds = new google.maps.LatLngBounds();
  const markers = [];

  validItems.forEach((item, index) => {
    const position = { lat: item.lat, lng: item.lng };

    const marker = new google.maps.Marker({
      position,
      map,
      label: {
        text: `${index + 1}`,
        color: "white",
        fontSize: "14px",
        fontWeight: "bold"
      },
      icon: {
        path: google.maps.SymbolPath.CIRCLE,
        fillColor: "#0288d1",
        fillOpacity: 1,
        strokeColor: "white",
        strokeWeight: 3,
        scale: 20,
      },
    });

    const infoWindow = new google.maps.InfoWindow({
      content: `
        <div style="padding: 10px;">
          <h4 style="margin: 0; font-size: 15px;">${item.name}</h4>
          <p style="margin: 5px 0 0; color: #666; font-size: 13px;">${item.address || ""}</p>
        </div>
      `
    });

    marker.addListener("click", () => {
      markers.forEach(m => m.infoWindow?.close());
      infoWindow.open(map, marker);
    });

    marker.infoWindow = infoWindow;
    markers.push(marker);
    bounds.extend(position);
  });

  // Линия маршрута
  if (validItems.length > 1) {
    new google.maps.Polyline({
      path: validItems.map(item => ({ lat: item.lat, lng: item.lng })),
      map,
      strokeColor: "#0288d1",
      strokeOpacity: 0.8,
      strokeWeight: 4,
    });
    map.fitBounds(bounds);
  }
}

// =======================
// GOOGLE MAPS LOADER
// =======================

function loadGoogleMaps() {
  if (!API_KEY) {
    console.error("❌ No API key!");
    document.getElementById("map").innerHTML =
      '<div style="padding:20px;text-align:center;color:#b71c1c;">Google Maps APIキーがありません</div>';
    return;
  }

  if (window.google && window.google.maps) {
    initMap();
    return;
  }

  console.log("📥 Loading Google Maps...");
  const script = document.createElement("script");
  script.src = `https://maps.googleapis.com/maps/api/js?key=${API_KEY}&callback=initMap&language=ja`;
  script.async = true;
  script.defer = true;
  window.initMap = initMap;
  document.head.appendChild(script);
}

document.readyState === "loading"
  ? document.addEventListener("DOMContentLoaded", loadGoogleMaps)
  : loadGoogleMaps();

  </script>
</body>
</html>