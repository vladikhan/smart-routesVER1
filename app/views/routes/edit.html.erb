<!DOCTYPE html>
<html lang="en">
<head>
	<title>ルート編集 - Smart Routes</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<%= csrf_meta_tags %>
	<%= csp_meta_tag %>
	<%= stylesheet_link_tag 'application', media: 'all' %>
	<%= stylesheet_link_tag 'routes', media: 'all' %>

	<style>
    .edit-route-container {
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px;
    }

    .edit-route-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 2px solid #e0e0e0;
    }

    .edit-route-title {
      font-size: 28px;
      font-weight: 700;
      color: #333;
    }

    .btn-cancel {
      background: #f5f5f5;
      color: #666;
      padding: 10px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
    }

    .btn-cancel:hover {
      background: #e0e0e0;
      color: #333;
    }

    .form-card {
      background: white;
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      margin-bottom: 30px;
    }

    .section-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 20px;
      color: #333;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .danger-zone {
      background: #fff5f5;
      border: 2px solid #ffebee;
      border-radius: 12px;
      padding: 20px;
      margin-top: 30px;
    }

    .btn-delete {
      background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
      color: white;
      padding: 12px 24px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-delete:hover {
      background: linear-gradient(135deg, #d32f2f 0%, #c62828 100%);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(244, 67, 54, 0.4);
    }

    .form-actions {
      display: flex;
      gap: 15px;
      justify-content: flex-end;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #e0e0e0;
    }

    .btn-save {
      background: linear-gradient(135deg, #0288d1 0%, #0277bd 100%);
      color: white;
      padding: 14px 32px;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 4px 12px rgba(2, 136, 209, 0.3);
    }

    .btn-save:hover {
      background: linear-gradient(135deg, #0277bd 0%, #01579b 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(2, 136, 209, 0.4);
    }

    .route-items-list {
      margin-top: 20px;
    }

    .route-item-card {
      background: #f8f9fa;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .item-info {
      flex: 1;
    }

    .item-name {
      font-weight: 600;
      color: #333;
      margin-bottom: 5px;
    }

    .item-duration {
      font-size: 13px;
      color: #666;
    }

    .btn-remove-item {
      background: #ffebee;
      color: #d32f2f;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.2s;
    }

    .btn-remove-item:hover {
      background: #ffcdd2;
    }
  </style>


	
</head>
<body>
	<%= render 'pages/header' %>

	<div class="edit-route-container">
		<div class="edit-route-header">
			<h1 class="edit-route-title">ルート編集</h1>
			<%= link_to "キャンセル", @route, class: "btn-cancel" %>
		</div>

		<%= form_with model: @route, local: true do |f| %>
			<%# Basic information %>
			<div class="form-card">
				<div class="section-title">
          <span>基本情報</span>
				</div>

				<div class="form-group">
					<%= f.label :name, "ルート名", class: "form-label" %>
					<%= f.text_field :name, class: "form-input", placeholder: "例：京都1日観光プラン", required: true %>
				</div>

				<div class="form-group">
					<%= f.label :description, "説明", class: "form-label" %>
					<%= f.text_area :description, class: "form-textarea", rows: 4, placeholder: "このルートの魅力を説明してください..." %>
				</div>

				<div class="form-row">
					<div class="form-group">
						<%= f.label :city_id, "都市", class: "form-label" %>
						<%= f.collection_select :city_id, @cities, :id, :name, {}, class: "form-select" %>
					</div>

					<div class="form-group">
						<%= f.label :difficulty_level, "難易度", class: "form-label" %>
						<%= f.select :difficulty_level, [['簡単', 'easy'], ['普通', 'medium'], ['難しい', 'hard']],
						{},
						class: "form-select" %>
					</div>
				</div>

				<div class="form-row">
					<div class="form-group">
						<%= f.label :estimated_duration,"所要時間（分）", class: "form-label" %>
						<%= f.number_field :estimated_duration, class: "form-input", placeholder: "180", min: 0 %>
					</div>

					<div class="form-group">
						<%= f.label :estimated_cost, "予算（円）", class: "form-label" %>
						<%= f.number_field :estimated_cost, class: "form-input", placeholder: "5000", min: 0 %>
					</div>
				</div>

				<div class="form-group">
					<%= f.label :tags, "タグ", class: "form-label" %>
					<div class="tag-checkboxes-container">
						<%= f.collection_check_boxes :tag_ids, Tag.all, :id, :display_name do |b| %>
							<label class="tag-checkbox">
								<%= b.check_box %>
								<span><%= b.text %></span>
							</label>
							<% end %>
					</div>
				</div>

				<div class="form-group">
					<label class="form-checkbox">
						<%= f.check_box :is_public %>
						<span>このルートを公開する</span>
					</label>
				</div>
			</div>

			<%# Current Route Items %>
			<div class="from-card">
				<div class="section-title">
					<span>📍</span>
          <span>現在のスポット (<%= @route.route_items.count %>)</span>
        </div>

				<% if @route.route_items.any? %>
					<div class="route-items-list">
						<% @route.route_items.order(:position).each do |item| %>
							<div class="route-item-card">
								<div class="item-info">
									<div class="item-name">
										<%= item.position %>. <%= item.venue.name %>
									</div>
									<div class="item-duration">
                    ⏱️ <%= item.duration_minutes %>分 | 📍 <%= item.venue.address %>
                  </div>
								</div>
								<button type="button" class="btn-remove-item" onclick="removeItem(<%= item.id %>)">
									削除
								</button>
							</div>
							<% end %>
					</div>
					<% else %>
						<p style="text-align: center; color: #999; padding: 40px;">
            まだスポットが追加されていません
          </p>
        <% end %>

				<div style="margin-top: 20px;">
					<a href="<%= new_route_path %> style="color: #0288d1; text-decoration: none; font-weight: 600;">
            ➕ スポットを追加（新規作成画面で追加できます）					
					</a>
				</div>
			</div>

			<%# Form Actions %>
			<div class="form-actions">
				<%= link_to "キャンセル", @route, class: "btn-cancel" %>
				<%= f.submit "更新を保存", class: "btn-save" %>
			</div>
		<% end %>

		<%# Danger zone %>
		<div class="danger-zone">
			<div class="section-title" style="color: #d32f2f;">
				<span>⚠️</span>
        <span>危険な操作</span>
      </div>
			<p style="color: #666; margin-bottom: 15px;">
        このルートを削除すると、すべてのデータが完全に削除され、復元できません。
      </p>
			<%= button_to "このルートを削除", route_path(@route),
			method: :delete,
			data: { confirm: "本当にこのルートを削除しますか？この操作は取り消せません。" },
			class: "btn-delete" %>
		</div>
	</div>
	
	<%= render 'pages/footer' %>

	<script>
		funciton removeItem(itemId) {
			if (confirm('このスポットを削除しますか？')) {
				alert('スポットの削除機能は開発中です。新規作成画面で再編集してください。');
			}
		}
	</script>
</body>
</html>