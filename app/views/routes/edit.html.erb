<!DOCTYPE html>
<html>
  <head>
    <title>ルート編集 - <%= @route.name %> - Smart Routes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= stylesheet_link_tag 'routes', media: 'all' %>
    <%= stylesheet_link_tag 'editRoutes', media: 'all' %>
  </head>
  <body>
    <%= render 'pages/header' %>

    <%# Flash Messages with Animation %>
    <% if notice %>
      <div class="flash-message flash-notice">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="flash-message flash-alert">
        <%= alert %>
      </div>
    <% end %>

    <div class="edit-container">
      <div class="edit-header">
        <h1 class="edit-title">✏️ ルート編集</h1>
      </div>

      <%= form_with model: @route, local: true do |f| %>
        <!-- Basic Info -->
        <div class="form-section">
          <h2 class="section-title">基本情報</h2>

          <div class="form-group">
            <%= f.label :name, 'ルート名', class: 'form-label' %>
            <%= f.text_field :name, class: 'form-input', required: true %>
          </div>

          <div class="form-group">
            <%= f.label :description, '説明', class: 'form-label' %>
            <%= f.text_area :description, class: 'form-textarea', rows: 4 %>
          </div>

          <div class="form-row">
            <div class="form-group">
              <%= f.label :city_id, '都市', class: 'form-label' %>
              <%=
                f.select :city_id,
                         options_from_collection_for_select(
                           @cities,
                           :id,
                           :name,
                           @route.city_id,
                         ),
                         {},
                         class: 'form-select'
              %>
            </div>

            <div class="form-group">
              <%= f.label :difficulty_level, '難易度', class: 'form-label' %>
              <%=
                f.select :difficulty_level,
                         [%w[簡単 easy], %w[普通 medium], %w[難しい hard]],
                         { selected: @route.difficulty_level },
                         class: 'form-select'
              %>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <%=
                f.label :estimated_duration,
                        '所要時間（分）',
                        class: 'form-label'
              %>
              <%=
                f.number_field :estimated_duration, class: 'form-input', min: 0
              %>
            </div>

            <div class="form-group">
              <%= f.label :estimated_cost, '予算（円）', class: 'form-label' %>
              <%= f.number_field :estimated_cost, class: 'form-input', min: 0 %>
            </div>
          </div>

          <div class="form-group">
            <%= f.label :tags, 'タグ', class: 'form-label' %>
            <div class="tag-checkboxes-container">
              <%= f.collection_check_boxes :tag_ids, Tag.all, :id, :display_name do |b| %>
                <label class="tag-checkbox">
                  <%= b.check_box %>
                  <span><%= b.text %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <%= f.check_box :is_public %>
              <span>このルートを公開する</span>
            </label>
          </div>
        </div>

        <!-- Map and Spots -->
        <div class="form-section">
          <h2 class="section-title">📍 訪問場所</h2>

          <div id="edit-map" style="height: 400px; margin-bottom: 20px;"></div>

          <div id="route-items-container">
            <% @route.route_items.order(:position).each_with_index do |item, index| %>
              <div class="route-item-row spot-item" data-index="<%= index %>">
                <div class="spot-number"><%= index + 1 %></div>
                
                <input type="text" 
                       class="place-autocomplete form-control" 
                       value="<%= item.venue_name %>" 
                       placeholder="場所を検索...">

                <%# Скрытые поля для передачи данных в контроллер %>
                <input type="hidden" name="route[route_items_attributes][<%= index %>][id]" value="<%= item.id %>">
                <input type="hidden" name="route[route_items_attributes][<%= index %>][venue_name]" class="input-name" value="<%= item.venue_name %>">
                <%# ВАЖНО: используем geo_lat/lng из базы %>
                <input type="hidden" name="route[route_items_attributes][<%= index %>][venue_lat]" class="input-lat" value="<%= item.geo_lat %>">
                <input type="hidden" name="route[route_items_attributes][<%= index %>][venue_lng]" class="input-lng" value="<%= item.geo_lng %>">
                <input type="hidden" name="route[route_items_attributes][<%= index %>][venue_address]" class="input-address" value="<%= item.venue_address %>">
                <input type="hidden" name="route[route_items_attributes][<%= index %>][position]" value="<%= index %>">

                <button type="button" class="remove-item remove-spot">×</button>
              </div>
            <% end %>
          </div>

          <div class="text-center mt-3">
            <button type="button" id="add-item-btn" class="btn btn-outline-primary">
              + スポットを追加
            </button>
          </div>
        </div>

        <template id="route-item-template">
          <div class="route-item-row spot-item">
            <div class="spot-number">__POSITION__</div>
            <input type="text" class="place-autocomplete form-control" placeholder="場所を検索...">
            <input type="hidden" name="route[route_items_attributes][__INDEX__][venue_name]" class="input-name">
            <input type="hidden" name="route[route_items_attributes][__INDEX__][venue_lat]" class="input-lat">
            <input type="hidden" name="route[route_items_attributes][__INDEX__][venue_lng]" class="input-lng">
            <input type="hidden" name="route[route_items_attributes][__INDEX__][venue_address]" class="input-address">
            <input type="hidden" name="route[route_items_attributes][__INDEX__][position]" value="__INDEX__">
            <button type="button" class="remove-item remove-spot">×</button>
          </div>
        </template>

        <div class="form-actions" style="margin-top: 30px;">
          <%= link_to 'キャンセル', @route, class: 'btn btn-cancel' %>
          <%= f.submit '変更を保存', class: 'btn btn-save' %>
        </div>
      <% end %> <%# Конец формы %>

      <div class="danger-zone">
        <h3>⚠️ 危険な操作</h3>
        <p>このルートを削除すると、すべてのデータが完全に削除されます。</p>
        <%= button_to 'Удалить', route_path(@route), 
              method: :delete, 
              form: { data: { turbo_confirm: 'Вы уверены?' } },
              class: 'btn btn-danger' %>
      </div>
    </div>

    <script>
(function() {
  const API_KEY = '<%= ENV['GOOGLE_MAPS_API_KEY'] %>';
  let map, markers = [], polyline;

  // Инициализация карты
  window.initMap = function() {
    const mapElement = document.getElementById('edit-map');
    if (!mapElement) return;

    map = new google.maps.Map(mapElement, {
      zoom: 14,
      center: { lat: 35.0116, lng: 135.7681 }, // Киото по умолчанию
      mapTypeControl: false
    });

    refreshMap(); // Рисуем точки, которые уже есть в базе
    initAutocompletes(); // Подключаем поиск к полям
  };

  function refreshMap() {
    if (!map) return;
    markers.forEach(m => m.setMap(null));
    markers = [];
    if (polyline) polyline.setMap(null);

    const path = [];
    const bounds = new google.maps.LatLngBounds();

    // Ищем все строки маршрута
    document.querySelectorAll('.route-item-row').forEach((row, index) => {
      const lat = parseFloat(row.querySelector('.input-lat')?.value);
      const lng = parseFloat(row.querySelector('.input-lng')?.value);

      if (!isNaN(lat) && !isNaN(lng) && lat !== 0) {
        const pos = { lat, lng };
        const marker = new google.maps.Marker({
          position: pos,
          map: map,
          label: (index + 1).toString()
        });
        markers.push(marker);
        path.push(pos);
        bounds.extend(pos);
      }
    });

    if (path.length > 1) {
      polyline = new google.maps.Polyline({
        path: path,
        strokeColor: '#0288d1',
        strokeWeight: 4,
        map: map
      });
    }
    if (path.length > 0) map.fitBounds(bounds);
  }

  function initAutocompletes() {
    document.querySelectorAll('.place-autocomplete').forEach(input => {
      if (input.dataset.bound) return;
      const autocomplete = new google.maps.places.Autocomplete(input, {
        componentRestrictions: { country: 'jp' },
        fields: ['name', 'formatted_address', 'geometry']
      });

      autocomplete.addListener('place_changed', () => {
        const place = autocomplete.getPlace();
        if (!place.geometry) return;

        const row = input.closest('.route-item-row');
        row.querySelector('.input-name').value = place.name;
        row.querySelector('.input-address').value = place.formatted_address;
        row.querySelector('.input-lat').value = place.geometry.location.lat();
        row.querySelector('.input-lng').value = place.geometry.location.lng();
        
        // Обновляем текст в UI
        const display = row.querySelector('.display-name');
        if (display) display.innerText = place.name;

        refreshMap();
      });
      input.dataset.bound = "true";
    });
  }

  function setupEventListeners() {
    const container = document.getElementById('route-items-container');
    const addBtn = document.getElementById('add-item-btn');
    const template = document.getElementById('route-item-template');

    if (addBtn && container && template) {
      // Чтобы не вешать событие несколько раз при переходах Turbolinks
      addBtn.onclick = (e) => {
        e.preventDefault();
        const newIndex = container.querySelectorAll('.route-item-row').length;
        let html = template.innerHTML
          .replace(/__INDEX__/g, newIndex)
          .replace(/__POSITION__/g, newIndex + 1);
        
        container.insertAdjacentHTML('beforeend', html);
        initAutocompletes();
      };

      container.onclick = (e) => {
        if (e.target.classList.contains('remove-item')) {
          e.target.closest('.route-item-row').remove();
          refreshMap();
        }
      };
    }

    // Загрузка самого API Google
    if (typeof google === 'undefined') {
      const script = document.createElement('script');
      // Добавляем loading=async как просит Google
      script.src = `https://maps.googleapis.com/maps/api/js?key=${API_KEY}&callback=initMap&libraries=places&language=ja&loading=async`;
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    } else {
      initMap();
    }
  }

  // Поддержка всех вариантов загрузки Rails
  document.addEventListener('DOMContentLoaded', setupEventListeners);
  document.addEventListener('turbolinks:load', setupEventListeners);
  document.addEventListener('turbo:load', setupEventListeners);
})();
</script>
  </body>
</html>
