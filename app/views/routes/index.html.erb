
<!DOCTYPE html>
<html>
<head>
  <title>人気ルート - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "pages", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "routes", "data-turbo-track": "reload" %>

  
</head>
<body>
  <%# Header %>
  <%= render 'pages/header' %>
  <%= render 'pages/hero_banner' %>

  <!-- Main Content -->
  <main class="main-content">
    <div class="section-header">
      <h2 class="section-title">
        <%= @routes.total_count %>件のルート
      </h2>
      
      <%= form_with url: routes_path, method: :get, local: true do |f| %>
        <%= f.hidden_field :q, value: params[:q] %>
        <%= f.hidden_field :difficulty, value: params[:difficulty] %>
        <%= f.hidden_field :duration, value: params[:duration] %>
        <%= f.hidden_field :cost, value: params[:cost] %>
        
        <%= f.select :sort,
            options_for_select([
              ['人気順', 'popular'],
              ['新着順', 'recent'],
              ['評価順', 'rating']
            ], params[:sort]),
            {},
            class: "sort-dropdown",
            onchange: "this.form.submit()" %>
      <% end %>
    </div>

    <!-- Routes List -->
    <div class="routes-list">
      <% @routes.each do |route| %>
        <div class="route-card" onclick="window.location='<%= route_path(route) %>'">
          <div class="route-header">
            <div>
              <h3 class="route-title"><%= route.name %></h3>
              <div class="route-author">
                by <%= route.user.username %> • 
                <%= route.created_at.strftime('%Y年%m月%d日') %>
              </div>
            </div>
            
            <div class="route-stats">
              <div class="route-stat">
                👁️ <%= route.view_count || 0 %>
              </div>
              <div class="route-stat">
                ❤️ <%= route.likes_count || 0 %>
              </div>
              <div class="route-stat">
                ⭐ <%= route.average_rating || 4.5 %>
              </div>
            </div>
          </div>

          <p class="route-description">
            <%= truncate(route.description, length: 200) %>
          </p>

          <div class="route-meta">
            <div class="route-meta-item">
              <span class="route-badge badge-<%= route.difficulty_level %>">
                <%= route.difficulty_level %>
              </span>
            </div>
            
            <div class="route-meta-item">
              ⏱️ <%= route.estimated_duration %>分
            </div>
            
            <div class="route-meta-item">
              💰 約¥<%= number_with_delimiter(route.estimated_cost) %>
            </div>
            
            <div class="route-meta-item">
              📍 <%= route.route_items.count %>箇所
            </div>
          </div>

          <div class="route-venues-preview">
            <% route.route_items.limit(4).each do |item| %>
              <span class="venue-preview-tag">
                <%= item.venue&.name || item.venue_name || "場所" %>
              </span>
            <% end %>
            <% if route.route_items.count > 4 %>
              <span class="venue-preview-tag">
                +<%= route.route_items.count - 4 %>
              </span>
            <% end %>
          </div>

          <div class="route-footer">
            <div class="route-actions">
              <button class="route-action-btn" onclick="event.stopPropagation()">
                いいね!
              </button>
              <button class="route-action-btn" onclick="event.stopPropagation()">
                保存
              </button>
              <button class="route-action-btn" onclick="event.stopPropagation()">
                共有
              </button>
            </div>
            
            <%= link_to "詳細を見る", route_path(route), class: "view-route-btn" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="pagination">
      <%= paginate @routes %>
    </div>
  </main>

  <!-- Footer -->
  <%= render 'layouts/footer' %>
</body>
</html>