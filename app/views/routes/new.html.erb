
<!DOCTYPE html>
<html>
<head>
  <title>ルート作成 - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'newRoute', media: 'all' %>
  <%= stylesheet_link_tag 'newRoute', media: 'all' %>
  
  <style>
    #create-map {
      width: 100%;
      height: 400px;
      border-radius: 8px;
      background: #e0e0e0;
    }
    
    .place-autocomplete-container {
      position: relative;
      margin-bottom: 15px;
    }
    
    .place-autocomplete {
      width: 100%;
      padding: 12px 40px 12px 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
      transition: border-color 0.3s;
      box-sizing: border-box;
    }
    
    .place-autocomplete:focus {
      outline: none;
      border-color: #0288d1;
      box-shadow: 0 0 0 3px rgba(2, 136, 209, 0.1);
    }
    
    .selected-place-info {
      background: #e8f5e9;
      border: 1px solid #4caf50;
      border-radius: 6px;
      padding: 10px;
      margin-top: 10px;
      display: none;
    }
    
    .selected-place-info.show {
      display: block;
    }
    
    .selected-place-name {
      font-weight: 600;
      color: #2e7d32;
      margin-bottom: 4px;
    }
    
    .selected-place-address {
      font-size: 13px;
      color: #558b2f;
    }
  </style>
</head>
<body>
  <%= render 'pages/header' %>
  <%= render 'pages/hero' %>

  <div class="create-container">
    <h1 class="page-title">ルート作成</h1>

    <%= form_with model: @route, local: true do |f| %>
      <!-- Route Information -->
      <div class="form-section">
        <h2 class="section-title">ルート詳細</h2>

        <div class="form-group">
          <%= f.label :name, "タイトル (必須)", class: "form-label required" %>
          <%= f.text_field :name, class: "form-input", placeholder: "例：京都の隠れ名所巡り", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :description, "説明 (任意)", class: "form-label" %>
          <%= f.text_area :description, class: "form-textarea", placeholder: "このルートの魅力や特徴を教えてください...", maxlength: 500 %>
          <div class="input-hint">最大500文字</div>
        </div>

        <div class="form-group">
          <%= f.label :city_id, "都市", class: "form-label required" %>
          <%= f.select :city_id, options_from_collection_for_select(@cities, :id, :name), 
              { prompt: "都市を選択してください" }, 
              class: "form-select", 
              required: true %>
        </div>

        <div class="form-group">
          <%= f.label :tags, "タグ", class: "form-label" %>
          <%= f.text_field :tags, class: "form-input", placeholder: "文化,歴史,グルメ (カンマ区切り)" %>
          <div class="input-hint">カンマで区切って複数のタグを入力できます</div>
        </div>
        
        <div class="form-group">
          <%= f.label :estimated_duration, "所要時間（分）", class: "form-label" %>
          <%= f.number_field :estimated_duration, class: "form-input", placeholder: "180", min: 0 %>
        </div>

        <div class="form-group">
          <%= f.label :estimated_cost, "予算（円）", class: "form-label" %>
          <%= f.number_field :estimated_cost, class: "form-input", placeholder: "5000", min: 0 %>
        </div>

        <div class="form-group">
          <%= f.label :difficulty_level, "難易度", class: "form-label" %>
          <%= f.select :difficulty_level, 
              [['簡単', 'easy'], ['普通', 'medium'], ['難しい', 'hard']], 
              { prompt: "選択してください" },
              class: "form-select" %>
        </div>
      </div>

      <!-- Spots Section with Google Maps -->
      <div class="form-section">
        <h2 class="section-title">📍 訪問場所を追加</h2>
        
        <div class="spots-list" id="spots-list">
          <!-- Spots will be added here -->
        </div>

        <button type="button" class="add-spot-btn" onclick="addSpot()">
          ➕ スポットを追加
        </button>
      </div>

      <!-- Map Preview -->
      <div class="form-section">
        <h2 class="section-title">マッププレビュー</h2>
        <div id="create-map"></div>
        <div style="margin-top: 10px; font-size: 13px; color: #666;">
          場所を追加すると、マップに自動的に表示されます
        </div>
      </div>

      <!-- Route Preview -->
      <div class="form-section">
        <h2 class="section-title">現在のルート一覧</h2>
        <div class="route-preview-list" id="route-preview">
          <p style="text-align: center; color: #999; padding: 20px;">
            まだスポットが追加されていません
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <%= link_to "キャンセル", routes_path, class: "btn btn-cancel" %>
        <%= f.submit "ルートを作成", class: "btn btn-submit" %>
      </div>
    <% end %>
  </div>

  <%= render 'pages/footer' %>

  <script>
    let spotCount = 0;
    let map;
    let markers = [];
    let directionsService;
    let directionsRenderer;
    const API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
    
    // Store places data
    const placesData = [];

    function initMap() {
      // Initialize map
      map = new google.maps.Map(document.getElementById('create-map'), {
        zoom: 13,
        center: { lat: 35.0116, lng: 135.7681 }, // Kyoto center
        mapTypeControl: true
      });

      directionsService = new google.maps.DirectionsService();
      directionsRenderer = new google.maps.DirectionsRenderer({
        map: map,
        suppressMarkers: true,
        polylineOptions: {
          strokeColor: '#0288d1',
          strokeWeight: 4
        }
      });

      console.log('Map initialized');
    }

    function addSpot() {
      spotCount++;
      const spotsContainer = document.getElementById('spots-list');
      
      const spotHtml = `
        <div class="spot-item" id="spot-${spotCount}" data-spot-id="${spotCount}">
          <div class="spot-number">${spotCount}</div>
          <button type="button" class="remove-spot" onclick="removeSpot(${spotCount})">×</button>
          
          <div class="place-autocomplete-container">
            <input type="text" 
                   class="place-autocomplete" 
                   id="place-search-${spotCount}"
                   placeholder="🔍 Google Mapsで場所を検索..." />
            <span class="search-icon">🔍</span>
            
            <div class="selected-place-info" id="place-info-${spotCount}">
              <div class="selected-place-name" id="place-name-${spotCount}"></div>
              <div class="selected-place-address" id="place-address-${spotCount}"></div>
            </div>
          </div>

          <input type="hidden" name="route_items[][venue_name]" id="venue-name-${spotCount}">
          <input type="hidden" name="route_items[][venue_address]" id="venue-address-${spotCount}">
          <input type="hidden" name="route_items[][venue_lat]" id="venue-lat-${spotCount}">
          <input type="hidden" name="route_items[][venue_lng]" id="venue-lng-${spotCount}">
          
          <input type="number" 
                 name="route_items[][duration_minutes]" 
                 class="spot-duration" 
                 placeholder="滞在時間（分）" 
                 min="0" 
                 value="60"
                 onchange="updatePreview()">
        </div>
      `;

      spotsContainer.insertAdjacentHTML('beforeend', spotHtml);
      
      // Initialize autocomplete for new spot
      setTimeout(() => initAutocomplete(spotCount), 100);
      
      updatePreview();
    }

    function initAutocomplete(spotId) {
      const input = document.getElementById(`place-search-${spotId}`);
      
      const autocomplete = new google.maps.places.Autocomplete(input, {
        componentRestrictions: { country: 'jp' },
        fields: ['name', 'formatted_address', 'geometry', 'place_id'],
        types: ['establishment', 'geocode']
      });

      autocomplete.addListener('place_changed', function() {
        const place = autocomplete.getPlace();
        
        if (!place.geometry) {
          alert('場所の詳細が見つかりませんでした。');
          return;
        }

        // Store place data
        const lat = place.geometry.location.lat();
        const lng = place.geometry.location.lng();
        
        document.getElementById(`venue-name-${spotId}`).value = place.name || '';
        document.getElementById(`venue-address-${spotId}`).value = place.formatted_address || '';
        document.getElementById(`venue-lat-${spotId}`).value = lat;
        document.getElementById(`venue-lng-${spotId}`).value = lng;

        // Show selected place info
        document.getElementById(`place-name-${spotId}`).textContent = place.name || '';
        document.getElementById(`place-address-${spotId}`).textContent = place.formatted_address || '';
        document.getElementById(`place-info-${spotId}`).classList.add('show');

        // Update places data array
        const existingIndex = placesData.findIndex(p => p.spotId === spotId);
        const placeData = {
          spotId: spotId,
          name: place.name,
          address: place.formatted_address,
          lat: lat,
          lng: lng
        };
        
        if (existingIndex >= 0) {
          placesData[existingIndex] = placeData;
        } else {
          placesData.push(placeData);
        }

        updateMap();
        updatePreview();
      });
    }

    function removeSpot(id) {
      const spot = document.getElementById(`spot-${id}`);
      if (spot) {
        spot.remove();
        
        // Remove from places data
        const index = placesData.findIndex(p => p.spotId === id);
        if (index >= 0) {
          placesData.splice(index, 1);
        }
        
        renumberSpots();
        updateMap();
        updatePreview();
      }
    }

    function renumberSpots() {
      const spots = document.querySelectorAll('.spot-item');
      spots.forEach((spot, index) => {
        const number = spot.querySelector('.spot-number');
        if (number) {
          number.textContent = index + 1;
        }
      });
    }

    function updateMap() {
      // Clear existing markers
      markers.forEach(marker => marker.setMap(null));
      markers = [];

      if (placesData.length === 0) {
        return;
      }

      // Add markers
      const bounds = new google.maps.LatLngBounds();
      
      placesData.forEach((place, index) => {
        const position = { lat: place.lat, lng: place.lng };
        
        const marker = new google.maps.Marker({
          position: position,
          map: map,
          label: {
            text: String(index + 1),
            color: 'white',
            fontSize: '14px',
            fontWeight: 'bold'
          },
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            fillColor: '#0288d1',
            fillOpacity: 1,
            strokeColor: 'white',
            strokeWeight: 3,
            scale: 20
          }
        });

        const infoWindow = new google.maps.InfoWindow({
          content: `<div style="padding: 10px;"><h4 style="margin: 0 0 5px 0;">${place.name}</h4><p style="margin: 0; color: #666; font-size: 13px;">${place.address}</p></div>`
        });

        marker.addListener('click', () => infoWindow.open(map, marker));
        
        markers.push(marker);
        bounds.extend(position);
      });

      map.fitBounds(bounds);

      // Draw route if more than 1 place
      if (placesData.length > 1) {
        drawRoute();
      }
    }

    function drawRoute() {
      if (placesData.length < 2) return;

      const waypoints = placesData.slice(1, -1).map(place => ({
        location: { lat: place.lat, lng: place.lng },
        stopover: true
      }));

      const request = {
        origin: { lat: placesData[0].lat, lng: placesData[0].lng },
        destination: { lat: placesData[placesData.length - 1].lat, lng: placesData[placesData.length - 1].lng },
        waypoints: waypoints,
        travelMode: google.maps.TravelMode.WALKING
      };

      directionsService.route(request, (result, status) => {
        if (status === 'OK') {
          directionsRenderer.setDirections(result);
        }
      });
    }

    function updatePreview() {
      const preview = document.getElementById('route-preview');
      const spots = document.querySelectorAll('.spot-item');

      if (spots.length === 0) {
        preview.innerHTML = '<p style="text-align: center; color: #999; padding: 20px;">まだスポットが追加されていません</p>';
        return;
      }

      let html = '';
      spots.forEach((spot, index) => {
        const spotId = spot.dataset.spotId;
        const name = document.getElementById(`venue-name-${spotId}`)?.value || '未選択';
        const duration = spot.querySelector('input[type="number"]')?.value || '0';

        html += `
          <div class="preview-item">
            <div class="preview-number">${index + 1}</div>
            <div class="preview-info">
              <div class="preview-name">${name}</div>
              <div class="preview-duration">⏱️ ${duration}分</div>
            </div>
            <button type="button" class="preview-delete" onclick="removeSpot(${spotId})">×</button>
          </div>
        `;
      });

      preview.innerHTML = html;
    }

    // Load Google Maps
    function loadGoogleMaps() {
      if (!API_KEY) {
        console.error('Google Maps API key not set');
        return;
      }

      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${API_KEY}&callback=initMap&libraries=places&language=ja`;
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    document.addEventListener('DOMContentLoaded', function() {
      loadGoogleMaps();
      addSpot(); // Add first spot
    });
  </script>
</body>
</html>
