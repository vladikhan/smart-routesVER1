<%= stylesheet_link_tag 'dmRooms', media: 'all' %>
<%= render 'pages/header'%>

<div class="dm-chat-container">
  <!-- Left Sidebar: Room List -->
  <div class="dm-chat-sidebar" id="chatSidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header">
      <h4>メッセージ</h4>
      <%= link_to sent_dm_rooms_path, class: "btn btn-sm btn-outline-light" do %>
        <i class="fas fa-paper-plane"></i> 送信済み
      <% end %>
    </div>
    
    <!-- Chat Search -->
    <div class="chat-search">
      <input type="text" placeholder="チャットを検索..." id="chatSearchInput" class="search-input">
    </div>
    
    <!-- Rooms List -->
    <div class="list-group list-group-flush">
      <% if @dm_rooms.any? %>
        <% @dm_rooms.each do |room| %>
          <% other = room.other_user(current_user) %>
          <%= link_to dm_room_path(room), 
              class: "list-group-item chat-list-item #{room == @active_room ? 'active' : ''}", 
              data: { room_id: room.id } do %>
            
            <div class="chat-content">
              <div class="chat-avatar-wrapper">
                <% if other.image_url.present? %>
                  <%= image_tag other.image_url, class: "chat-avatar", alt: other.username %>
                <% else %>
                  <div class="chat-avatar" style="background: linear-gradient(135deg, #5ab2f7, #12cff3 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;">
                    <%= other.username[0].upcase %>
                  </div>
                <% end %>
                
                <% if other.respond_to?(:online?) && other.online? %>
                  <span class="online-indicator"></span>
                <% end %>
              </div>
              
              <div class="chat-info">
                <div class="chat-header">
                  <span class="chat-name"><%= other.username %></span>
                  <span class="chat-time">
                    <% if room.last_message %>
                      <%= time_ago_in_words(room.last_message.created_at) %>前
                    <% end %>
                  </span>
                </div>
                
                <div class="chat-preview">
                  <span class="last-message">
                    <% if room.last_message %>
                      <%= truncate(room.last_message.message, length: 40) %>
                    <% else %>
                      <span class="text-muted">メッセージがありません</span>
                    <% end %>
                  </span>
                  
                  <% if room.any_unread_for?(current_user) %>
                    <span class="unread-badge"><%= room.unread_count_for(current_user) %></span>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="empty-state">
          <div class="empty-icon"><i class="fas fa-comments"></i></div>
          <h3>メッセージがありません</h3>
          <p>新しい会話を始めましょう！</p>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Right Panel: Chat Messages -->
  <div class="dm-chat-main">
    <% if @active_room %>
      <% other = @active_room.other_user(current_user) %>
      
      <!-- Chat Header -->
      <div class="dm-chat-header">
        <div class="header-content">
          <div class="user-info">
            <div class="chat-avatar-wrapper">
              <% if other.image_url.present? %>
                <%= image_tag other.image_url, class: "user-avatar", alt: other.username %>
              <% else %>
                <div class="user-avatar" style="background: linear-gradient(135deg, #5ab2f7, #12cff3 100%); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;">
                  <%= other.username[0].upcase %>
                </div>
              <% end %>
            </div>
            
            <div class="user-details">
              <h5 class="user-name"><%= other.username %></h5>
              <span class="user-status">
                <% if other.respond_to?(:online?) && other.online? %>
                  オンライン
                <% else %>
                  オフライン
                <% end %>
              </span>
            </div>
          </div>
          
          <div class="header-actions">
            <%= link_to user_path(other), class: "btn-icon", title: "プロフィールを見る" do %>
              <i class="fas fa-user"></i>
            <% end %>
            <button class="btn-icon" title="その他">
              <i class="fas fa-ellipsis-v"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Messages Container -->
      <div class="dm-messages-area" id="messages-area">
        <div id="messages-container">
          <% if @messages.any? %>
            <% group_messages_by_date(@messages).each do |date, messages| %>
              <div class="date-divider">
                <span><%= format_message_date(date) %></span>
              </div>
              
              <% messages.each do |message| %>
                <%= render partial: 'dm_messages/message', 
                          locals: { message: message, current_user: current_user } %>
              <% end %>
            <% end %>
          <% else %>
            <div class="empty-state">
              <div class="empty-icon"><i class="fas fa-comment-dots"></i></div>
              <h3>会話を始めましょう！</h3>
              <p>最初のメッセージを送信してください</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Message Input Form -->
      <div class="dm-input-area">
        <div class="typing-indicator" id="typing-indicator" style="display: none;">
          <div class="typing-dots">
            <span></span><span></span><span></span>
          </div>
          <span><%= other.username %>が入力中...</span>
        </div>
        
        <%= form_with url: dm_room_dm_messages_path(@active_room), 
                      method: :post,
                      local: false,
                      id: "new-message-form",
                      class: "message-form" do |f| %>
          
          <div class="input-wrapper">
            <button type="button" class="attachment-btn" title="ファイルを添付">
              <i class="fas fa-paperclip"></i>
            </button>
            
            <div class="input-container">
  <%= f.text_area :text, 
                 rows: 1,
                 class: "message-textarea",
                 placeholder: "メッセージを入力...",
                 id: "message-content-input",
                 autocomplete: "off",
                 maxlength: 5000 %>
  
  <button type="button" class="emoji-btn" title="絵文字">😊</button>
</div>

<%# Заменяем f.submit на f.button, чтобы вставить иконку внутрь %>
<%= f.button :submit, class: "send-btn", id: "send-message-btn" do %>
  <%= image_tag "send-icon.svg", class: "notification-svg-icon", alt: "Send" %>
<% end %>
        <% end %>
      </div>

    <% else %>
      <div class="empty-state" style="height: 100vh;">
        <div class="empty-icon"><i class="fas fa-comments"></i></div>
        <h3>チャットを選択してください</h3>
        <p>左側から会話を選んでメッセージを始めましょう</p>
      </div>
    <% end %>
  </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-scroll to bottom
  const messagesArea = document.querySelector('.dm-messages-area');
  if (messagesArea) {
    messagesArea.scrollTop = messagesArea.scrollHeight;
  }

  // Auto-resize textarea
  const textarea = document.getElementById('message-content-input');
  if (textarea) {
    textarea.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // Enter to send (Shift+Enter for new line)
    textarea.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        document.getElementById('send-message-btn').click();
      }
    });
  }

  // Mark as read
  if (messagesArea) {
    const roomId = document.querySelector('.chat-list-item.active')?.dataset.roomId;
    if (roomId) {
      fetch(`/dm_rooms/${roomId}/mark_all_as_read`, {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      }).then(response => {
        if (response.ok) {
          const badge = document.querySelector('.chat-list-item.active .unread-badge');
          if (badge) badge.remove();
        }
      });
    }
  }


  // Search
  const searchInput = document.getElementById('chatSearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const term = this.value.toLowerCase();
      document.querySelectorAll('.chat-list-item').forEach(item => {
        const name = item.querySelector('.chat-name').textContent.toLowerCase();
        const msg = item.querySelector('.last-message').textContent.toLowerCase();
        item.style.display = (name.includes(term) || msg.includes(term)) ? '' : 'none';
      });
    });
  }

  // Auto-scroll on new message
  const observer = new MutationObserver(() => {
    if (messagesArea) messagesArea.scrollTop = messagesArea.scrollHeight;
  });

  const container = document.getElementById('messages-container');
  if (container) {
    observer.observe(container, { childList: true, subtree: true });
  }

  // Clear textarea after send
  const form = document.getElementById('new-message-form');
  if (form && textarea) {
    form.addEventListener('ajax:success', () => {
      textarea.value = '';
      textarea.style.height = 'auto';
    });
    
    const sendBtn = document.getElementById('send-message-btn');
    textarea.addEventListener('input', () => {
      if (sendBtn) sendBtn.disabled = textarea.value.trim().length === 0;
    });
  }
});
</script>