<%= stylesheet_link_tag 'dmRooms', media: 'all' %>
<%= render 'pages/header'%>

<div class="dm-chat-container">
  <div class="dm-chat-sidebar" id="chatSidebar">
    <div class="sidebar-header">
      <div class="header-title">
        <i class="fas fa-comments"></i>
        <h4>メッセージ</h4>
      </div>
      
    </div>

    <div class="chat-search">
      <div class="search-wrapper">
        <i class="fas fa-search search-icon"></i>
        <input type="text" placeholder="ユーザーやメッセージを検索..." id="chatSearchInput" class="search-input">
        <button class="clear-search" id="clearSearch" style="display: none;">
          <i class="fas fa-times"></i>
        </button>
      </div>
    </div>

    <div class="chat-filter-tabs">
      <button class="filter-tab active" data-filter="all">
        <i class="fas fa-inbox"></i> すべて
      </button>
      <button class="filter-tab" data-filter="unread">
        <i class="fas fa-circle"></i> 未読
      </button>
    </div>

    <div class="rooms-list-container">
  <% if @dm_rooms.any? %>
    <% @dm_rooms.each do |room| %>
      <% other = room.other_user(current_user) %>
      <% is_unread = room.any_unread_for?(current_user) %>
      
      <div class="chat-list-item-wrapper <%= room == @active_room ? 'active' : '' %> <%= is_unread ? 'unread' : '' %>" 
           data-room-id="<%= room.id %>" 
           data-filter="<%= is_unread ? 'unread' : 'all' %>">
        
        <%= link_to user_path(other), class: "chat-avatar-link" do %>
  <div class="chat-avatar-wrapper">
    <% if other.avatar.present? %>
      <%# Для CarrierWave обязательно добавляем .url %>
      <%= image_tag other.avatar.url, class: "chat-avatar", alt: other.username %>
    <% elsif other.image_url.present? %>
      <%# Это твои ссылки из консоли или плейсхолдеры %>
      <%= image_tag other.image_url, class: "chat-avatar", alt: other.username %>
    <% else %>
      <%# Заглушка с первой буквой %>
      <div class="chat-avatar chat-avatar-placeholder">
        <%= other.username[0].upcase if other.username.present? %>
      </div>
    <% end %>

    <% if other.respond_to?(:online?) && other.online? %>
      <span class="online-indicator"></span>
    <% end %>
  </div>
<% end %>

        <%= link_to dm_room_path(room), class: "chat-info-clickable-area" do %>
          <div class="chat-info">
            <div class="chat-header">
              <span class="chat-name"><%= other.username %></span>
              <span class="chat-time">
                <% if room.last_message %>
                  <%= time_ago_in_words(room.last_message.created_at) %>前
                <% end %>
              </span>
            </div>
            <div class="chat-preview">
              <span class="last-message">
                <% if room.last_message %>
                  <% if room.last_message.user == current_user %>
                    <i class="fas fa-check-double <%= room.last_message.is_read? ? 'read' : '' %>"></i>
                  <% end %>
                  <%= truncate(room.last_message.message, length: 45) %>
                <% else %>
                  <span class="text-muted">メッセージなし</span>
                <% end %>
              </span>
              <% if is_unread %>
                <span class="unread-badge"><%= room.unread_count_for(current_user) %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state-sidebar"><h3>メッセージなし</h3></div>
  <% end %>
</div>
  </div>
  

  <div class="dm-chat-main">
    <% if @active_room %>
      <% other = @active_room.other_user(current_user) %>
      <div class="dm-chat-header">
        <div class="header-user-info">

          <%= link_to user_path(other), class: "chat-avatar-link" do %>
  <div class="chat-avatar-wrapper">
    <% if other.avatar.present? %>
      <%# Для CarrierWave обязательно добавляем .url %>
      <%= image_tag other.avatar.url, class: "chat-avatar", alt: other.username %>
    <% elsif other.image_url.present? %>
      
      <%= image_tag other.image_url, class: "chat-avatar",  alt: other.username %>
    <% else %>
      <%# Заглушка с первой буквой %>
      <div class="chat-avatar chat-avatar-placeholder">
        <%= other.username[0].upcase if other.username.present? %>
      </div>
    <% end %>

    <% if other.respond_to?(:online?) && other.online? %>
      <span class="online-indicator"></span>
    <% end %>
  </div>
<% end %>
<%# !!!!!!!! %>

          <h5 class="user-name"><%= other.username %></h5>
        </div>
      </div>

      <div class="dm-messages-area" id="messages-area">
        <div id="messages-container">
          <% if @messages.any? %>
            <% group_messages_by_date(@messages).each do |date, messages| %>
              <div class="date-divider"><span><%= format_message_date(date) %></span></div>
              <% messages.each do |message| %>
                <div class="message-wrapper <%= message.user == current_user ? 'message-sent' : 'message-received' %>">
                  <div class="message-bubble">
                    <div class="message-text">
                      
                      <%= simple_format(message.message) %>
                    </div>
                    <div class="message-meta">
                      <span class="message-time"><%= message.created_at.strftime('%H:%M') %></span>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Message Input Form -->
      <div class="dm-input-area">
        <div class="typing-indicator" id="typing-indicator" style="display: none;">
          <div class="typing-dots">
            <span></span><span></span><span></span>
          </div>
          <span><%= other.username %>が入力中...</span>
        </div>
        
        <%= form_with url: dm_room_dm_messages_path(@active_room), 
                      method: :post,
                      local: false,
                      id: "new-message-form",
                      class: "message-form" do |f| %>
          
          <div class="input-wrapper">
            <%# <button type="button" class="attachment-btn" title="ファイルを添付">
              <i class="fas fa-paperclip"></i>
            </button> %>
            
            <div class="input-container">
  <%= f.text_area :text, 
                 rows: 1,
                 class: "message-textarea",
                 placeholder: "メッセージを入力...",
                 id: "message-content-input",
                 autocomplete: "off",
                 maxlength: 5000 %>
  
  <button type="button" data-emoji-target="btn" class="emoji-btn">😊</button>
</div>

<%# Заменяем f.submit на f.button, чтобы вставить иконку внутрь %>
<%= f.button :submit, class: "send-btn", id: "send-message-btn" do %>
  <%= image_tag "send-icon.svg", class: "notification-svg-icon", alt: "Send" %>
<% end %>
        <% end %>
      </div>

    <% else %>
      <div class="empty-state" style="height: 100vh;">
        <div class="empty-icon"><i class="fas fa-comments"></i></div>
        <h3>チャットを選択してください</h3>
        <p>左側から会話を選んでメッセージを始めましょう</p>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-scroll to bottom
  const messagesArea = document.querySelector('.dm-messages-area');
  if (messagesArea) {
    messagesArea.scrollTop = messagesArea.scrollHeight;
  }

  // Auto-resize textarea
  const textarea = document.getElementById('message-content-input');
  if (textarea) {
    textarea.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // Enter to send (Shift+Enter for new line)
    textarea.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        document.getElementById('send-message-btn').click();
      }
    });
  }

  // Mark as read
  if (messagesArea) {
    const roomId = document.querySelector('.chat-list-item.active')?.dataset.roomId;
    if (roomId) {
      fetch(`/dm_rooms/${roomId}/mark_all_as_read`, {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      }).then(response => {
        if (response.ok) {
          const badge = document.querySelector('.chat-list-item.active .unread-badge');
          if (badge) badge.remove();
        }
      });
    }
  }


  // Search
  const searchInput = document.getElementById('chatSearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const term = this.value.toLowerCase();
      document.querySelectorAll('.chat-list-item').forEach(item => {
        const name = item.querySelector('.chat-name').textContent.toLowerCase();
        const msg = item.querySelector('.last-message').textContent.toLowerCase();
        item.style.display = (name.includes(term) || msg.includes(term)) ? '' : 'none';
      });
    });
  }

  // Auto-scroll on new message
  const observer = new MutationObserver(() => {
    if (messagesArea) messagesArea.scrollTop = messagesArea.scrollHeight;
  });

  const container = document.getElementById('messages-container');
  if (container) {
    observer.observe(container, { childList: true, subtree: true });
  }

  // Clear textarea after send
  const form = document.getElementById('new-message-form');
  if (form && textarea) {
    form.addEventListener('ajax:success', () => {
      textarea.value = '';
      textarea.style.height = 'auto';
    });
    
    const sendBtn = document.getElementById('send-message-btn');
    textarea.addEventListener('input', () => {
      if (sendBtn) sendBtn.disabled = textarea.value.trim().length === 0;
    });
  }
});

// Emoji

function initEmojiPicker() {
    const btn = document.querySelector('.emoji-btn');
    const textarea = document.querySelector('#message-content-input');

    if (!btn || !textarea) return;

    // Проверяем, не инициализирован ли уже пикер, чтобы не дублировать
    if (btn.dataset.initialized) return;

    // Создаем контейнер для пикера (он будет всплывающим)
    const pickerContainer = document.createElement('div');
    pickerContainer.style.position = 'absolute';
    pickerContainer.style.zIndex = '10000';
    pickerContainer.style.display = 'none';
    document.body.appendChild(pickerContainer);

    // Инициализация Picmo (библиотека будет доступна как picmo)
    const picker = picmo.createPicker({
  rootElement: pickerContainer,
  theme: 'dark',
  emojiSize: '1.2rem', // Еще меньше
  perLine: 7,          // 7 штук в ряд сделают окно компактным
  showPreview: false,  // Отключаем нижнюю панель просмотра (экономим место)
  height: '350px'
});

    // Когда выбрали эмодзи
    picker.addEventListener('emoji:select', event => {
      const emoji = event.emoji;
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      textarea.setRangeText(emoji, start, end, 'end');
      textarea.focus();
      pickerContainer.style.display = 'none'; // Скрываем после выбора
    });

    // Логика кнопки
    btn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const rect = btn.getBoundingClientRect();
      const pickerWidth = 250; // Твоя ширина
      const pickerHeight = 280; //Твоя высота
      
      // 1. Позиция по вертикали (TOP)
      // Берем верхнюю точку кнопки (rect.top) + текущий скролл страницы
      // И вычитаем высоту пикера и небольшой зазор (8px)
      const topPosition = window.scrollY + rect.top - pickerHeight - 8;
      
      // 2. Позиция по горизонтали (LEFT)
      let leftPosition = window.scrollX + rect.left;
      
      // Проверка правого края (чтобы не улетало за экран)
      if (rect.left + pickerWidth > window.innerWidth) {
        leftPosition = window.scrollX + rect.right - pickerWidth;
      }
      
      // Применяем стили
      pickerContainer.style.top = `${topPosition}px`;
      pickerContainer.style.left = `${leftPosition}px`;
      
      // Переключаем видимость
      pickerContainer.style.display = pickerContainer.style.display === 'none' ? 'block' : 'none';
    };
    

    btn.dataset.initialized = "true";
    console.log("Picmo Emoji Picker готов!");
  }

  document.addEventListener("turbo:load", initEmojiPicker);
  document.addEventListener("DOMContentLoaded", initEmojiPicker);

</script>

