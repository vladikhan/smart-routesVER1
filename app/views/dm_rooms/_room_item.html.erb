<div class="list-group-item chat-list-item <%= 'active' if room == @active_room %>">
	<div class="chat-content">
		<div class="chat-avatar-wrapper">
			<%= image_tag room.other_user(current_user).avatar_url, class: 'chat-avatar' %>
			<% if room.other_user(current_user).online? %>
			<span class="online-indicator"></span>
			<% end %>
		</div>
		<div class="chat-info">
			<div class="chat-header">
				<span class='chat-name'><%= room.other_user(current_user).name %></span>
				<span class='chat-time'><%= time_ago_in_words(room.last_message_at) %></span>
			</div>
			<div class="chat-preview">
				<span class='last-message'><%= truncate(room.last_message&.message, length: 40) %></span>
				<% if room.unread_count_for(current_user) > 0 %>
					<span class='unread-badge'><%= room.unread_count_for(current_user) %></span>
					<% end %>
			</div>
		</div>
	</div>
</div>