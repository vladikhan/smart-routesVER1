<% other_user = dm_room.other_user(current_user) %>

<!-- ========== ШАПКА ЧАТА ========== -->
<div class="dm-chat-header d-flex align-items-center">
  <div class="d-flex align-items-center flex-grow-1">
    <% if other_user.avatar.attached? %>
      <%= image_tag other_user.avatar, class: 'chat-avatar me-3', alt: other_user.username %>
    <% else %>
      <%= image_tag "https://ui-avatars.com/api/?name=#{other_user.username}&size=48&background=random", 
                   class: 'chat-avatar me-3', 
                   alt: other_user.username %>
    <% end %>
    
    <div>
      <h6 class="mb-0 fw-bold">@<%= other_user.username %></h6>
      <small class="text-muted">
        <% if other_user.respond_to?(:online?) && other_user.online? %>
          <span class="text-success">● オンライン</span>
        <% else %>
          オフライン
        <% end %>
      </small>
    </div>
  </div>
  
  <!-- Кнопка назад (для мобильных) -->
  <button class="btn btn-link d-md-none" onclick="history.back()">
    <i class="bi bi-arrow-left fs-4"></i>
  </button>
</div>

<!-- ========== ОБЛАСТЬ СООБЩЕНИЙ ========== -->
<div class="dm-messages-area flex-grow-1" 
     id="messages-container"
     data-controller="chat"
     data-chat-room-id-value="<%= dm_room.id %>"
     data-chat-current-user-id-value="<%= current_user.id %>">
  
  <% if messages.any? %>
    <% messages.group_by { |m| m.created_at.to_date }.each do |date, msgs| %>
      <!-- Разделитель по датам -->
      <div class="text-center my-3">
        <span class="badge bg-light text-muted">
          <% if date == Date.today %>
            今日
          <% elsif date == Date.yesterday %>
            昨日
          <% else %>
            <%= l(date, format: :long) %>
          <% end %>
        </span>
      </div>
      
      <!-- Сообщения -->
      <% msgs.each do |message| %>
        <%= render 'dm_messages/dm_message', dm_message: message, current_user: current_user %>
      <% end %>
    <% end %>
  <% else %>
    <div class="text-center text-muted mt-5">
      <i class="bi bi-chat-text" style="font-size: 3rem; opacity: 0.3;"></i>
      <p class="mt-3">メッセージを送信して会話を始めましょう</p>
    </div>
  <% end %>
  
  <!-- Якорь для автоскролла -->
  <div id="messages-end"></div>
</div>

<!-- ========== ФОРМА ВВОДА ========== -->
<div class="dm-input-area">
  <%= form_with model: [dm_room, DmMessage.new], 
                html: { 
                  class: 'd-flex align-items-center gap-2',
                  data: { 
                    controller: 'chat-form',
                    action: 'submit->chat-form#send'
                  } 
                },
                local: false do |f| %>
    
    <!-- Кнопка прикрепления файла -->
    <label class="btn btn-link text-secondary p-2 m-0" style="cursor: pointer;" title="画像を添付">
      <i class="bi bi-paperclip fs-5"></i>
      <%= f.file_field :image, 
                       class: 'd-none', 
                       accept: 'image/*',
                       data: { action: 'change->chat-form#handleImage' } %>
    </label>
    
    <!-- Превью изображения -->
    <div id="image-preview" class="me-2" style="display: none;">
      <div class="position-relative">
        <img id="preview-img" class="rounded" style="max-height: 60px;">
        <button type="button" 
                class="btn-close btn-sm position-absolute top-0 end-0 bg-white" 
                style="font-size: 10px; padding: 4px;"
                data-action="click->chat-form#removeImage"></button>
      </div>
    </div>
    
    <!-- Поле ввода -->
    <%= f.text_area :message, 
                    rows: 1,
                    class: 'form-control flex-grow-1', 
                    placeholder: 'メッセージを入力...',
                    style: 'resize: none; max-height: 120px;',
                    data: { 
                      chat_form_target: 'input',
                      action: 'keydown.enter->chat-form#submitOnEnter input->chat-form#autoResize'
                    } %>
    
    <!-- Кнопка эмодзи (опционально) -->
    <button type="button" class="btn btn-link text-secondary p-2" title="絵文字">
      <i class="bi bi-emoji-smile fs-5"></i>
    </button>
    
    <!-- Кнопка отправки -->
    <%= f.submit '送信', 
                 class: 'btn btn-primary',
                 data: { chat_form_target: 'submit' } %>
  <% end %>
</div>