<% other_user = dm_room.other_user(current_user) %>

<!-- Шапка чата -->
<div class="border-bottom bg-white p-3 d-flex align-items-center">
  <%= image_tag other_user.avatar_url || 'default_avatar.png', 
               class: 'rounded-circle me-3', 
               size: '40x40' %>
  <div>
    <h6 class="mb-0">@<%= other_user.username %></h6>
    <small class="text-muted">
      <% if other_user.online? %>
        オンライン
      <% else %>
        オフライン
      <% end %>
    </small>
  </div>
</div>

<!-- Область сообщений -->
<div class="flex-grow-1 p-3" 
     style="overflow-y: auto; background: linear-gradient(to bottom, #e3f2fd 0%, #f5f5f5 100%);"
     id="messages-container"
     data-controller="chat"
     data-chat-room-id-value="<%= dm_room.id %>"
     data-chat-current-user-id-value="<%= current_user.id %>">
  
  <%= render messages %>
  
  <!-- Якорь для автоскролла -->
  <div id="messages-end"></div>
</div>

<!-- Форма ввода -->
<div class="bg-white border-top p-3">
  <%= form_with model: [dm_room, DmMessage.new], 
                html: { 
                  class: 'd-flex align-items-center',
                  data: { 
                    controller: 'chat-form',
                    action: 'submit->chat-form#send'
                  } 
                },
                local: false do |f| %>
    
    <!-- Кнопка прикрепления файла -->
    <label class="btn btn-link text-secondary me-2 mb-0" style="cursor: pointer;">
      <i class="bi bi-paperclip fs-5"></i>
      <%= f.file_field :image, 
                       class: 'd-none', 
                       accept: 'image/*',
                       data: { action: 'change->chat-form#handleImage' } %>
    </label>
    
    <!-- Превью изображения -->
    <div id="image-preview" class="me-2" style="display: none;">
      <img id="preview-img" class="rounded" style="max-height: 50px;">
      <button type="button" class="btn-close btn-sm" data-action="click->chat-form#removeImage"></button>
    </div>
    
    <!-- Поле ввода -->
    <%= f.text_area :message, 
                    rows: 1,
                    class: 'form-control me-2', 
                    placeholder: 'メッセージ...',
                    data: { 
                      chat_form_target: 'input',
                      action: 'keydown.enter->chat-form#submitOnEnter'
                    } %>
    
    <!-- Кнопка эмодзи (опционально) -->
    <button type="button" class="btn btn-link text-secondary me-2">
      <i class="bi bi-emoji-smile fs-5"></i>
    </button>
    
    <!-- Кнопка отправки -->
    <%= f.submit '送信', 
                 class: 'btn btn-primary',
                 data: { chat_form_target: 'submit' } %>
  <% end %>
</div>