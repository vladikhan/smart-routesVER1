<div class="dm-chat-header">
  <div class="header-content">
    <% if @other_user %>
      <div class="user-info">
        <%= image_tag @other_user.avatar_url || 'default-avatar.png', class: 'user-avatar' %>
        
        <div class="user-details">
          <h5 class="user-name"><%= @other_user.username %></h5>
          <span class="user-status">
            <% if @other_user.online? %>
              <span class="status-online">Online</span>
            <% elsif @other_user.last_seen_at.present? %>
              was <%= time_ago_in_words(@other_user.last_seen_at) %> ago
            <% else %>
              Offline
            <% end %>
          </span>
        </div>
      </div>
    <% else %>
      <div class="user-info">
        <span class="user-name">Unknown User</span>
      </div>
    <% end %>
    
    <%# Кнопки действий оставляем как есть %>
    <div class="header-actions">...</div>
  </div>
</div>