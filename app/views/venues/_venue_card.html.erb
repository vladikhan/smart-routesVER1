<%= link_to venue_path(venue), class: "route-card" do %>

  <div class="venue-card-image">
  <% if venue.city.present? %>
    <span class="city-badge"><%= venue.city.name %></span>
  <% end %>
  
  <%# Мы убираем вывод image_tag, чтобы всегда был виден твой фиолетовый градиент %>
  <%# Если когда-нибудь захочешь вернуть фото, просто разкомментируй код ниже %>
  <% if false %>
    <% if venue.photos.attached? %>
      <%= image_tag venue.photos.first, class: 'w-100 h-100', style: 'object-fit: cover;' %>
    <% else %>
      <div class="placeholder-icon">🏙️</div>
    <% end %>
  <% end %>
</div>

  <div class="route-card-content">
    <h3 class="route-card-title"><%= venue.name %></h3>
    
    <p class="route-card-desc">
      <%= truncate(venue.description, length: 60) if venue.description.present? %>
    </p>

    <div class="route-card-meta">
      <% if venue.venue_type.present? %>
        <span>🏷️ <%= venue.venue_type %></span>
      <% end %>
      <span>📍 <%= venue.city&.name %></span>
    </div>

    <div class="route-card-stats">
      <span>👁️ <%= venue.view_count || 0 %></span>
      <span>❤️ <%= venue.likes_count if venue.respond_to?(:likes_count) %></span>
    </div>
  </div>
<% end %>