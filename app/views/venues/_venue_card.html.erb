<div class="card h-100 shadow-sm venue-card">
  <%# Фото заведения %>
  <div class="venue-card-image" style="height: 200px; overflow: hidden;">
    <% if venue.photos.attached? %>
      <%=
        image_tag venue.photos.first,
                  class: 'card-img-top w-100 h-100',
                  style: 'object-fit: cover;'
      %>
    <% else %>
      <div
        class="bg-light d-flex align-items-center justify-content-center h-100"
      >
        <i class="fas fa-store fa-3x text-secondary"></i>
      </div>
    <% end %>
  </div>

  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start">
      <h5 class="card-title text-truncate mb-1">
        <%=
          link_to venue.name,
                  venue_path(venue),
                  class: 'text-decoration-none text-dark fw-bold'
        %>
      </h5>
    </div>

    <%# Город и категория %>
    <p class="card-text small text-muted mb-2">
      <i class="fas fa-map-marker-alt"></i> <%=
        venue.city&.name || 'Unknown City'
      %>
      <% if venue.venue_type.present? %>
        <span class="ms-2 badge bg-info text-dark fw-normal"><%=
            venue.venue_type
          %></span>
      <% end %>
    </p>

    <%# Рейтинг или описание (кратко) %>
    <p class="card-text text-truncate-2 small mb-3">
      <%= venue.description.truncate(80) if venue.description.present? %>
    </p>

    <div class="mt-auto d-flex justify-content-between align-items-center">
      <%# Кол-во лайков или просмотров %>
      <span class="small text-muted">
        <i class="far fa-eye"></i> <%= venue.view_count || 0 %>
      </span>

      <%=
        link_to '詳細を見る',
                venue_path(venue),
                class: 'btn btn-outline-primary btn-sm rounded-pill'
      %>
    </div>
  </div>
</div>
