<!DOCTYPE html>
<html>
<head>
  <title>場所一覧 - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>
  <%= render 'pages/header' %>
  <%= render 'pages/hero_banner' %>

  <div style="max-width: 1200px; margin: 30px auto; padding: 0 20px;">
    <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 30px;">場所一覧</h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px;">
      <% @venues.each do |venue| %>
        <%= link_to venue_path(venue), style: "text-decoration: none;" do %>
          <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); transition: all 0.3s;">
            <div style="width: 100%; height: 180px; background: linear-gradient(135deg, #64b5f7, #0288d1); display: flex; align-items: center; justify-content: center; font-size: 48px; color: white;">
              <%= venue.venue_type == 'restaurant' ? '🍽️' : '🏛️' %>
            </div>
            
            <div style="padding: 20px;">
              <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 10px 0; color: #333;">
                <%= venue.name %>
              </h3>
              
              <p style="font-size: 14px; color: #666; line-height: 1.5; margin-bottom: 15px;">
                <%= truncate(venue.description, length: 80) %>
              </p>
              
              <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
                <% if venue.cuisine_type.present? %>
                  <span style="background: #e3f2fd; color: #1976d2; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                    <%= venue.cuisine_type %>
                  </span>
                <% end %>
                
                <% if venue.district %>
                  <span style="background: #f3e5f5; color: #7b1fa2; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                    <%= venue.district.name %>
                  </span>
                <% end %>
                
                <% if venue.price_range.present? %>
                  <span style="background: #e8f5e9; color: #388e3c; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                    <%= venue.price_range %>
                  </span>
                <% end %>
              </div>
              
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #999; margin-top: 10px;">
                <span>⭐ <%= venue.average_rating || 0 %></span>
                <span>👁️ <%= venue.view_count || 0 %></span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @venues.empty? %>
      <div style="text-align: center; padding: 80px 20px; color: #999;">
        <div style="font-size: 64px; margin-bottom: 20px;">📭</div>
        <p style="font-size: 18px;">まだ場所が登録されていません</p>
      </div>
    <% end %>
  </div>

  <%= render 'pages/footer' %>
</body>
</html>