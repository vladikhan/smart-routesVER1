<h1>
  📍 新しい場所を追加
  <h1>
    <%= form_with model: @venue, local: true do |f| %>
      <div>
        <%= f.label :name, '名前' %>
        <%= f.text_field :name %>
      </div>

      <div>
        <%= f.label :description, '説明' %><br />
        <%= f.text_area :description %>
      </div>

      <div>
        <%= f.label :cuisine_type, 'カテゴリー' %><br />
        <%= f.text_field :cuisine_type %>
      </div>

      <div>
        <%= f.label :price_range, '価格帯' %><br />
        <%= f.text_field :price_range %>
      </div>

      <%= f.submit '登録する', class: 'btn btn-primary' %>
    <% end %>
  </h1>
</h1>
