<!DOCTYPE html>
<html>
<head>
  <title><%= @venue.name %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "venues", "data-turbo-track": "reload" %>
</head>
<body>
  <%= render 'pages/header' %>

  <div class="venue-detail-header">
    <div style="max-width: 1200px; width: 100%;">
      <h1 style="font-size: 36px; margin-bottom: 10px;"><%= @venue.name %></h1>
      <div style="display: flex; gap: 20px; align-items: center;">
        <div style="display: flex; align-items: center; gap: 5px;">
          ⭐ <%= @venue.average_rating || 4.5 %> (<%= @venue.reviews_count %> レビュー)
        </div>
        <div><%= @venue.price_range %></div>
        <div><%= @venue.cuisine_type %></div>
      </div>
    </div>
  </div>

  <div class="venue-detail-content">
    <div class="venue-detail-grid">
      <div>
        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">写真</h2>
          <div class="photo-grid">
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
          </div>
        </div>

        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">概要</h2>
          
          <div class="info-row">
            <div class="info-label">説明</div>
            <div class="info-value"><%= @venue.description %></div>
          </div>
          
          <div class="info-row">
            <div class="info-label">住所</div>
            <div class="info-value"><%= @venue.address %></div>
          </div>
          
          <div class="info-row">
            <div class="info-label">営業時間</div>
            <div class="info-value"><%= @venue.business_hours || "未設定" %></div>
          </div>
          
          <% if @venue.phone %>
            <div class="info-row">
              <div class="info-label">電話番号</div>
              <div class="info-value"><%= @venue.phone %></div>
            </div>
          <% end %>
          
          <div class="info-row">
            <div class="info-label">価格帯</div>
            <div class="info-value"><%= @venue.price_range %></div>
          </div>
        </div>

        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">レビュー</h2>
          
          <% if @reviews.any? %>
            <% @reviews.first(4).each do |review| %>
              <div style="padding: 20px 0; border-bottom: 1px solid #e0e0e0;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                  <strong><%= review.user.username %></strong>
                  <span style="color: #f59e0b;">⭐ <%= review.total_score %></span>
                </div>
                <p style="color: #666; line-height: 1.6;"><%= review.text %></p>
                <small style="color: #999;"><%= review.created_at.strftime('%Y年%m月%d日') %></small>
              </div>
            <% end %>
          <% else %>
            <p style="color: #999;">まだレビューがありません。</p>
          <% end %>
        </div>
      </div>

      <div class="sidebar">
        <div class="venue-info-card">
          <h3 style="margin-bottom: 15px;">地図</h3>
          <div id="venue-map" style="width: 100%; height: 300px; border-radius: 12px; background: #e0e0e0;"></div>
        </div>

        <div class="venue-info-card">
          <h3 style="margin-bottom: 15px;">ルートに掲載 (<%= @routes.count %>)</h3>
          
          <% if @routes.any? %>
            <% @routes.each do |route| %>
              <%= link_to route_path(route), style: "text-decoration: none; color: inherit;" do %>
                <div style="padding: 12px; background: #f5f5f5; border-radius: 8px; margin-bottom: 10px;">
                  <div style="font-weight: 600; margin-bottom: 5px;"><%= route.name %></div>
                  <small style="color: #666;">⏱️ <%= route.estimated_duration %>分</small>
                </div>
              <% end %>
            <% end %>
            
            <%= link_to "すべて見る →", routes_path(venue_id: @venue.id), 
                style: "color: #0288d1; text-decoration: none; font-size: 14px;" %>
          <% else %>
            <p style="color: #999; font-size: 14px;">まだルートに追加されていません。</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'pages/footer' %>

  <script>
  const API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
  
  // =======================
  // 📍 MAIN VENUE DATA
  // =======================
  const mainVenue = {
    name: <%= raw @venue.name.to_json %>,
    lat: <%= @venue.geo_lat || @venue.try(:latitude) || 35.0116 %>,
    lng: <%= @venue.geo_lng || @venue.try(:longitude) || 135.7681 %>,
    address: <%= raw (@venue.address || '').to_json %>,
    id: <%= @venue.id %>
  };
  
  // =======================
  // 🏘️ NEARBY VENUES DATA (optional)
  // =======================
  const nearbyVenues = [
    <% if @nearby_venues.present? %>
      <% @nearby_venues.each do |venue| %>
        <% if venue.geo_lat.present? && venue.geo_lng.present? %>
          {
            name: <%= raw venue.name.to_json %>,
            lat: <%= venue.geo_lat %>,
            lng: <%= venue.geo_lng %>,
            address: <%= raw (venue.address || '').to_json %>,
            id: <%= venue.id %>
          },
        <% end %>
      <% end %>
    <% end %>
  ];
  
  // =======================
  // 🗺️ INIT MAP FUNCTION
  // =======================
  function initVenueMap() {
    console.log("🗺️ Venue map initializing");
    console.log("Main venue:", mainVenue);
    console.log("Nearby venues:", nearbyVenues.length);
    
    // Проверка координат
    if (!mainVenue.lat || !mainVenue.lng || isNaN(mainVenue.lat) || isNaN(mainVenue.lng)) {
      console.error("❌ No valid coordinates for venue");
      document.getElementById("venue-map").innerHTML = 
        '<div style="padding:20px;text-align:center;color:#999;">座標情報がありません</div>';
      return;
    }
    
    const mainPosition = { lat: mainVenue.lat, lng: mainVenue.lng };
    
    // Создаем карту
    const map = new google.maps.Map(document.getElementById("venue-map"), {
      zoom: nearbyVenues.length > 0 ? 14 : 15,
      center: mainPosition,
      mapTypeControl: true,
      streetViewControl: true,
      fullscreenControl: true,
    });
    
    const bounds = new google.maps.LatLngBounds();
    
    // =======================
    // 🔴 MAIN VENUE MARKER (RED)
    // =======================
    const mainMarker = new google.maps.Marker({
      position: mainPosition,
      map,
      title: mainVenue.name,
      icon: {
        path: google.maps.SymbolPath.CIRCLE,
        fillColor: "#e53935",
        fillOpacity: 1,
        strokeColor: "white",
        strokeWeight: 3,
        scale: 18,
      },
      zIndex: 1000 // На переднем плане
    });
    
    const mainInfoWindow = new google.maps.InfoWindow({
      content: `
        <div style="padding: 12px; max-width: 250px;">
          <h4 style="margin: 0 0 8px 0; font-size: 16px; font-weight: 600; color: #e53935;">
            📍 ${mainVenue.name}
          </h4>
          <p style="margin: 0; color: #666; font-size: 13px; line-height: 1.4;">
            ${mainVenue.address || ""}
          </p>
          <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #eee;">
            <small style="color: #999;">現在地</small>
          </div>
        </div>
      `
    });
    
    mainMarker.addListener("click", () => {
      mainInfoWindow.open(map, mainMarker);
    });
    
    // Открываем InfoWindow сразу для главного venue
    mainInfoWindow.open(map, mainMarker);
    bounds.extend(mainPosition);
    
    // =======================
    // 🔵 NEARBY VENUES MARKERS (BLUE)
    // =======================
    if (nearbyVenues.length > 0) {
      nearbyVenues.forEach((venue, index) => {
        const position = { lat: venue.lat, lng: venue.lng };
        
        const marker = new google.maps.Marker({
          position,
          map,
          title: venue.name,
          icon: {
            path: google.maps.SymbolPath.CIRCLE,
            fillColor: "#0288d1",
            fillOpacity: 1,
            strokeColor: "white",
            strokeWeight: 2,
            scale: 12,
          },
          zIndex: 100
        });
        
        const infoWindow = new google.maps.InfoWindow({
          content: `
            <div style="padding: 10px; max-width: 220px;">
              <h4 style="margin: 0 0 5px 0; font-size: 14px;">
                <a href="/venues/${venue.id}" style="color: #0288d1; text-decoration: none;">
                  ${venue.name}
                </a>
              </h4>
              <p style="margin: 0; color: #666; font-size: 12px; line-height: 1.3;">
                ${venue.address || ""}
              </p>
            </div>
          `
        });
        
        marker.addListener("click", () => {
          infoWindow.open(map, marker);
        });
        
        bounds.extend(position);
      });
      
      // Подгоняем карту под все маркеры
      map.fitBounds(bounds);
      
      // Ограничиваем максимальный zoom
      google.maps.event.addListenerOnce(map, 'bounds_changed', function() {
        if (map.getZoom() > 16) {
          map.setZoom(16);
        }
      });
    }
  }
  
  // =======================
  // 🔌 GOOGLE MAPS LOADER
  // =======================
  function loadGoogleMapsForVenue() {
    if (!API_KEY) {
      console.error("❌ No API key!");
      document.getElementById("venue-map").innerHTML =
        '<div style="padding:20px;text-align:center;color:#b71c1c;">Google Maps APIキーがありません</div>';
      return;
    }
    
    if (window.google && window.google.maps) {
      initVenueMap();
      return;
    }
    
    console.log("Loading Google Maps for venue...");
    const script = document.createElement("script");
    script.src = `https://maps.googleapis.com/maps/api/js?key=${API_KEY}&callback=initVenueMap&language=ja`;
    script.async = true;
    script.defer = true;
    window.initVenueMap = initVenueMap;
    document.head.appendChild(script);
  }
  
  document.readyState === "loading"
    ? document.addEventListener("DOMContentLoaded", loadGoogleMapsForVenue)
    : loadGoogleMapsForVenue();
</script>

</body>
</html>
