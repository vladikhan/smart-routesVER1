<% content_for :title, "#{@venue.name} - Smart Routes" %>

  <%= render 'pages/header' %>

   <!-- Hero Section -->
<div class="venue-detail-header">
  <div style="max-width: 1200px; width: 100%; position: relative; z-index: 2;">
    <div class="venue-header-meta">
      <div class="venue-meta-item">
        <i class="fas fa-utensils"></i>
        <span><%= @venue.cuisine_type %></span>
      </div>
      <div class="venue-meta-item">
        <i class="fas fa-yen-sign"></i>
        <span><%= @venue.price_range %></span>
      </div>
    </div>

    <h1><%= @venue.name %></h1>

    <div class="venue-quick-stats">
      <div class="stat-badge stat-rating">
        <i class="fas fa-star"></i>
        <strong><%= number_with_precision(@venue.average_rating || 0, precision: 1) %></strong>
        <span>(<%= @venue.reviews_count || 0 %>件)</span>
      </div>
      <div class="stat-badge">
        <i class="fas fa-eye"></i>
        <span><%= @venue.view_count || 0 %>回閲覧</span>
      </div>
      <div class="stat-badge">
        <i class="fas fa-bookmark"></i>
        <span><%= @venue.save_count || 0 %>保存</span>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="venue-action-buttons">
  <% if user_signed_in? && @venue.present? %>

    <!-- Like Button -->
    <% if current_user.liked?(@venue) %>
      <% like = current_user.likes.find_by(likeable: @venue) %>
      <%= button_to "/venues/#{@venue.id}/likes/#{like.id}",
                    method: :delete,
                    class: "action-btn btn-like active" do %>
        <i class="fas fa-heart"></i>
        <span>❤️ いいね</span>
      <% end %>
    <% else %>
      <%= button_to venue_likes_path(@venue),
                    params: { likeable_type: 'Venue', likeable_id: @venue.id },
                    method: :post,
                    class: "action-btn btn-like" do %>
        <i class="far fa-heart"></i>
        <span>❤️ いいね</span>
      <% end %>
    <% end %>

    <!-- Bookmark Button -->
    <% if current_user.bookmarked?(@venue) %>
      <%= button_to venue_bookmark_path(@venue),
                    method: :delete,
                    params: { item_type: 'Venue', item_id: @venue.id },
                    class: "action-btn btn-save active" do %>
        <i class="fas fa-bookmark"></i>
        <span>保存済み</span>
      <% end %>
    <% else %>
      <%= button_to venue_bookmark_path(@venue),
                    method: :post,
                    params: { item_type: 'Venue', item_id: @venue.id },
                    class: "action-btn btn-save" do %>
        <i class="far fa-bookmark"></i>
        <span>🔖 保存</span>
      <% end %>
    <% end %>

  <% end %>

  <!-- Share Button -->
      <button class="action-btn btn-share" onclick="shareVenue()">
        <i class="fas fa-share-alt"></i>
        <span>シェア</span>
      </button>
      
      <!-- Edit Button (Owner Only) -->
      <% if user_signed_in? && current_user == @venue.user %>
        <%= link_to edit_venue_path(@venue), class: "action-btn btn-edit" do %>
          <i class="fas fa-edit"></i>
          <span>編集</span>
        <% end %>
      <% end %>
  </button>
</div>
  </div>
</div>
  
  <!-- Main Content -->
  <div class="venue-detail-content">
    <div class="venue-detail-grid">

  <!-- Left Column -->
  <div class='left-column'>
    <div class="venue-info-card">

    <!-- Header -->
    
    <div class="card-header-with-action"
          style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h2 style="margin:0;">
          <i class="fas fa-images"></i>
          写真ギャラリー
        </h2>

        <%= form_with(model: @venue, local: true, class: "upload-form") do |f| %>
          <label class="btn-upload-photos"
                style="cursor:pointer; background:#3b82f6; color:white; padding:5px 12px; border-radius:6px; font-size: 0.9rem;">
            <i class="fas fa-plus"></i> 追加
            <%= f.file_field :photos,
                  multiple: true,
                  accept: 'image/*',
                  onchange: "this.form.submit()",
                  style: "display:none;" %>
          </label>
        <% end %>
      </div>

  <!-- Body -->
    <div class="card-body">
      

      <% if @venue.photos.attached? %>
        <% if @venue.photos.count > 8 %>

          <div class="swiper venueSwiper" style="padding-bottom: 2rem;">
            <div class="swiper-wrapper">
              <% @venue.photos.each do |photo| %>
                <div class="swiper-slide">
                  <div class="photo-item"
                      style="position:relative; aspect-ratio:1/1; overflow:hidden; border-radius:8px;">

                    <button type="button"
                            class="delete-photo-overlay"
                            onclick="confirmDelete('<%= delete_photo_venue_path(@venue, photo_id: photo.id) %>')">
                      <i class="fas fa-times" style="font-size: 12px;"></i>x
                    </button>

                    <div class="photo-click-area"
                        onclick="openPhotoModal('<%= url_for(photo) %>')"
                        style="cursor:pointer; width:100%; height:100%;">
                      <% if photo.variable? %>
                        <%= image_tag photo.variant(resize_to_limit: [400, 400]),
                              style: "width:100%; height:100%; object-fit:cover;" %>
                      <% else %>
                        <%= image_tag photo,
                              style: "width:100%; height:100%; object-fit:cover;" %>
                      <% end %>
                    </div>

                  </div>
                </div>
              <% end %>
            </div>

            <div class="swiper-pagination"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>

        <% else %>

          <div class="photo-grid"
              style="display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:10px;">
            <% @venue.photos.each do |photo| %>
              <div class="photo-item"
                  style="position:relative; aspect-ratio:1/1; overflow:hidden; border-radius:8px;">

                <button type="button"
                        class="delete-photo-overlay"
                        onclick="confirmDelete('<%= delete_photo_venue_path(@venue, photo_id: photo.id) %>')">
                  <i class="fas fa-times" style="font-size: 12px;"></i>x
                </button>

                <div class="photo-click-area"
                    onclick="openPhotoModal('<%= url_for(photo) %>')"
                    style="cursor:pointer; width:100%; height:100%;">
                  <% if photo.variable? %>
                    <%= image_tag photo.variant(resize_to_limit: [400, 400]),
                          style: "width:100%; height:100%; object-fit:cover;" %>
                  <% else %>
                    <%= image_tag photo,
                          style: "width:100%; height:100%; object-fit:cover;" %>
                  <% end %>
                </div>

              </div>
            <% end %>
          </div>

        <% end %>
      <% else %>

        <p class="text-muted text-center"
          style="padding:2rem; background:#f9f9f9; border-radius:8px;">
          写真はまだアップロードされていません
        </p>

      <% end %>

    </div>

  <!-- /Left Column -->
      
                  <!-- Overview Section -->
          <div class="venue-info-card">
            <h2><i class="fas fa-info-circle"></i> 基本情報</h2>
            <div class="info-row">
              <div class="info-label"><i class="fas fa-align-left"></i> 説明</div>
              <div class="info-value"><%= @venue.description.presence || "説明はまだ追加されていません" %></div>
            </div>
            <div class="info-row">
              <div class="info-label"><i class="fas fa-map-marked-alt"></i> 住所</div>
              <div class="info-value"><%= @venue.address %></div>
            </div>
          </div>

          <div class="venue-info-card reviews-section">
            <div class="reviews-header">
              <h3>レビュー</h3>
            </div>




            

            <!-- Review Form Section -->
  <!-- Review Form Section -->
<div id="review-form-section" class="mb-4">

<% if user_signed_in? %>
  <div class="review-form-card mb-4 p-4 bg-white rounded-4 shadow-sm border">
    <%= form_with(model: [@venue, @venue.reviews.build],
                  local: true,
                  class: 'review-form') do |f| %>

      <div class="d-flex gap-3 align-items-start">

        <div class="author-avatar-large flex-shrink-0 shadow-sm"
             style="width:45px; height:45px; font-size:18px;">
          <%= current_user.username&.at(0)&.upcase || "U" %>
        </div>

        <div class="flex-grow-1">

          <div class="rating-select mb-2 d-flex align-items-center gap-2">
            <br />
            <div class="stars-input text-warning"
                 style="cursor:pointer; font-size: 1.2rem;">
              <% 5.times do |i| %>
                <i class="far fa-star star-icon"
                   data-value="<%= i + 1 %>"></i>
              <% end %>
            </div>

            <%= f.hidden_field :total_score,
                               id: 'review_total_score',
                               value: 5 %>
          </div>

          <div class="comment-input-wrapper rounded-3 border">

            <%= f.text_area :text,
                class: 'form-control border-0 shadow-none p-3',
                rows: 1,
                placeholder: 'あなたの感想を共有しましょう...',
                oninput: 'this.style.height = ""; this.style.height = this.scrollHeight + "px"',
                style: 'resize:none; background:transparent; width:100%; min-height:50px;' %>

            <div class="d-flex justify-content-between align-items-center p-2 border-top bg-light-subtle rounded-bottom-3">
              <%= f.submit 'レビューを書く',
                    class: 'btn btn-primary rounded-pill px-4 fw-bold shadow-sm',
                    id: 'submit-comment' %>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </div>

<% else %>

  <div class="text-center py-4 mb-4 bg-light rounded-3 border">
    <i class="fas fa-sign-in-alt fa-2x mb-2 text-muted opacity-50"></i>
    <p class="mb-2 text-muted">
      コメントを投稿するにはログインが必要です
    </p>
    <%= link_to 'ログイン',
                new_user_session_path,
                class: 'btn btn-outline-primary rounded-pill px-4' %>
  </div>

<% end %>

</div>

    <!-- Reviews List -->
  <div class="reviews-list">
    <% if @reviews.any? %>
      <% @reviews.order(created_at: :desc).each_with_index do |review, index| %>
        <div class="review-item py-3 <%= 'border-bottom' unless index == @reviews.count - 1 %>"
            id="review-<%= review.id %>">

          <div class="d-flex gap-3">
            <!-- Avatar -->
            <div class="author-avatar-large flex-shrink-0"
                style="width:40px; height:40px; font-size:16px;">
              <% if review.user.avatar.present? %>
                <%= image_tag review.user.avatar.thumb.url,
                      class: 'w-100 h-100 rounded-circle object-fit-cover' %>
              <% else %>
                <%= review.user.username.first.upcase %>
              <% end %>
            </div>

            




            <!-- Content -->
            <div class="flex-grow-1">
              <!-- Header -->
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><%= review.user.username %></strong>
                  <div class="text-muted small">
                    <%= time_ago_in_words(review.created_at) %>前
                  </div>
                </div>

                <% if user_signed_in? && review.user_id == current_user.id %>
                  <div class="dropdown">
                    <br />

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                      
                      
                        <button class="dropdown-item"
                                onclick="toggleEditReview(<%= review.id %>)">
                          編集
                        </button>
                      
                      
                        <% delete_url =
                            @venue.present? ?
                              venue_review_path(@venue, review) :
                              venue_review_path(@venue, review) %>

                        <button type="button"
                                class="dropdown-item text-danger"
                                onclick="confirmDeleteReview('<%= delete_url %>')">
                          削除
                        </button>
                      
                    </ul>
                        <br />
                  </div>
                <% end %>
              </div>

              <!-- DISPLAY MODE -->
              <div id="review-display-<%= review.id %>" class="review-content mt-2">
                <%= simple_format(review.text) %>
              </div>

              <!-- EDIT MODE -->
              <% if user_signed_in? && review.user_id == current_user.id %>
                <% parent_resource = @route || @venue %>

                <div id="review-edit-<%= review.id %>" style="display:none;" class="mt-2">
                  <%= form_with(model: [parent_resource, review], local: true) do |f| %>
                    <%= f.text_area :text, class: "form-control mb-2", rows: 3 %>

                    <div class="d-flex gap-2 justify-content-end">
                      <%= f.submit '更新する',
                            class: 'btn btn-update-review rounded-pill' %>

                      <button type="button"
                              class="btn btn-cancel-review rounded-pill"
                              onclick="toggleEditReview(<%= review.id %>)">
                        キャンセル
                      </button>
                    </div>
                  <% end %>
                </div>
              <% end %>

            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-4">
        まだレビューはありません
      </div>
    <% end %>
  </div>    
</div>    
</div>
  

          


    <%# After this </div> starts right sidebar%>

      
  </div>
  <%= render 'venues/sidebar' %>
      </div>
    </div>
  </div>

<div id="photoModal" class="photo-modal" onclick="closePhotoModal()" style="display:none; position:fixed; z-index:9999; left:50%; top:50%; transform: translate(-50%, -50%); width:70%; height:90%; max-width: 900px; background-color: rgba(0,0,0,0.85); border-radius: 20px; align-items:center; justify-content:center; box-shadow: 0 0 100px rgba(0,0,0,0.5);">
  
  <span style="position:absolute; top:20px; right:35px; color:#fff; font-size:30px; font-weight:bold; cursor:pointer; opacity: 0.8;">&times;</span>
  
  <img id="modalImage" style="
    max-width: 90%; 
    max-height: 70vh; 
    object-fit: contain; 
    border-radius: 12px; 
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    border: 2px solid rgba(255,255,255,0.1);
  ">
</div>
  
  

  

  <%= render 'pages/footer' %>

  <script>
  // Глобальные переменные для контроля инициализации
  let venueSwiperInstance = null;

  // ========== 1. Google Map ==========
  function initMap() {
    const mapElement = document.getElementById("map");
    if (!mapElement) return;

    <% if @venue.geo_lat.present? && @venue.geo_lng.present? %>
      const venueLocation = { lat: <%= @venue.geo_lat %>, lng: <%= @venue.geo_lng %> };
      const map = new google.maps.Map(mapElement, {
        zoom: 15,
        center: venueLocation,
        mapTypeControl: true,
        streetViewControl: true,
        fullscreenControl: true
      });
      
      const marker = new google.maps.Marker({
        position: venueLocation,
        map: map,
        title: '<%= j @venue.name %>',
        animation: google.maps.Animation.DROP
      });

      const infoWindow = new google.maps.InfoWindow({
        content: `<div style="padding: 10px;"><h4><%= j @venue.name %></h4><p><%= j @venue.address %></p></div>`
      });
      
      marker.addListener('click', () => infoWindow.open(map, marker));
    <% end %>
  }

  // ========== 2. Swiper Carousel ==========
  function setupSwiper() {
    const el = document.querySelector('.venueSwiper');
    if (!el || venueSwiperInstance) return;

    if (typeof Swiper !== 'undefined') {
      venueSwiperInstance = new Swiper('.venueSwiper', {
  slidesPerView: 2,       // Увеличили с 1.2 (фото станут чуть меньше по ширине, но выше)
  spaceBetween: 10,
  
  pagination: { el: '.swiper-pagination', clickable: true },
  navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
  
  breakpoints: {
    // Если ширина экрана больше или равна 768px (планшеты)
    768: {
      slidesPerView: 3,
      spaceBetween: 15
    },
    // Если ширина экрана больше или равна 1024px (ноутбуки/ПК)
    1024: {
      slidesPerView: 4, // Вот здесь ставим ровно 4
      spaceBetween: 20  // Расстояние между слайдами
    }
  },
  pagination: { el: '.swiper-pagination', clickable: true },
  navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }
});
    }
  }

  // ========== 3. Photo Modal  ==========
  function openPhotoModal(imgUrl) {
    const modal = document.getElementById("photoModal");
    const modalImg = document.getElementById("modalImage");
    if (!modal || !modalImg) return;

    modalImg.src = imgUrl;
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  }

  function closePhotoModal() {
    const modal = document.getElementById("photoModal");
    if (modal) {
      modal.style.display = "none";
      document.body.style.overflow = "auto";
    }
  }

  // ========== 4. Event Listeners (Turbo & Global) ==========
  
  // Единый слушатель для Esc
  document.addEventListener('keydown', (e) => {
    if (e.key === "Escape") closePhotoModal();
  });

  // Очистка Swiper перед кэшированием (для Turbo)
  document.addEventListener('turbo:before-cache', () => {
    if (venueSwiperInstance) {
      venueSwiperInstance.destroy();
      venueSwiperInstance = null;
    }
  });

  // Запуск всего при загрузке (Turbo и обычный)
  function initAll() {
    initMap();
    setupSwiper();
  }

  document.addEventListener('turbo:load', initAll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  // ========== 5. UI Helpers ==========
  function shareVenue() {
    if (navigator.share) {
      navigator.share({
        title: '<%= j @venue.name %>',
        url: window.location.href
      });
    } else {
      navigator.clipboard.writeText(window.location.href);
      alert('URLをコピーしました！');
    }
  }

  window.toggleEditReview = function (reviewId) {
  if (!reviewId) return;

  const displayDiv = document.getElementById('review-display-' + reviewId);
  const editDiv = document.getElementById('review-edit-' + reviewId);

  if (!displayDiv || !editDiv) return;

  const isHidden =
    editDiv.style.display === 'none' || editDiv.style.display === '';

  displayDiv.style.display = isHidden ? 'none' : 'block';
  editDiv.style.display = isHidden ? 'block' : 'none';
};


// keep your existing listener EXACTLY as-is
document.addEventListener("turbo:load", () => {
  initMap();
  }
);



  function scrollToReviewForm() {
    document.getElementById('review-form-section')?.scrollIntoView({ behavior: 'smooth' });
  }

  function confirmDelete(url) {
  Swal.fire({
    title: '削除しますか？',
    text: "この操作は取り消せません！",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'はい、削除します',
    cancelButtonText: 'キャンセル',
    focusCancel: true // Чтобы случайно не нажать "Удалить" энтером
  }).then((result) => {
    if (result.isConfirmed) {
      // 1. Ищем CSRF токен (Rails без него не примет запрос)
      const token = document.querySelector('meta[name="csrf-token"]').content;

      // 2. Создаем форму
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = url;

      // 3. Добавляем скрытое поле _method=delete (нужно для Rails)
      const methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'delete';
      form.appendChild(methodInput);

      // 4. Добавляем токен подлинности
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = token;
      form.appendChild(csrfInput);

      // 5. Отправляем
      document.body.appendChild(form);
      form.submit();
    }
  })
}

// чтобы кнопки не ломали страницу
window.bookmarkVenue = function () {
  console.log('bookmarkVenue — пока не реализовано');
};

window.addToRoute = function () {
  console.log('addToRoute — пока не реализовано');
};

// алиас для удаления отзывов
window.confirmDeleteReview = function (url) {
  confirmDelete(url);
};
</script>

