
<!DOCTYPE html>
<html>
<head>
  <title><%= @venue.name %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "venues", "data-turbo-track": "reload" %>
</head>
<body>
  <%= render 'pages/header' %>

  <div class="venue-detail-header">
    <div style="max-width: 1200px; width: 100%;">
      <h1 style="font-size: 36px; margin-bottom: 10px;"><%= @venue.name %></h1>
      <div style="display: flex; gap: 20px; align-items: center;">
        <div style="display: flex; align-items: center; gap: 5px;">
          ⭐ <%= @venue.average_rating || 4.5 %> (<%= @venue.reviews_count %> レビュー)
        </div>
        <div><%= @venue.price_range %></div>
        <div><%= @venue.cuisine_type %></div>
      </div>
    </div>
  </div>

  <div class="venue-detail-content">
    <div class="venue-detail-grid">
      <div>
        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">写真</h2>
          <div class="photo-grid">
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
            <div class="photo-item">写真</div>
          </div>
        </div>

        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">概要</h2>
          
          <div class="info-row">
            <div class="info-label">説明</div>
            <div class="info-value"><%= @venue.description %></div>
          </div>
          
          <div class="info-row">
            <div class="info-label">住所</div>
            <div class="info-value"><%= @venue.address %></div>
          </div>
          
          <div class="info-row">
            <div class="info-label">営業時間</div>
            <div class="info-value"><%= @venue.business_hours || "未設定" %></div>
          </div>
          
          <% if @venue.phone %>
            <div class="info-row">
              <div class="info-label">電話番号</div>
              <div class="info-value"><%= @venue.phone %></div>
            </div>
          <% end %>
          
          <div class="info-row">
            <div class="info-label">価格帯</div>
            <div class="info-value"><%= @venue.price_range %></div>
          </div>
        </div>

        <div class="venue-info-card">
          <h2 style="margin-bottom: 20px;">レビュー</h2>
          
          <% if @reviews.any? %>
            <% @reviews.first(4).each do |review| %>
              <div style="padding: 20px 0; border-bottom: 1px solid #e0e0e0;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                  <strong><%= review.user.username %></strong>
                  <span style="color: #f59e0b;">⭐ <%= review.total_score %></span>
                </div>
                <p style="color: #666; line-height: 1.6;"><%= review.text %></p>
                <small style="color: #999;"><%= review.created_at.strftime('%Y年%m月%d日') %></small>
              </div>
            <% end %>
          <% else %>
            <p style="color: #999;">まだレビューがありません。</p>
          <% end %>
        </div>
      </div>

      <div class="sidebar">
        <div class="venue-info-card">
          <h3 style="margin-bottom: 15px;">地図</h3>
          <div id="venue-map" style="width: 100%; height: 300px; border-radius: 12px; background: #e0e0e0;"></div>
        </div>

        <div class="venue-info-card">
          <h3 style="margin-bottom: 15px;">ルートに掲載 (<%= @routes.count %>)</h3>
          
          <% if @routes.any? %>
            <% @routes.each do |route| %>
              <%= link_to route_path(route), style: "text-decoration: none; color: inherit;" do %>
                <div style="padding: 12px; background: #f5f5f5; border-radius: 8px; margin-bottom: 10px;">
                  <div style="font-weight: 600; margin-bottom: 5px;"><%= route.name %></div>
                  <small style="color: #666;">⏱️ <%= route.estimated_duration %>分</small>
                </div>
              <% end %>
            <% end %>
            
            <%= link_to "すべて見る →", routes_path(venue_id: @venue.id), 
                style: "color: #0288d1; text-decoration: none; font-size: 14px;" %>
          <% else %>
            <p style="color: #999; font-size: 14px;">まだルートに追加されていません。</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render 'pages/footer' %>

  <script>
    var API_KEY = '<%= ENV["GOOGLE_MAPS_API_KEY"] %>';
    var venueLat = <%= @venue.latitude || @venue.geo_lat || 35.0116 %>;
    var venueLng = <%= @venue.longitude || @venue.geo_lng || 135.7681 %>;
    var venueName = '<%= j @venue.name %>';
    var venueAddress = '<%= j @venue.address %>';

    function initMap() {
      var position = { lat: venueLat, lng: venueLng };
      
      var map = new google.maps.Map(document.getElementById('venue-map'), {
        zoom: 15,
        center: position,
        mapTypeControl: true
      });

      var marker = new google.maps.Marker({
        position: position,
        map: map,
        title: venueName
      });

      var infoWindow = new google.maps.InfoWindow({
        content: '<div style="padding: 10px;"><h4 style="margin: 0 0 5px 0;">' + venueName + '</h4><p style="margin: 0; color: #666; font-size: 13px;">' + venueAddress + '</p></div>'
      });

      marker.addListener('click', function() {
        infoWindow.open(map, marker);
      });
    }
  </script>
  
  <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap&language=ja"></script>
</body>
</html>
