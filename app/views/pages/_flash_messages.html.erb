

  <script>
    setTimeout(function() {
      const flashMessages = document.querySelectorAll('.flash-message');
      flashMessages.forEach(function(message) {
        message.classList.add('hiding');
        setTimeout(function() {
          message.remove();
        }, 400);
      });
    }, 5000);

    function closeFlash(button) {
      const message = button.closest('.flash-message');
      message.classList.add('hiding');
      setTimeout(function() {
        message.remove();
      }, 400);
    }
	</script>

  