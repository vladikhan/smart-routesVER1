
<!DOCTYPE html>
<html>
<head>
  <title>ログアウト - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "login", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="login-header">
    <%= link_to root_path, class: "login-logo" do %>
      <span class="login-logo-icon">🗺️</span>
      <span>Smart<strong>Routes</strong></span>
    <% end %>
    <%= link_to "ログイン", new_user_session_path, class: "login-link" %>
  </header>

  <div class="login-container">
    <div class="login-box">
      <h2 class="logout-title">ログアウトしますか?</h2>

      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn-primary" %>

      <button class="btn-cancel" onclick="window.history.back()">
        キャンセル
      </button>
    </div>
  </div>
</body>
</html>
