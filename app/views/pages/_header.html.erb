  <header class="header">
    <div class="container">
      <a href="/" class="logo">SmartRoutes</a>

      <ul class="nav-links">
        <li><%= link_to "ルート一覧", routes_path %></li>
        <li><%= link_to "場所を探す", venues_path %></li>
        <li><%= link_to "メッセージ", "#", title: "メッセージ" %></li>  
        <li><%= link_to "ユーザー", users_path, title: "ユーザー" %></li>
      </ul>

      <div class="auth-links">
      <% if user_signed_in? %>

      <%# Notification Droptown %>

      <div class="notifications-dropdown">
        <button class='page-nav-icon notifications-toggle' onclick="toggleNotifications(event)" id="notificationBell">
          🔔
          <% unread_count = current_user.unread_notifications_count %>
          <% if unread_count > 0 %>
            <span class="notifications-panel" id="notificationsPanel">
              <div class="notifications-header">
                <h3>t通知</h3>
                <% if unread_count > 0 %>
                <% link_to "すべて既読", mark_all_as_read_notifications_path,
                method: :patch,
                class: "mark-all-read",
                remote: true,
                data: { disable_with: "処理中..." } %>
                <% end %>
              </div>

              <div class="notification-list" id="notificationsList">
                <% notifications.each do |notification| %>
                  <%= link_to mark_all_as_read_notifications_path(notification),
                  method: :patch,
                  class: "notification-item #{'unread' unless notification.is_read?}",
                  data: { notification_id: notification.id } do %>
                <div class="notification-icon"><%= notification.icon %></div>
                <div class="notification-content">
                  <div class="notification-message"><%= notification.message %></div>
                  <div class="notification-time"><%=time_ago_in_words(notification.create_at) %>前</div>
                </div>
                <% unless notification.is_read? %>
                  <div class="unread-dot"></div>
                  <% end %>
                <% end %>
              <% end %>

              <%= link_to "すべて見る", notifications_path, class: "view-all-notifications" %>
            <% else %>
              <div class="no-notifications">
                <div style="font-size: 48px; margin-bottom: 10px;">🔔</div>
                  <div>通知はありません</div>
              </div>
              <% end %>
              </div>
            </div>
          </div>

            </span>
        </button>
      </div>

      <%= link_to user_path(current_user), class: "page-nav-icon", title: "マイページ" do %>
        <% if current_user.avatar.present? %>
        <%= image_tag current_user.avatar.thumb.url %>
      <% else %>
          👤
        <% end %>
      <% end %>
      <%= link_to "💾", "#", class: "page-nav-icon", title: "保存済み" %>
      <%= link_to "ログアウト", logout_confirm_path, class: "login-btn", title: "ログアウト" %>
  <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "login-btn"  %>
    <% end %>
  
      </div>
    </div>
  </header>

  <style>
  .btn-create-route {
    background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
    color: white;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(76, 175, 80, 0.3);
  }

  .btn-create-route:hover {
    background: linear-gradient(135deg, #45a049 0%, #3d8b40 100%);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
  }

  /* Notifications */
  .notifications-dropdown {
    position: relative;
  }

  .notifications-toggle {
    position: relative;
    cursor: pointer;
    background: none;
    border: none;
    font-size: 24px;
  }

  .notification-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
    color: white;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 12px;
    min-width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(244, 67, 54, 0.5);
    animation: badgePulse 2s infinite;
  }

  @keyframes badgePulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .notifications-panel {
    position: absolute;
    top: 55px;
    right: 0;
    width: 380px;
    max-height: 600px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    display: none;
    z-index: 1000;
    overflow: hidden;
  }

  .notifications-panel.show {
    display: block;
    animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .notifications-header {
    padding: 20px;
    border-bottom: 2px solid #f0f0f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  }

  .notifications-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: #1a1a1a;
  }

  .mark-all-read {
    color: #0288d1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .mark-all-read:hover {
    background: #e3f2fd;
    color: #01579b;
  }

  .notifications-list {
    max-height: 500px;
    overflow-y: auto;
  }

  .notification-item {
    display: flex;
    gap: 15px;
    padding: 16px 20px;
    border-bottom: 1px solid #f5f5f5;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    align-items: center;
    position: relative;
  }

  .notification-item:hover {
    background: linear-gradient(135deg, #f8f9fa 0%, #e3f2fd 100%);
  }

  .notification-item.unread {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    border-left: 4px solid #0288d1;
  }

  .notification-icon {
    font-size: 28px;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .notification-content {
    flex: 1;
    min-width: 0;
  }

  .notification-message {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .notification-time {
    font-size: 12px;
    color: #999;
  }

  .unread-dot {
    width: 10px;
    height: 10px;
    background: #0288d1;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(2, 136, 209, 0.2);
    animation: dotPulse 2s infinite;
  }

  @keyframes dotPulse {
    0%, 100% {
      box-shadow: 0 0 0 3px rgba(2, 136, 209, 0.2);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(2, 136, 209, 0.1);
    }
  }

  .no-notifications {
    text-align: center;
    padding: 60px 20px;
    color: #999;
  }

  .view-all-notifications {
    display: block;
    text-align: center;
    padding: 16px;
    color: #0288d1;
    text-decoration: none;
    font-weight: 700;
    border-top: 2px solid #f0f0f0;
    background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    transition: all 0.2s;
  }

  .view-all-notifications:hover {
    background: #e3f2fd;
    color: #01579b;
  }

  @media (max-width: 768px) {
    .notifications-panel {
      width: calc(100vw - 20px);
      right: -10px;
    }
  }
</style>

