<div class="container my-5">
	<h1>レビューの編集</h1> <%= form_with(model: [@reviewable, @review], local: true) do |f| %>
	<% if @review.errors.any? %>
	<div class="alert alert-danger">
		<ul>
			<% @review.errors.full_messages.each do |message| %>
				<li><%= message %></li>
				<% end %>
		</ul>
	</div>
	<% end %>

	<div class="mb-3">
		<%= f.label :total_score, "評価" %> <%= f.select :total_score, [1,2,3,4,5], {}, class: 'form-select' %>
	</div>

	<div class="mb-3">
		<%= f.label :text, "コメント" %><%= f.text_area :text, class: 'form-control', rows: 5 %>
	</div>

	<div class="mt-4">
		<%= f.submit "更新する", class: 'btn btn-primary' %> <%= link_to "キャンセル", @reviewable, class: 'btn btn-outline-secondary' %>
	</div>
	<% end %>
</div>