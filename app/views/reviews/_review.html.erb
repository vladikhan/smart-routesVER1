<div class="review-card shadow-sm position-relative">
  

  <div class="review-header">
    <div class="review-info-group">
      <div class="review-header">
        <div class="review-author">
          <div class="author-avatar-large avatar-container shadow-sm" 
     style="width: 50px; height: 50px; overflow: hidden; border-radius: 50%; background-color: #f0f2f5; flex-shrink: 0;">
  <%= link_to user_path(review.user), title: review.user.username, class: "d-block w-100 h-100" do %>
    <%= user_avatar(review.user, size: 50, css_class: "rounded-circle object-fit-cover") %>
  <% end %>
</div>
          <div class="review-author-info">
            <div class="review-author-name"><%= review.user.username %></div>
            
          </div>
        </div>

        <% if review.reviewable %>
          <div class="review-target-header small mt-1">
            <%= link_to [review.reviewable], class: "text-decoration-none stretched-link" do %>
              <span class="text-primary fw-bold">
                <%= review.reviewable_type == 'Route' ? '' : '📍' %>
                <%= review.reviewable.name %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# 3. Дата %>
      <div class="review-date small text-muted">
        <%= review.created_at.strftime('%Y/%m/%d') %>
      </div>
    </div>
  </div>
  <%# 4. Текст отзыва %>
  <div class="review-content mt-2">
    <div
      class="review-text-body"
      style="white-space: pre-wrap; position: relative; z-index: 2;"
    >
      <%= review.text %>
    </div>
  </div>
</div>
