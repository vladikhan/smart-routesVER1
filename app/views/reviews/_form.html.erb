

<style>
  /* Стили для выбора звезд (справа налево для работы селектора ~) */
  .star-rating-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    font-size: 2.5rem;
  }
  
  .star-label {
    cursor: pointer;
    filter: grayscale(100%);
    transition: transform 0.2s, filter 0.2s;
  }
  
  /* Магия CSS: зажигаем все звезды до выбранной */
  .star-rating-input input:checked ~ label,
  .star-rating-input label:hover,
  .star-rating-input label:hover ~ label {
    filter: grayscale(0%);
    transform: scale(1.1);
  }

  .form-control:focus {
    border-color: #0d6efd;
    box-shadow: none;
  }
</style>

<script>
  // Важно: используем turbo:load для совместимости с Hotwire/Turbo
  document.addEventListener('turbo:load', function() {
    const form = document.getElementById('reviewForm');
    if (!form) return;

    const submitBtn = document.getElementById('submitReviewBtn');
    const radios = form.querySelectorAll('input[name="review[total_score]"]');
    const textarea = document.getElementById('review_text_area');
    const charCount = document.getElementById('charCount');

    // Активируем кнопку только после выбора рейтинга
    radios.forEach(radio => {
      radio.addEventListener('change', () => {
        submitBtn.disabled = false;
      });
    });

    // Счетчик символов
    textarea?.addEventListener('input', (e) => {
      if (charCount) charCount.textContent = e.target.value.length;
    });
  });
</script>