<!DOCTYPE html>
<html>
<head>
  <title>@<%= @user.username %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'profile', media: 'all' %>
</head>
<body class="profile-page">
  <%= render 'pages/header' %>


  <!-- Profile Header -->
  <section class="profile-header">
    <div class="profile-header-content">
      <%= image_tag @user.avatar_url, class: "profile-avatar-large", alt: @user.username %>
      
      <div class="header-info">
        <h1 class="header-username">@<%= @user.username %></h1>
        <p class="header-bio"><%= @user.bio.presence || "まだ自己紹介がありません" %></p>
        
        <% if @user.location.present? %>
          <p class="header-location">📍 <%= @user.location %></p>
        <% end %>
        
        <div class="header-stats">
          <div class="profile-stat">
            <div class="stat-number"><%= @user.routes.count %></div>
            <div class="stat-label">ルート</div>
          </div>
          <div class="profile-stat">
            <div class="stat-number">12</div>
            <div class="stat-label">フォロー</div>
          </div>
          <div class="profile-stat">
            <div class="stat-number">95</div>
            <div class="stat-label">フォロワー</div>
          </div>
        </div>
        
        <div class="profile-header">
          <% if current_user == @user %>
            <%= link_to "✏️ プロフィール編集", edit_user_path(@user), class: "btn btn--edit" %>
          <% else %>
            <button class="btn btn-follow">フォロー</button>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabs -->
  <section class="profile-tabs">
    <div class="tabs-container">
      <button class="profile-tab profile-tab--active">作成したルート</button>
      <button class="profile-tab">保存したルート</button>
      <button class="profile-tab">レビュー</button>
      <button class="profile-tab">アクティビティ</button>
    </div>
  </section>

  <!-- Created Routes -->
  <main class="profile-content">
    <h2 class="profile-content__title">作成したルート (<%= @routes.count %>)</h2>
    
    <% if @routes.any? %>
      <div class="profile-routes-grid">
        <% @routes.each do |route| %>
          <%= link_to route_path(route), class: "profile-route-card" do %>
            <div class="profile-route-card__image">🗺️</div>
            <div class="profile-route-card__content">
              <h3 class="profile-route-card__name"><%= route.name %></h3>
              <p class="profile-route-card__description"><%= truncate(route.description, length: 80) %></p>
              <div class="profile-route-card__meta">
                <span class="profile-route-card__views">👁️ <%= route.view_count || 0 %></span>
                <span class="profile-route-card__price">💰 ¥<%= number_with_delimiter(route.estimated_cost) %></span>
              </div>
              <div class="profile-route-card__tags">
                <span class="profile-route-card__tag">⏱️ <%= route.estimated_duration %>分</span>
                <span class="profile-route-card__tag">📍 <%= route.route_items.count %>箇所</span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="profile-empty">
        <p class="profile-empty__icon">📭</p>
        <p class="profile-empty__text">まだルートを作成していません</p>
      </div>
    <% end %>

    <!-- Reviews Section -->
    <h2 class="profile-content__title">レビュー (<%= @reviews.count %>)</h2>

    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
  <% reviewable = review.reviewable %>
  <div class="profile-review-card">
    <div class="profile-review-card__header">
      <div class="profile-review-card__target">
        <% if reviewable.is_a?(Venue) %>
          <%= link_to reviewable.name, venue_path(reviewable), class: "profile-review-card__link" %>
        <% elsif reviewable.is_a?(Route) %>
          <%= link_to reviewable.name, route_path(reviewable), class: "profile-review-card__link" %>
        <% else %>
          <span class="profile-review-card__link--empty">関連情報なし</span>
        <% end %>
      </div>
      <div class="profile-review-card__score">⭐ <%= review.total_score %></div>
    </div>
    <p class="profile-review-card__text"><%= review.text %></p>
    <small class="profile-review-card__date"><%= review.created_at.strftime('%Y年%m月%d日') %></small>
  </div>
<% end %>
    <% else %>
      <div class="profile-empty">
        <p class="profile-empty__text">まだレビューがありません</p>
      </div>
    <% end %>
  </main>

  <%= render 'pages/footer' %>
</body>
</html>