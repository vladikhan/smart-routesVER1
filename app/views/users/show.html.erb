<!DOCTYPE html>
<html>
<head>
  <title>@<%= @user.username %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'profile', media: 'all' %>
  
</head>
<body>
  <%= render 'pages/header' %>
  

  <!-- Profile Header -->
  <section class="profile-header">
  <div class="profile-header-content">
    <%= image_tag @user.avatar_url, class: "profile-avatar-large", alt: @user.username %>

    <div class="profile-info">
      <h1>@<%= @user.username %></h1>
      <p><%= @user.bio.presence || "まだ自己紹介がありません" %></p>

      <% if @user.location.present? %>
        <p class="header-location">📍 <%= @user.location %></p>
      <% end %>

      <div class="profile-stats">
        <div class="stat-box">
          <span class="stat-number"><%= @user.routes.count %></span>
          <span class="stat-label">ルート</span>
        </div>
        <div class="stat-box">
          <span class="stat-number"><%= @user.following_count %></span>
          <span class="stat-label">フォロー</span>
        </div>
        <div class="stat-box">
          <span class="stat-number"><%= @user.followers_count %></span>
          <span class="stat-label">フォロワー</span>
        </div>
      </div>

      <div class="profile-actions mt-3">
        <% if current_user == @user %>
          <%= link_to edit_user_path(@user), class: "btn-edit" do %>
            プロフィール編集
          <% end %>
        <% else %>
          <div class="d-flex gap-2">
            <% if current_user.following?(@user) %>
              <%= button_to 'フォロー解除', user_follower_path(@user), 
                            method: :delete, 
                            class: 'btn btn-outline-secondary btn-sm',
                            data: { confirm: 'フォローを解除しますか？' } %>
            <% else %>
              <%= button_to 'フォローする', user_follower_path(@user), 
                            method: :post, 
                            class: 'btn btn-primary btn-sm' %>
            <% end %>

            <%= button_to dm_rooms_path(receiver_id: @user.id), 
                          method: :post, 
                          class: "btn btn-outline-primary btn-sm" do %>
               メッセージ
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

  <!-- Tabs Navigation -->
  <section class="profile-tabs">
  <div class="tabs-container">
    <button class="tab-btn active" data-tab="routes">作成したルート</button>
    <button class="tab-btn" data-tab="saved">保存したルート</button>
    <button class="tab-btn" data-tab="reviews">レビュー</button>
    <button class="tab-btn" data-tab="activity">アクティビティ</button> </div>
</section>

<main class="profile-content">
  
  <div class="tab-content active" id="routes-tab">
     <%= render partial: 'routes/route_card', collection: @routes, as: :route %>
  </div>

  <div class="tab-content" id="saved-tab">
     <%= render partial: 'routes/route_card', collection: @saved_routes, as: :route %>
  </div>

  <div class="tab-content" id="reviews-tab">
     <% @reviews.each do |review| %>
       <%= render 'reviews/review', review: review %>
     <% end %>
  </div>

  <div class="tab-content" id="activity-tab">
     <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 25px;">アクティビティ</h2>
     <%= render 'notifications/activity_list', activities: @activities %>
  </div>

</main>

  <%= render 'pages/route_make' %>
  <%= render 'pages/footer' %>

 <script>
/**
 * Функция инициализации табов.
 * Мы выносим её отдельно, чтобы вызывать и при загрузке, и при смене страницы.
 */
function initProfileTabs() {
  console.log("Checking for tabs..."); // Появится в консоли F12
  const tabs = document.querySelectorAll('.tab-btn');
  const contents = document.querySelectorAll('.tab-content');

  if (tabs.length === 0) return;

  tabs.forEach(tab => {
    // Убираем старые слушатели, чтобы не было дублей
    tab.replaceWith(tab.cloneNode(true));
  });

  // Заново находим кнопки после клонирования
  const freshTabs = document.querySelectorAll('.tab-btn');

  freshTabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const target = this.getAttribute('data-tab');
      console.log("Tab clicked: " + target);

      // 1. Снимаем активный класс со всех кнопок
      freshTabs.forEach(t => t.classList.remove('active'));
      // 2. Скрываем весь контент через стили (надёжнее чем классы)
      contents.forEach(c => {
        c.classList.remove('active');
        c.style.display = 'none';
      });

      // 3. Активируем нужную кнопку
      this.classList.add('active');
      // 4. Показываем нужный блок
      const activeBox = document.getElementById(target + '-tab');
      if (activeBox) {
        activeBox.classList.add('active');
        activeBox.style.display = 'block';
      }
    });
  });
}

// Слушаем событие Turbo (обязательно для Rails 7)
document.addEventListener('turbo:load', initProfileTabs);

// На всякий случай для обычных переходов
document.addEventListener('DOMContentLoaded', initProfileTabs);
</script>


</body>
</html>
