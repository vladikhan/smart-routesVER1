<!DOCTYPE html>
<html>
<head>
  <title>@<%= @user.username %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'profile', media: 'all' %>
  
</head>
<body>
  <%= render 'pages/header' %>

  <!-- Profile Header -->
  <section class="profile-header">
    <div class="profile-header-content">
      <%= image_tag @user.avatar_url, class: "profile-avatar-large", alt: @user.username %>
      
      <div class="profile-info">
        <h1>@<%= @user.username %></h1>
        <p style="opacity: 0.9; margin-bottom: 15px;">
          <%= @user.bio || "まだ自己紹介がありません" %>
        </p>
        
        <% if @user.location.present? %>
          <p style="opacity: 0.9;">📍 <%= @user.location %></p>
        <% end %>
        
        <div class="profile-stats">
          <div class="stat-box">
            <div class="stat-number"><%= @user.routes.count %></div>
            <div class="stat-label">ルート</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">12</div>
            <div class="stat-label">フォロー</div>
          </div>
          <div class="stat-box">
            <div class="stat-number">95</div>
            <div class="stat-label">フォロワー</div>
          </div>
        </div>
        
        <div class="profile-actions">
          <% if current_user == @user %>
            <%= link_to "✏️ プロフィール編集", edit_user_path(@user), class: "btn-edit" %>
          <% else %>
            <button class="btn-follow">フォロー</button>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Tabs -->
  <section class="profile-tabs">
    <div class="tabs-container">
      <button class="tab-btn active">作成したルート</button>
      <button class="tab-btn">保存したルート</button>
      <button class="tab-btn">レビュー</button>
      <button class="tab-btn">アクティビティ</button>
    </div>
  </section>

  <!-- Content -->
  <main class="profile-content">
    <h2 style="margin-bottom: 25px; font-size: 24px;">作成したルート (<%= @routes.count %>)</h2>
    
    <% if @routes.any? %>
      <div class="venues-grid">
        <% @routes.each do |route| %>
          <%= link_to route_path(route), style: "text-decoration: none;" do %>
            <div class="venue-card">
              <div class="venue-image" style="background: linear-gradient(135deg, #64b5f7, #0288d1); display: flex; align-items: center; justify-content: center; font-size: 48px; color: white;">
                🗺️
              </div>
              <div class="venue-content">
                <h3 class="venue-name"><%= route.name %></h3>
                <p class="venue-description"><%= truncate(route.description, length: 80) %></p>
                <div class="venue-meta">
                  <div class="venue-rating">👁️ <%= route.view_count || 0 %></div>
                  <div class="venue-price">💰 ¥<%= number_with_delimiter(route.estimated_cost) %></div>
                </div>
                <div class="venue-tags">
                  <span class="venue-tag">⏱️ <%= route.estimated_duration %>分</span>
                  <span class="venue-tag">📍 <%= route.route_items.count %>箇所</span>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div style="text-align: center; padding: 60px 20px; color: #999;">
        <p style="font-size: 48px; margin-bottom: 20px;">📭</p>
        <p>まだルートを作成していません</p>
      </div>
    <% end %>
    
    <!-- Reviews Section -->
    <h2 style="margin: 60px 0 25px; font-size: 24px;">レビュー (<%= @reviews.count %>)</h2>
    
    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <div class="content-card" style="margin-bottom: 20px;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
            <div>
              <%= link_to review.venue.name, venue_path(review.venue), style: "font-weight: 600; color: #333; text-decoration: none;" %>
            </div>
            <div style="color: #f59e0b;">⭐ <%= review.total_score %></div>
          </div>
          <p style="color: #666; line-height: 1.6;"><%= review.text %></p>
          <small style="color: #999;"><%= review.created_at.strftime('%Y年%m月%d日') %></small>
        </div>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 40px 20px; color: #999;">
        <p>まだレビューがありません</p>
      </div>
    <% end %>
  </main>

  <%= render 'pages/footer' %>
</body>
</html>
