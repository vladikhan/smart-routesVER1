<!DOCTYPE html>
<html>
<head>
  <title>@<%= @user.username %> - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'profile', media: 'all' %>
  
</head>
<body>
  <%= render 'pages/header' %>
  



  

  <%# --- СЕКЦИЯ ХЕДЕРА С ФОЛЛОУИНГОМ --- %>
  <section class="profile-header" 
           data-controller="follow" 
           data-follow-user-id-value="<%= @user.id %>">
    <div class="profile-header-content">
      <%= image_tag @user.avatar_url, class: "profile-avatar-large", alt: @user.username %>

      <div class="profile-info">
        <h1>@<%= @user.username %></h1>
        <p><%= @user.bio.presence || "まだ自己紹介がありません" %></p>

        <div class="profile-stats">
          <div class="stat-box">
            <span class="stat-number"><%= @user.routes.count %></span>
            <span class="stat-label">ルート</span>
          </div>
          <div class="stat-box">
            <span class="stat-number"><%= @user.following.count %></span>
            <span class="stat-label">フォロー</span>
          </div>
          <div class="stat-box">
            <%# Добавили target для мгновенного обновления цифры %>
            <span class="stat-number" data-follow-target="count"><%= @user.followers.count %></span>
            <span data-follow-target="count"><%= @user.followers.count %></span> フォロワー
          </div>
        </div>

        <div class="profile-actions mt-3">
  <% if current_user == @user %>
    <%= link_to edit_user_path(@user), class: "btn-edit" do %>プロフィール編集<% end %>
  <% else %>
    <div class="d-flex align-items-center gap-2" id="follow-section-<%= @user.id %>">
      <%= render "users/follow_button", user: @user %>

      <%= button_to dm_rooms_path(receiver_id: @user.id), 
                    method: :post, 
                    form: { class: "d-inline-block" },
                    class: "btn btn-outline-primary btn-sm px-3" do %>
        メッセージ
      <% end %>
    </div>
  <% end %>
</div>
      </div>
    </div>
  </section>

  <%# --- СЕКЦИЯ ТАБОВ --- %>
  <div data-controller="profile-tabs">
    <section class="profile-tabs">
      <div class="tabs-container">
        <button class="tab-btn active" data-profile-tabs-target="btn" data-action="click->profile-tabs#switch" data-tab="routes">作成したルート</button>
        <button class="tab-btn" data-profile-tabs-target="btn" data-action="click->profile-tabs#switch" data-tab="saved">保存した</button>
        <button class="tab-btn" data-profile-tabs-target="btn" data-action="click->profile-tabs#switch" data-tab="reviews">レビュー</button>
        <button class="tab-btn" data-profile-tabs-target="btn" data-action="click->profile-tabs#switch" data-tab="activity">アクティビティ</button>
      </div>
    </section>

    <main class="profile-content">
      <div class="tab-content active" id="routes-tab" data-profile-tabs-target="content">
         <%= render partial: 'routes/route_card', collection: @routes, as: :route %>
      </div>
<div class="tab-content" id="saved-tab" data-profile-tabs-target="content" style="display: none;">
  <div class="bookmarks-container">
    <%# Получаем все закладки пользователя (и маршруты, и заведения) %>
    <% all_saved_items = @user.bookmarks.includes(:item).order(created_at: :desc) %>

    <% if all_saved_items.any? %>
      <div class="row row-cols-1 row-cols-md-2 g-3">
        <% all_saved_items.each do |bookmark| %>
          <div class="col">
            <% if bookmark.item.is_a?(Route) %>
              <%= render 'routes/route_card', route: bookmark.item %>
            <% elsif bookmark.item.is_a?(Venue) %>
              <%= render 'venues/venue_card', venue: bookmark.item %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-muted py-5">保存したアイテムはまだありません</p>
    <% end %>
  </div>
</div>
         <%= render partial: 'routes/route_card', collection: @saved_routes, as: :route %>
      </div>
      <div class="tab-content" id="reviews-tab" data-profile-tabs-target="content" style="display: none;">
         <%= render partial: 'reviews/review', collection: @reviews, as: :review %>
      </div>
      <div class="tab-content" id="activity-tab" data-profile-tabs-target="content" style="display: none;">
         <%= render 'notifications/activity_list', activities: @activities %>
      </div>
    </main>
  </div>

  <%= render 'pages/route_make' %>
  <%= render 'pages/footer' %>
</body>

  

 <script>
/**
 * Функция инициализации табов.
 * Мы выносим её отдельно, чтобы вызывать и при загрузке, и при смене страницы.
 */
function initProfileTabs() {
  console.log("Checking for tabs..."); // Появится в консоли F12
  const tabs = document.querySelectorAll('.tab-btn');
  const contents = document.querySelectorAll('.tab-content');

  if (tabs.length === 0) return;

  

  // Заново находим кнопки после клонирования
  const freshTabs = document.querySelectorAll('.tab-btn');

  freshTabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const target = this.getAttribute('data-tab');
      console.log("Tab clicked: " + target);

      // 1. Снимаем активный класс со всех кнопок
      freshTabs.forEach(t => t.classList.remove('active'));
      // 2. Скрываем весь контент через стили (надёжнее чем классы)
      contents.forEach(c => {
        c.classList.remove('active');
        c.style.display = 'none';
      });

      // 3. Активируем нужную кнопку
      this.classList.add('active');
      // 4. Показываем нужный блок
      const activeBox = document.getElementById(target + '-tab');
      if (activeBox) {
        activeBox.classList.add('active');
        activeBox.style.display = 'block';
      }
    });
  });
}

// Слушаем событие Turbo (обязательно для Rails 7)
document.addEventListener('turbo:load', initProfileTabs);

// На всякий случай для обычных переходов
document.addEventListener('DOMContentLoaded', initProfileTabs);
</script>


</body>
</html>
