// 1. Обновляем кнопку (используем нижнее подчеркивание как в HTML)
$("#follow_section_<%= @user.id %>").html("<%= j render 'users/follow_button', user: @user %>");

// 2. Обновляем счетчик фолловеров
// Убедись, что в файле show.html.erb у тебя есть элемент с data-follow-target='count'
$("[data-follow-target='count']").html("<%= @user.followers.count %>");

console.log("Подписка оформлена успешно");