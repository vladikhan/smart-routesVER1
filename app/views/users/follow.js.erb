// 1. Заменяем кнопку на "Отписаться"
$("#follow-section-<%= @user.id %>").html("<%= j render 'users/follow_button', user: @user %>");

// 2. Обновляем счетчик фолловеров (находим его по атрибуту, который у тебя уже есть!)
$("[data-follow-target='count']").html("<%= @user.followers.count %>");

console.log("Подписка оформлена успешно через AJAX");