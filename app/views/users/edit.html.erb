<% content_for :title, "プロフィール編集 - Smart Routes" %>
<%= render 'pages/header' %>

<% content_for :extra_styles do %>
  <%= stylesheet_link_tag 'profile', media: 'all' %>
<% end %>

<% if @user.errors.any? %>
  <div class="error-messages" style="color: red; margin-bottom: 15px;">
    <h2>入力内容 на проверку:</h2>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>




    <!-- =========== PROFILE HEADER =========== -->
    <section class="profile-header">
      <div class="profile-header-content">
        <%=
          image_tag @user.avatar_url,
                    class: 'profile-avatar-large',
                    id: 'header-avatar'
        %>

        <div class="profile-info">
          <h1>@<%= @user.username %></h1>
          <p><%= @user.bio.presence || 'まだ自己紹介がありません' %></p>

          <% if @user.location.present? %>
            <p>📍 <%= @user.location %></p>
          <% end %>

          <div class="profile-stats">
            <div class="stat-box">
              <span class="stat-number"><%= @user.routes.count %></span
              ><span class="stat-label">ルート</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">12</span
              ><span class="stat-label">フォロー</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">95</span
              ><span class="stat-label">フォロワー</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========== EDIT FORM =========== -->
    <div class="edit-container">
      <% if @form && @form.errors.any? %>
      <div class="error-messages" style="color: red; margin-bottom: 15px; border: 1px solid red; padding: 10px;">
        <h2>入力内容をご確認ください:</h2>
        <ul>
          <% @form.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


      <!-- Flash Notification -->
      <div id="upload-notification" class="notification hidden">
        
        <span id="notification-message"></span>
      </div>

      <%= form_for @user, url: user_path(@user), method: :patch, html: { multipart: true, id: "profile-form" } do |f| %>
        <!-- Avatar -->
        <div class="avatar-section">
          <h2 class="section-title">プロフィール写真</h2>

          <div class="avatar-placeholder" id="avatar-preview">
            <% if @user.avatar.present? %>
              <%= image_tag @user.avatar_url %>
            <% else %>
              📷
            <% end %>
          </div>

          <div class="upload-buttons">
            <label class="btn-upload">
              写真を選択
              <%=
                f.file_field :avatar,
                             accept: 'image/*',
                             id: 'avatar-input',
                             onchange: 'previewAvatar(event)'
              %>
            </label>

            <% if @user.avatar.present? %>
              <button
                type="button"
                id="delete-btn"
                class="btn-delete-photo"
                onclick="deleteAvatar()"
              >
                写真を削除
              </button>
              <%=
                f.hidden_field :remove_avatar,
                               id: 'remove-avatar-field',
                               value: '0'
              %>
            <% end %>
          </div>

          <p class="upload-hint">
            推奨: 正方形画像 / 最大5MB / JPG PNG GIF WEBP
          </p>
        </div>

        <!-- Basic Profile -->
        <div class="form-section">
          <h2 class="section-title">基本情報</h2>

          <div class="form-group">
            <%= f.label :username, 'ユーザー名' %>
            <%= f.text_field :username, class: 'form-input' %>
          </div>

          <div class="form-group">
            <%= f.label :birthday, '生年月日' %>
            <%=
              f.date_select :birthday,
                            start_year: 1950,
                            end_year: Time.current.year,
                            default: @user.birthday || 25.years.ago,
                            prompt: true
            %>
          </div>

          <div class="form-group">
            <b>性別</b><br />
            <%= f.radio_button :gender, 'female' %> 女性
            <%= f.radio_button :gender, 'male' %>
            男性 <%= f.radio_button :gender, 'other' %> その他
          </div>

          <div class="form-group">
            <%= f.label :location, '居住地' %>
            <%=
              f.text_field :location,
                           class: 'form-input',
                           placeholder: '東京・大阪など'
            %>
          </div>
        </div>

        <!-- BIO -->
        <div class="form-section">
          <h2 class="section-title">プロフィール情報</h2>
          <%=
            f.text_area :bio,
                        class: 'form-textarea',
                        maxlength: 500,
                        id: 'bio-textarea',
                        placeholder: '自己紹介を入力...'
          %>
          <div class="char-count"><span id="char-count">0</span>/500文字</div>
        </div>

        <!-- Buttons -->
        <div class="action-buttons">
          <%= link_to 'キャンセル', user_path(@user), class: 'btn btn-cancel' %>
          <%= f.submit '保存', id: 'save-btn', class: 'btn btn-save-profile' %>
        </div>
      <% end %>
    </div>

    <%= render 'pages/footer' %>

    <!-- ================= JS FIXED ================= -->
    <script>
      function previewAvatar(event) {
        const file = event.target.files[0];
        if (!file) return;

        const preview = document.getElementById("avatar-preview");
        const header = document.getElementById("header-avatar");

        const reader = new FileReader();
        reader.onload = (e) => {
          preview.innerHTML = `<img src="${e.target.result}">`;
          header.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      function deleteAvatar() {
        document.getElementById("remove-avatar-field").value = "1";
        document.getElementById("avatar-preview").innerHTML = "📷";
        document.getElementById("header-avatar").src =
          "/images/default_avatar.png";
      }

      function updateCount() {
        document.getElementById(
          "char-count"
        ).textContent = document.getElementById("bio-textarea").value.length;
      }
      document
        .getElementById("bio-textarea")
        .addEventListener("input", updateCount);
      updateCount();
    </script>

