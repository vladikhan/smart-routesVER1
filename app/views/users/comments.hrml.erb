<% render 'pages/header' %>
<%= render 'pages/header' %>

<div class="container mt-4" style="max-width: 900px;">
  <div class="card mb-4 shadow-sm border-0">
    <div class="card-body text-center pt-5">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: 'rounded-circle mb-3 shadow-sm', size: '100x100', style: "object-fit: cover;" %>
      <% else %>
        <%= image_tag "https://ui-avatars.com/api/?name=#{@user.username}&size=100&background=random", 
                       class: 'rounded-circle mb-3 shadow-sm', size: '100x100' %>
      <% end %>
      
      <h3 class="fw-bold">@<%= @user.username %></h3>
      <p class="text-muted"><%= @user.bio %></p>
      
      <div class="d-flex justify-content-center gap-4 mb-3">
        <div><strong><%= @followers_count %></strong> <span class="text-muted small">フォロワー</span></div>
        <div><strong><%= @following_count %></strong> <span class="text-muted small">フォロー中</span></div>
      </div>
      
      <ul class="nav nav-tabs justify-content-center mt-4 border-0">
        <li class="nav-item">
          <%= link_to user_path(@user), class: "nav-link border-0 #{'active fw-bold border-bottom border-primary' if current_page?(user_path(@user))}" do %>
            <i class="bi bi-grid-3x3"></i> 投稿
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to comments_user_path(@user), class: "nav-link border-0 #{'active fw-bold border-bottom border-primary' if current_page?(comments_user_path(@user))}" do %>
            <i class="bi bi-chat-dots"></i> コメント
          <% end %>
        </li>
      </ul>
    </div>
  </div>
  
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold">
        <i class="bi bi-chat-left-text text-primary me-2"></i>
        投稿したコメント一覧 (<%= @comments.total_count %>)
      </h5>
    </div>
    
    <div class="card-body">
      <% if @comments.any? %>
        <% @comments.each do |comment| %>
          <%# Защита от ошибок, если объект комментария был удален %>
          <% next if comment.commentable.nil? %>
          
          <div class="comment-item border-bottom pb-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                <%= time_ago_in_words(comment.created_at) %>前
              </small>
              
              <%= link_to polymorphic_path(comment.commentable), class: 'btn btn-sm btn-light border text-primary' do %>
                <i class="bi bi-box-arrow-up-right me-1"></i>元の投稿
              <% end %>
            </div>
            
            <div class="mb-3">
              <span class="small text-muted me-1">コメント先:</span>
              <% case comment.commentable_type %>
              <% when 'Route' %>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                  <i class="bi bi-map me-1"></i>ルート: <%= link_to comment.commentable.name, route_path(comment.commentable), class: 'text-decoration-none' %>
                </span>
              <% when 'Venue' %>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                  <i class="bi bi-geo-alt me-1"></i>場所: <%= link_to comment.commentable.name, venue_path(comment.commentable), class: 'text-decoration-none' %>
                </span>
              <% when 'Post' %>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  <i class="bi bi-image me-1"></i>投稿: <%= link_to truncate(comment.commentable.content, length: 20), post_path(comment.commentable), class: 'text-decoration-none' %>
                </span>
              <% end %>
            </div>
            
            <div class="comment-content bg-light p-3 rounded-3 border-start border-primary border-4 shadow-sm">
              <%= simple_format(comment.content, class: "mb-0") %>
            </div>
          </div>
        <% end %>
        
        <div class="d-flex justify-content-center mt-4">
          <%= paginate @comments %>
        </div>
        
      <% else %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-chat-right-quote" style="font-size: 4rem; opacity: 0.2;"></i>
          <p class="mt-3">まだコメントがありません</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'pages/footer' %>