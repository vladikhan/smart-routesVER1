
<!DOCTYPE html>
<html>
<head>
  <title>新規登録 - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_pack_tag 'login', media: 'all' %>
</head>
<body>
  <header class="login-header">
    <%= link_to root_path, class: "login-logo" do %>
      <span class="login-logo-icon">🗺️</span>
      <span>Smart<strong>Routes</strong></span>
    <% end %>
    <%= link_to "ログイン", new_user_session_path, class: "login-link" %>
  </header>

  <div class="login-container">
    <div class="login-box">
      <h2 style="text-align: center; margin-bottom: 30px; color: #333;">新規登録</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :username, "ユーザー名", class: "form-label" %>
          <%= f.text_field :username, 
              autofocus: true,
              class: "form-input",
              placeholder: "yamada_taro" %>
        </div>

        <div class="form-group">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, 
              autocomplete: "email",
              class: "form-input",
              placeholder: "example@email.com" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <% if @minimum_password_length %>
            <span style="color: #999; font-size: 12px;">(最低 <%= @minimum_password_length %> 文字)</span>
          <% end %>
          <%= f.password_field :password, 
              autocomplete: "new-password",
              class: "form-input",
              placeholder: "••••••••" %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
          <%= f.password_field :password_confirmation, 
              autocomplete: "new-password",
              class: "form-input",
              placeholder: "••••••••" %>
        </div>

        <%= f.submit "登録", class: "btn-primary" %>
      <% end %>

      <%= link_to "すでにアカウントをお持ちの方", new_session_path(resource_name), class: "text-link" %>
    </div>
  </div>
</body>
</html>
