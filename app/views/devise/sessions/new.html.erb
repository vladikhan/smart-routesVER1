<!DOCTYPE html>
<html>
<head>
  <title>ログイン - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "login", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="header">
    <div class="container">
      <a href="/" class="logo">SmartRoutes</a>

      <ul class="nav-links">
        <li><%=link_to "ルート一覧", routes_path %></li>
        <li><%= link_to "場所を探す", venues_path %></li>
      </ul>

      <div class="auth-links">
      <% if user_signed_in? %>
        <%= form_with url: destroy_user_session_path, method: :delete, class: "inline-logout-form" do %>
      <%= button_tag "ログアウト", type: "submit", class: "login-btn" %>
    <% end %>
  <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "login-btn" %>
  <% end %>
  <style>
.inline-logout-form {
  display: inline;
}
.login-btn {
  border: none;
  background: transparent;
  padding: 0;
  cursor: pointer;
  
}
</style>
      </div>
    </div>
  </header>

  <div class="login-container">
    <div class="login-box">
      <% if alert %>
        <div class="alert">
          <%= alert %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-group">
          <%= f.label :email, "メールアドレス", class: "form-label" %>
          <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              class: "form-input",
              placeholder: "example@email.com" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <%= f.password_field :password, 
              autocomplete: "current-password",
              class: "form-input",
              placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "ログイン状態を保持" %>
          </div>
        <% end %>

        <%= f.submit "ログイン", class: "btn-primary" %>
      <% end %>

      <%= link_to "パスワードを忘れた場合", new_password_path(resource_name), class: "text-link" %>

      <a href="<%= new_registration_path(resource_name) %>" class="btn-secondary">新しいアカウント作成</a>
    </div>
  </div>
</body>
</html>
