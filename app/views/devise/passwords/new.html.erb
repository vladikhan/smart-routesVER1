    <header class="header">
      <div class="container">
        <a href="/" class="logo">SmartRoutes</a>

        <ul class="nav-links">
          <li>
        <%= link_to routes_path, class: "nav-icon-link vertical-layout" do %>
          <%= image_tag 'route-icon.svg', class: 'nav-icon' %>
          <span class="nav-text">ルート一覧</span>
        <% end %>
      </li>
      <li>
        <%= link_to venues_path, class: "nav-icon-link vertical-layout" do %>
        <%= image_tag 'venue-icon.svg', class: 'nav-icon' %>
        <span class="nav-text">場所を探す</span>
        <% end %>
      </li>
        </ul>

        <div class="auth-links">
          <% if user_signed_in? %>
            <%= form_with url: destroy_user_session_path, method: :delete, class: "inline-logout-form" do %>
              <%= button_tag 'ログアウト', type: 'submit', class: 'login-btn' %>
            <% end %>
          <% else %>
            <%= link_to 'ログイン', new_user_session_path, class: 'login-btn' %>
          <% end %>
        </div>
      </div>
    </header>
    <div class="login-container">
      <div class="login-box">
        <h2 class="form-title">パスワードをお忘れですか？</h2>
        <p class="form-subtitle">
          パスワード再設定の手順をメールでお送りします。
        </p>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= render 'devise/shared/error_messages', resource: resource %>

          <div class="form-group">
            <%= f.label :email, class: 'form-label' %>
            <%=
              f.email_field :email,
                            autofocus: true,
                            autocomplete: 'email',
                            class: 'form-input',
                            placeholder: 'example@email.com'
            %>
          </div>

          <%=
            f.submit 'パスワード再設定の手順を送ってください',
                     class: 'btn-primary'
          %>
        <% end %>

        <div class="auth-links">
          <%=
            link_to 'ログイン',
                    new_session_path(resource_name),
                    class: 'auth-link'
          %>
          <span class="auth-separator">|</span>
          <%=
            link_to '登録',
                    new_registration_path(resource_name),
                    class: 'auth-link'
          %>
          <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
            <span class="auth-separator">|</span>
            <%=
              link_to '確認手順が届きませんでしたか？',
                      new_confirmation_path(resource_name),
                      class: 'auth-link'
            %>
          <% end %>
        </div>
      </div>
    </div>
