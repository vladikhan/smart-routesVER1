<!DOCTYPE html>
<html>
<head>
  <title>確認メールを再送信 - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "login", "data-turbo-track": "reload" %>
</head>
<body>
  <header class="header">
    <div class="container">
      <a href="/" class="logo">SmartRoutes</a>

      <ul class="nav-links">
        <li><%=link_to "ルート一覧", routes_path %></li>
        <li><%= link_to "場所を探す", venues_path %></li>
      </ul>

      <div class="auth-links">
      <% if user_signed_in? %>
        <%= form_with url: destroy_user_session_path, method: :delete, class: "inline-logout-form" do %>
      <%= button_tag "ログアウト", type: "submit", class: "login-btn" %>
    <% end %>
  <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "login-btn" %>
  <% end %>
  
      </div>
    </div>
  </header>
  <div class="login-container">
    <div class="login-box">
      <h2 class="form-title">パスワードをお忘れですか？
</h2>
      <p class="form-subtitle">パスワード再設定の手順をメールでお送りします。</p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, 
              autofocus: true, 
              autocomplete: "email",
              class: "form-input",
              placeholder: "example@email.com" %>
        </div>

        <%= f.submit "パスワード再設定の手順を送ってください", class: "btn-primary" %>
      <% end %>

      <div class="auth-links">
        <%= link_to "ログイン", new_session_path(resource_name), class: "auth-link" %>
        <span class="auth-separator">|</span>
        <%= link_to "登録", new_registration_path(resource_name), class: "auth-link" %>
        <% if devise_mapping.confirmable? && controller_name != 'confirmations' %>
          <span class="auth-separator">|</span>
          <%= link_to "確認手順が届きませんでしたか？", new_confirmation_path(resource_name), class: "auth-link" %>
        <% end %>
      </div>
    </div>
  </div>