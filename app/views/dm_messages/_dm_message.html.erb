<% is_own_message = dm_message.user_id == current_user.id %>

<div class="mb-3 d-flex <%= is_own_message ? 'justify-content-end' : 'justify-content-start' %> message-bubble"
     data-message-id="<%= dm_message.id %>">
  
  <div style="max-width: 70%;">
    <!-- Аватар и имя для чужих сообщений -->
    <% unless is_own_message %>
      <div class="d-flex align-items-center mb-2">
        <% if dm_message.user.avatar.attached? %>
          <%= image_tag dm_message.user.avatar, 
                       class: 'rounded-circle me-2', 
                       size: '24x24',
                       style: 'object-fit: cover;' %>
        <% else %>
          <%= image_tag "https://ui-avatars.com/api/?name=#{dm_message.user.username}&size=24&background=random", 
                       class: 'rounded-circle me-2' %>
        <% end %>
        <small class="text-muted fw-bold">@<%= dm_message.user.username %></small>
      </div>
    <% end %>
    
    <!-- Баббл сообщения -->
    <div class="<%= is_own_message ? 'message-sent' : 'message-received' %> shadow-sm">
      <!-- Изображение (если есть) -->
      <% if dm_message.image.attached? %>
        <%= image_tag dm_message.image, 
                     class: 'img-fluid rounded mb-2', 
                     style: 'max-width: 100%; max-height: 300px; cursor: pointer;',
                     onclick: 'window.open(this.src, "_blank")' %>
      <% end %>
      
      <!-- Текст сообщения -->
      <% if dm_message.message.present? %>
        <p class="mb-0" style="white-space: pre-wrap; word-break: break-word;">
          <%= dm_message.message %>
        </p>
      <% end %>
      
      <!-- Время и статус -->
      <div class="d-flex justify-content-between align-items-center mt-2" style="font-size: 11px;">
        <small class="<%= is_own_message ? 'text-white-50' : 'text-muted' %>">
          <%= dm_message.created_at.strftime('%H:%M') %>
        </small>
        
        <% if is_own_message %>
          <small class="<%= is_own_message ? 'text-white-50' : 'text-muted' %>">
            <%= dm_message.is_read ? '既読' : '送信済み' %>
          </small>
        <% end %>
      </div>
    </div>
  </div>
</div>