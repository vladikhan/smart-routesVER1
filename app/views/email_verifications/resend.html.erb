<!-- app/views/email_verification/resend.html.erb -->
<!DOCTYPE html>
<html>
<head>
  <title>メール確認 - Smart Routes</title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
</head>
<body>
  <%= render 'pages/header' %>
  
  <div style="max-width: 600px; margin: 100px auto; padding: 40px; background: white; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1);">
    <div style="text-align: center; margin-bottom: 30px;">
      <div style="font-size: 64px; margin-bottom: 20px;">📧</div>
      <h1 style="font-size: 28px; margin-bottom: 10px;">メール確認</h1>
      <p style="color: #666;">確認メールを再送信します</p>
    </div>
    
    <div style="background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
      <p style="margin: 0; color: #333;">
        <strong><%= current_user.email %></strong> 宛に確認メールを送信します。
      </p>
    </div>
    
    <%= form_with url: email_verification_resend_path, method: :post, local: true do |f| %>
      <button type="submit" style="width: 100%; padding: 15px; background: #0288d1; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;">
        確認メールを再送信
      </button>
    <% end %>
    
    <div style="margin-top: 20px; text-align: center;">
      <%= link_to "戻る", root_path, style: "color: #0288d1; text-decoration: none;" %>
    </div>
  </div>
</body>
</html>