<div style="max-width: 500px; margin: 50px auto; padding: 20px;">
  <h1>メール確認</h1>
  
  <%= form_with url: email_verification_path, method: :post do |f| %>
    <div class="form-group">
      <%= f.label :verification_code, "確認コード" %>
      <%= f.text_field :verification_code, class: "form-control" %>
    </div>
    
    <%= f.submit "確認する", class: "btn btn-primary" %>
  <% end %>
  
  <%= link_to "確認コードを再送信", email_verification_resend_path, method: :post %>
</div>
