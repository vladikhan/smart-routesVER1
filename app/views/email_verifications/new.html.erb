<%# Переносим стили в блок, который потом можно вынести в assets %>
<style>
  .verification-container {
    max-width: 500px;
    margin: 80px auto;
    padding: 40px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
  }

  .verification-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .verification-icon {
    font-size: 48px;
    margin-bottom: 16px;
    display: block;
  }

  .verification-title {
    font-size: 24px;
    font-weight: 700;
    color: #64748b;
    margin: 0 0 8px 0;
  }

  .verification-subtitle {
    color: #64748B;
    font-size: 15px;
  }

  .email-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 16px;
    border-radius: 10px;
    margin-bottom: 24px;
    text-align: center;
    color: #0288d1;
  }

  .email-address {
    display: block;
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 4px;
  }

  .email-label {
    font-size: 13px;
    color: #94a3b8;
  }

  .submit-btn {
    width: 100%;
    padding: 14px;
    background: #0288d1;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(2, 136, 209, 0.2);
  }

  .submit-btn:hover {
    background: #0277bd;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(2, 136, 209, 0.3);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .back-link {
    display: block;
    margin-top: 24px;
    text-align: center;
    color: #64748b;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #0288d1;
    text-decoration: underline;
  }
</style>

<%= render 'pages/header' %>

<div class="verification-container">
  <div class="verification-header">
    <span class="verification-icon">📧</span>
    <h1 class="verification-title">メール確認</h1>
    <p class="verification-subtitle">送信された6桁の確認コードを入力してください</p>
  </div>

  <div class="email-box">
    <span class="email-address"><%= @user.email %></span>
    <span class="email-label">こちらのアドレスにコードを送信しました</span>
  </div>

  <%= form_with url: verify_email_verification_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :confirmation_token, params[:confirmation_token] %>
    
    <div style="margin-bottom: 24px;">
      <%= text_field_tag :verification_code, nil, 
            placeholder: "000000", 
            class: "email-box", 
            style: "width: 100%; color: #0288d1;
                    font-size: 32px; letter-spacing: 8px; text-align: center; border: 2px solid #0288d1; background: #fff;",
            required: true,
            maxlength: 6 %>
    </div>
    
    <%= f.submit "認証する", class: "submit-btn" %>
  <% end %>

  <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 32px 0;">

  <%# 4. ВТОРОСТЕПЕННЫЕ ДЕЙСТВИЯ (RESEND) %>
  <div class="resend-section">
    <p style="font-size: 13px; color: #64748b; text-align: center; margin-bottom: 12px;">
      コードが届かない場合は？
    </p>
    <%= button_to '確認コードを再送信', 
                  resend_email_verification_path(confirmation_token: params[:confirmation_token]), 
                  method: :post, 
                  class: 'back-link',
                  style: 'width: 100%; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px; background: #f8fafc;' %>
  </div>

  <%= link_to 'ログインに戻る', new_user_session_path, class: 'back-link' %>
</div>