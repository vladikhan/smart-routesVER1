
<!DOCTYPE html>
<html>
<head>
  <title>Smart Routes - 京都・大阪の旅行プランニング</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'pages', media: 'all' %>
</head>
<body>
  <%= render 'pages/header' %>
  <%= render 'pages/flash_messages' %>

  <!-- Hero Banner with Search -->
  <section class="hero-banner">
    <h1 class="hero-title">京都・大阪を旅しよう</h1>
    <p class="hero-subtitle">あなただけの完璧な旅行プランを作成</p>
    
    <%= form_with url: root_path, method: :get, class: "search-form" do |f| %>
      <div class="search-bar">
        <%= f.text_field :query, 
            placeholder: "都市名、観光地、レストランを検索...", 
            class: "search-input",
            value: @query %>
        <%= f.submit "🔍 検索", class: "search-button" %>
      </div>

      <!-- Advanced Filters -->
      <div class="search-filters">
        <select name="city" class="filter-select">
          <option value="">都市を選択</option>
          <option value="京都" <%= 'selected' if @city == '京都' %>>京都</option>
          <option value="大阪" <%= 'selected' if @city == '大阪' %>>大阪</option>
        </select>

        <select name="budget" class="filter-select">
          <option value="">予算</option>
          <option value="low" <%= 'selected' if @budget == 'low' %>>〜¥5,000</option>
          <option value="medium" <%= 'selected' if @budget == 'medium' %>>¥5,000〜¥15,000</option>
          <option value="high" <%= 'selected' if @budget == 'high' %>>¥15,000〜</option>
        </select>

        <%= f.text_field :tags, 
            placeholder: "タグ（カンマ区切り）", 
            class: "filter-input",
            value: @tags&.join(', ') %>
      </div>
    <% end %>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="stat-box">
      <div class="stat-number"><%= number_with_delimiter(@stats[:routes_count]) %></div>
      <div class="stat-label">ルート</div>
    </div>
    <div class="stat-box">
      <div class="stat-number"><%= number_with_delimiter(@stats[:venues_count]) %></div>
      <div class="stat-label">場所</div>
    </div>
    <div class="stat-box">
      <div class="stat-number"><%= number_with_delimiter(@stats[:users_count]) %></div>
      <div class="stat-label">ユーザー</div>
    </div>
    <div class="stat-box">
      <div class="stat-number"><%= number_with_delimiter(@stats[:reviews_count]) %></div>
      <div class="stat-label">レビュー</div>
    </div>
  </section>

  <!-- Routes Section -->
  <section class="content-section">
    <div class="section-header">
      <h2 class="section-title">
        <% if @search_active %>
          🔍 検索結果 (<%= @routes.count %>件)
        <% else %>
          🆕 新着ルート
        <% end %>
      </h2>
    </div>

    <% if @routes.any? %>
      <div class="venues-grid" id="routes-list">
        <%= render partial: 'routes_list', locals: { routes: @routes } %>
      </div>
    <% else %>
      <div class="empty-state">
        <p style="font-size: 48px; margin-bottom: 20px;">📭</p>
        <p style="font-size: 18px; color: #666;">
          <% if @search_active %>
            検索結果が見つかりませんでした
          <% else %>
            まだルートがありません
          <% end %>
        </p>
      </div>
    <% end %>
  </section>

  <%= render 'pages/footer' %>
</body>
</html>