<%= stylesheet_link_tag 'notifications', media: 'all' %>
<%= stylesheet_link_tag 'application', media: 'all' %>

<%= render 'pages/header' %>

<div class="notifications-page">
  <div class="page-header-section">
    <h1 class="page-title">
      <span>🔔</span>
      通知
      <% if @unread_count > 0 %>
        <span class="unread-badge-header"><%= @unread_count %></span>
      <% end %>
    </h1>
    
    <% if @notifications.where(is_read: false).any? %>
      <%# Исправлено: вызываем JS функцию напрямую через onclick %>
      <button type="button" class="mark-all-read" onclick="markAllNotificationsAsRead()">
        すべて既読にする
      </button>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <% @notifications.group_by { |n| n.created_at.to_date }.each do |date, notifications_of_day| %>
      <div class="date-divider">
        <span class="date-text">
          <% if date == Date.today %> 今日
          <% elsif date == Date.yesterday %> 昨日
          <% elsif date > 7.days.ago.to_date %> <%= date.strftime('%m月%d日') %>
          <% else %> <%= date.strftime('%Y年%m月%d日') %>
          <% end %>
        </span>
      </div>

      <% notifications_of_day.each do |notification| %>
        
      
        <%= link_to mark_as_read_notification_path(notification), 
                    class: "notification-card #{notification.is_read ? 'read' : 'unread'}",
                    data: { notification_id: notification.id } do %>
          
          <div class="notification-icon-large">
            <%= notification.icon %>
          </div>
          
          <div class="notification-body">
            <% if notification.actor.present? %>
              <div class="notification-actor-avatar">
                <% if notification.actor.avatar.present? %>
                  <%= image_tag notification.actor.avatar.url, class: 'avatar-small' %>
                <% else %>
                  <div class="avatar-placeholder-small">
                    <%= notification.actor.username[0].upcase %>
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <div class="notification-text-content">
              <div class="notification-message"><%= notification.message %></div>
              <div class="notification-time"><%= time_ago_in_words(notification.created_at) %>前</div>
            </div>
          </div>
          
          <% unless notification.is_read %>
            <div class="notification-unread-dot"></div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="pagination-wrapper mt-4">
      <%= paginate @notifications %>
    </div>

  <% else %>
    <div class="empty-state">
      <div class="empty-icon">🔔</div>
      <h2><%= params[:filter].present? ? "該当する通知はありません" : "通知はありません" %></h2>
      <p>新しいアクションがあるとここに表示されます</p>
    </div>
  <% end %>
</div>

<%= render 'pages/footer' %>

<script>
  /**
   * Отметить одно уведомление как прочитанное и перейти по ссылке
   */
  async function markAsReadOnClick(notificationId, event) {
    if (event) event.preventDefault();

    try {
      const response = await fetch(`/notifications/${notificationId}/mark_as_read`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      });

      const data = await response.json();

      if (data.success) {
        // Мгновенно обновляем UI карточки
        const card = document.querySelector(`[data-notification-id="${notificationId}"]`);
        if (card) {
          card.classList.remove('unread');
          card.classList.add('read');
          // Удаляем точку уведомления, если она есть
          const dot = card.querySelector('.notification-unread-dot');
          if (dot) dot.remove();
        }

        // Переходим по адресу уведомления (на маршрут, лайк и т.д.)
        if (data.redirect_url) {
          setTimeout(() => {
            window.location.href = data.redirect_url;
          }, 200);
        }
      }
    } catch (error) {
      console.error('Error marking notification as read:', error);
    }
  }

  /**
   * Отметить ВСЕ уведомления как прочитанные
   */
  async function markAllNotificationsAsRead() {
    if (!confirm('すべての通知を既読にしますか？')) return;

    try {
      const response = await fetch('<%= mark_all_as_read_notifications_path %>', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      });

      const data = await response.json();

      if (data.success) {
        // Обновляем все карточки на странице
        document.querySelectorAll('.notification-card.unread').forEach(card => {
          card.classList.remove('unread');
          card.classList.add('read');
          const dot = card.querySelector('.notification-unread-dot');
          if (dot) dot.remove();
        });

        // Прячем кнопку "Прочитать все"
        const markAllBtn = document.querySelector('.mark-all-read');
        if (markAllBtn) markAllBtn.remove();

        // Вызываем глобальный тост (из application.html.erb)
        if (typeof showToast === 'function') {
          showToast('すべて既読にしました', 'success');
        }
      }
    } catch (error) {
      console.error('Error marking all as read:', error);
      if (typeof showToast === 'function') {
        showToast('エラーが発生しました', 'error');
      }
    }
  }
</script>


