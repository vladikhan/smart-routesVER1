<%= stylesheet_link_tag 'notifications', media: 'all' %>
<%= stylesheet_link_tag 'application', media: 'all' %>

<%= render 'pages/header' %>

<div class="notifications-page">
  <div class="page-header-section">
    <h1 class="page-title">
      <span>🔔</span>
      通知
      <% if @unread_count > 0 %>
        <span class="unread-badge-header"><%= @unread_count %></span>
      <% end %>
    </h1>

    <% if @notifications.where(is_read: false).any? %>
      <button
        type="button"
        class="mark-all-read"
        data-url="<%= mark_all_as_read_notifications_path %>"
        onclick="console.log('Клик сработал!'); alert('URL: ' + this.dataset.url); markAllNotificationsAsRead(this.dataset.url)"
      >
        すべて既読にする
      </button>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <% @notifications.group_by { |n| n.created_at.to_date }.each do |date, notifications_of_day| %>
      <div class="date-divider">
        <span class="date-text">
          <% if date == Date.today %>
            今日
          <% elsif date == Date.yesterday %>
            昨日
          <% elsif date > 7.days.ago.to_date %>
            <%= date.strftime('%m月%d日') %>
          <% else %>
            <%= date.strftime('%Y年%m月%d日') %>
          <% end %>
        </span>
      </div>

      <% notifications_of_day.each do |notification| %>
        <%= button_to mark_as_read_notification_path(notification), 
                    method: :patch,
                    class: "notification-card #{notification.is_read ? 'read' : 'unread'}",
                    style: "background: none; border: none; padding: 0; width: 100%; text-align: left;",
                    data: { notification_id: notification.id } do %>
          
          <div class="notification-item-layout" style="display: flex; align-items: center; padding: 10px;">
            <div class="notification-actor-avatar" style="margin-right: 12px;">
              <%= user_avatar(notification.actor, size: 32, css_class: "avatar-small") %>
            </div>

            <div class="notification-body">
              <div class="notification-text-content">
                <div class="notification-message">
                  <%= notification.message %>
                </div>
                <div class="notification-time" style="font-size: 0.8em; color: #666;">
                  <%= time_ago_in_words(notification.created_at) %>前
                </div>
              </div>
            </div>

            <% unless notification.is_read %>
              <div class="notification-unread-dot" style="margin-left: auto; width: 10px; height: 10px; background: #007bff; border-radius: 50%;"></div>
            <% end %>
          </div>
        <% end %> <%# Закрывает button_to %>
      <% end %> <%# Закрывает notifications_of_day.each %>
    <% end %> <%# Закрывает group_by.each %>

  <% else %>
    <div class="empty-state">
      <div class="empty-icon">🔔</div>
      <h2>
        <%=
          if params[:filter].present?
            '該当する通知はありません'
          else
            '通知はありません'
          end
        %>
      </h2>
      <p>新しいアクションがあるとここに表示されます</p>
    </div>
  <% end %>
</div>

<%= render 'pages/footer' %>

<script>
  /**
   * Отметить одно уведомление как прочитанное и перейти по ссылке
   */
  async function markAsReadOnClick(notificationId, event) {
    if (event) event.preventDefault();

    try {
      const response = await fetch(
        `/notifications/${notificationId}/mark_as_read`,
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
            Accept: "application/json",
          },
        }
      );

      const data = await response.json();

      if (data.success) {
        const card = document.querySelector(`[data-notification-id="${notificationId}"]`);
        if (card) {
          card.classList.remove("unread");
          card.classList.add("read");
          const dot = card.querySelector(".notification-unread-dot");
          if (dot) dot.remove();
        }

        if (data.redirect_url) {
          setTimeout(() => {
            window.location.href = data.redirect_url;
          }, 200);
        }
      }
    } catch (error) {
      console.error("Error marking notification as read:", error);
    }
  }

  /**
   * Отметить ВСЕ уведомления как прочитанные
   */
  window.markAllNotificationsAsRead = async function (url) { 
    if (!url) return; 
    if (!confirm("すべての通知を既読にしますка？")) return;

    try {
      const response = await fetch(url, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
          "Accept": "application/json",
        },
      });
      
      const data = await response.json();
      if (data.success) {
        window.location.reload(); // Перезагружаем, чтобы обновить все статусы
      }
    } catch (e) { 
      console.error(e); 
    }
  }
</script>