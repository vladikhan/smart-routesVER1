
<!DOCTYPE html>
<html>
<head>
  <title>通知 - Smart Routes</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= stylesheet_link_tag 'notifications', media: 'all' %>
  
  
</head>
<body>
  <%= render 'pages/header' %>

  <div class="notifications-page">
    <div class="page-header-section">
      <h1 class="page-title">
        <span>🔔</span>
        通知
      </h1>
      
      <% if @notifications.where(is_read: false).exists? %>
        <button onclick="markAllNotificationsAsRead()" class="mark-all-read">
          すべて既読にする
        </button>
      <% end %>
    </div>

    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <%= link_to notification.target_url, class: "notification-card #{'unread' unless notification.is_read?}",
            data: { notification_id: notification.id },
            onclick: "markAsReadOnClick(#{notification.id}, event)" do %>
          <div class="notification-icon-large"><%= notification.icon %></div>
          <div class="notification-body">
            <div class="notification-message">
              <%= notification.message %>
            </div>
            <div class="notification-time">
              <%= time_ago_in_words(notification.created_at) %>前
            </div>
          </div>
          <% unless notification.is_read? %>
            <div style="width: 12px; height: 12px; background: #0288d1; border-radius: 50%; flex-shrink: 0;"></div>
          <% end %>
        <% end %>
      <% end %>

      <div style="margin-top: 30px;">
        <%= paginate @notifications %>
      </div>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">🔔</div>
        <h2 style="color: #666; margin-bottom: 10px;">通知はありません</h2>
        <p style="color: #999;">新しい通知が届くとここに表示されます</p>
      </div>
    <% end %>
  </div>
  <%= render 'pages/footer'%>

  <script>
    async function markAsReadOnClick(notificationId, event) {
      if (event) event.preventDefault();
      
      try {
        const response = await fetch(`/notifications/${notificationId}/mark_as_read`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
            'Accept': 'application/json'
          }
        });

        const data = await response.json();
        
        if (data.success && data.redirect_url) {
          window.location.href = data.redirect_url;
        }
      } catch (error) {
        console.error('Error:', error);
      }
    }
  </script>
</body>
</html>
