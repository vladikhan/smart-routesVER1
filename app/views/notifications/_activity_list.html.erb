<%= stylesheet_link_tag "activities", "data-turbo-track": "reload" %>

<div class="activity-timeline-container">

  <% if activities.any? %>
    <div class="timeline-body">
      <%# Группировка по дате — это хорошо, оставляем %>
      <% activities.group_by { |a| a.created_at.to_date }.each do |date, daily_activities| %>
        
        <div class="timeline-date-header">
          <i class="far fa-calendar-alt"></i> <%= date_label(date) %>
        </div>

        <% daily_activities.each do |activity| %>
          <%# Определяем пользователя активности заранее %>
          <% activity_user = activity.respond_to?(:owner) ? activity.owner : (activity.respond_to?(:user) ? activity.user : nil) %>
          
          <div class="activity-card shadow-sm mb-3">
            <div class="activity-avatar">
              <% if activity_user %>
                <%= link_to user_path(activity_user) do %>
                  <%= user_avatar(activity_user, size: 45) %>
                <% end %>
              <% else %>
                <div class="default-icon">👤</div>
              <% end %>
            </div>

            <div class="activity-content">
              <div class="activity-header">
                <span class="activity-text">
                  <%= render_activity_text(activity) %>
                </span>
              </div>
              
              <div class="activity-meta">
                <small class="text-muted">
                  <i class="far fa-clock"></i> <%= time_ago_in_words(activity.created_at) %>前
                </small>
              </div>
              
              <%# Превью объекта (Маршрута, Отзыва и т.д.) %>
              <% if activity.trackable.present? %>
                <div class="activity-sub-card mt-2 p-2 border rounded bg-light">
                  <% if activity.trackable.respond_to?(:name) %>
                    <%= link_to activity.trackable.name, activity.trackable %>
                  <% elsif activity.trackable.respond_to?(:title) %>
                    <%= link_to activity.trackable.title, activity.trackable %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      <% end %>
    </div>
  <% else %>
    <div class="empty-state text-center py-5 shadow-sm rounded">
      <div class="empty-icon" style="font-size: 3rem;">📭</div>
      <p class="text-muted mt-2">アクティビティはまだありません</p>
    </div>
  <% end %>
</div>